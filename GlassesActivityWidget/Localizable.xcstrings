    "%lld%%" : {
      "comment" : "A progress bar showing the percentage of a download. The argument is the percentage of the download.",
      "isCommentAutoGenerated" : true
    },
    "A quick Listen toggle, and your glasses' connection and battery when you use them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر سريع لتبديل الاستماع، واتصال نظاراتك وبطاريتها عند استخدامها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un interruptor rápido de Escuchar, y la conexión y la batería de tus lentes cuando los usas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bouton d'écoute rapide, ainsi que la connexion et la batterie de vos lunettes lorsque vous les utilisez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyors Hallgatás kapcsoló, valamint a szemüveg kapcsolata és akkumulátora, ha használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un interruttore rapido per Ascolta, più la connessione e la batteria dei tuoi occhiali quando li usi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リスニングのクイック切り替えと、メガネを使用中はメガネの接続状況とバッテリー残量を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣기 빠른 전환 버튼과, 안경을 사용하는 동안 안경의 연결 상태와 배터리를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een snelle Luisteren-schakelaar, plus de verbinding en batterij van je bril als je die gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão rápido de Ouvir, além da conexão e da bateria dos seus óculos quando você os usa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрый переключатель «Слушать», а также подключение и заряд ваших очков, когда вы ими пользуетесь."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سننے کا فوری ٹوگل، اور عینک استعمال کرنے پر اس کا کنکشن اور بیٹری۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速切换聆听，并在你使用眼镜时显示眼镜的连接状态和电量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速切換聆聽，並在你使用眼鏡時顯示眼鏡的連接狀態和電量。"
          }
        }
      }
    },
