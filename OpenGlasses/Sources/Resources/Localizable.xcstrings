    "Field Assist is off, so there is no van list to import into." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assist متوقف، لذا لا توجد قائمة شاحنة للاستيراد إليها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assist está desactivado, así que no hay una lista de la camioneta donde importar."
