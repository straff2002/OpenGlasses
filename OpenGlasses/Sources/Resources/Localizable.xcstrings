    "Fix these in the spreadsheet and import it again, or change the lines here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصلح هذه في جدول البيانات واستورده مرة أخرى، أو غيّر الأسطر هنا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige esto en la hoja de cálculo e impórtala de nuevo, o cambia las líneas aquí."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigez-les dans le tableur et importez-le de nouveau, ou modifiez les lignes ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javítsa ezeket a táblázatban, és importálja újra, vagy módosítsa itt a sorokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correggili nel foglio di calcolo e importalo di nuovo, oppure modifica le righe qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スプレッドシートで修正してもう一度取り込むか、ここで行を変更してください。"
