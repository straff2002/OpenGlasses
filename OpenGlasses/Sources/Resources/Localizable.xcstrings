        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cambia nada hasta que toques Aplicar. Deshacer en la pantalla Inventario de la camioneta revierte toda la importación."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne change tant que vous n’appuyez pas sur Appliquer. Annuler, sur l’écran Inventaire de la camionnette, annule toute l’importation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semmi nem változik, amíg nem koppint az Alkalmaz gombra. A Furgonkészlet képernyőn a Visszavonás az egész importálást visszavonja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non cambia nulla finché non tocchi Applica. Annulla, nella schermata Scorte del furgone, annulla l’intera importazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「適用」をタップするまで何も変更されません。車載在庫画面の「取り消し」で、取り込み全体を元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'적용'을 탭하기 전에는 아무것도 변경되지 않습니다. 차량 재고 화면의 '실행 취소'로 가져오기 전체를 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verandert niets totdat u op Toepassen tikt. Met Ongedaan maken op het scherm Busvoorraad draait u de hele import terug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é alterado até você tocar em Aplicar. Desfazer na tela Estoque da van reverte toda a importação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не изменится, пока вы не нажмёте «Применить». Кнопка «Отменить» на экране «Запасы в фургоне» откатывает весь импорт."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب تک آپ لاگو کریں پر ٹیپ نہ کریں کچھ تبدیل نہیں ہوتا۔ وین اسٹاک اسکرین پر واپس کریں پوری امپورٹ واپس لے لیتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你点按“应用”之前不会有任何更改。在“车载库存”屏幕上点“撤销”可以完整撤回此次导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你點一下「套用」之前不會有任何變更。在「車載庫存」畫面上點「還原」可以完整復原此次匯入。"
          }
        }
      }
    },
    "Nothing is ever sent on its own. A report is built only when you ask for one, and you see every line of it before you share it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم إرسال أي شيء بمفرده أبدًا. يتم بناء التقرير فقط عندما تطلب واحدًا، وتسجل كل سطر منه قبل مشاركته."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se envía nada por sí solo. Un reporte se genera solo cuando lo pides, y ves cada línea antes de compartirlo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'est jamais envoyé seul. Un rapport est construit seulement lorsque vous en demandez un, et vous voyez chaque ligne avant de le partager."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soha semmit nem küldenek el magától. A jelentés csak akkor készül, ha Ön kér egyet, és a megosztása előtt minden sorát látja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente viene mai inviato da solo. Un report viene creato solo quando ne chiedi uno e ne vedi ogni riga prima di condividerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も単独で送信されることはありません。報告書は、あなたが要求したときのみ作成され、そのすべての行を共有する前に確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 자체로는 아무것도 전송되지 않습니다. 보고서는 요청하는 경우에만 작성되며, 공유하기 전에 보고서의 모든 줄을 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets wordt ooit uit zichzelf verzonden. Er wordt alleen een rapport gemaakt als u erom vraagt, en u ziet elke regel ervan voordat u het deelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é enviado sozinho. Um relatório é criado somente quando você o solicita e vê cada linha dele antes de compartilhá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не отправляется само по себе. Отчёт формируется только по вашему запросу, и вы видите каждую его строку, прежде чем поделиться им."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کبھی بھی کچھ خود بخود نہیں بھیجا جاتا۔ رپورٹ صرف تب بنتی ہے جب آپ مانگیں، اور اشتراک سے پہلے آپ اس کی ہر سطر دیکھتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从未单独发送任何内容。报告仅在您请求时生成，并且在您分享之前会查看报告的每一行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有任何東西會單獨傳送。報告僅在你要求時建立，而且在你分享之前可以看到其每一行。"
          }
        }
      }
    },
