    "NZ Health Connect integration requires a Health Information Platform (HIP) connector. Contact your PHO or DHB IT team." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب تكامل NZ Health Connect موصّل Health Information Platform (HIP). تواصل مع فريق تقنية المعلومات في PHO أو DHB."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con NZ Health Connect requiere un conector de Health Information Platform (HIP). Contacta al equipo de TI de tu PHO o DHB."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration à NZ Health Connect exige un connecteur Health Information Platform (HIP). Communiquez avec l’équipe des TI de votre PHO ou de votre DHB."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az NZ Health Connect integrációhoz Health Information Platform (HIP) összekötő szükséges. Forduljon a PHO vagy DHB IT-csapatához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'integrazione con NZ Health Connect richiede un connettore Health Information Platform (HIP). Contatta il team IT del tuo PHO o DHB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NZ Health Connectとの連携には、Health Information Platform（HIP）コネクタが必要です。PHOまたはDHBのITチームにお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NZ Health Connect 연동에는 Health Information Platform(HIP) 커넥터가 필요합니다. PHO 또는 DHB IT 팀에 문의하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integratie met NZ Health Connect vereist een Health Information Platform (HIP)-connector. Neem contact op met het IT-team van uw PHO of DHB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A integração com o NZ Health Connect exige um conector da Health Information Platform (HIP). Fale com a equipe de TI da sua PHO ou DHB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интеграция с NZ Health Connect требует коннектора Health Information Platform (HIP). Обратитесь в ИТ-команду вашей PHO или DHB."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NZ Health Connect انضمام کے لیے Health Information Platform (HIP) کنیکٹر درکار ہے۔ اپنی PHO یا DHB کی IT ٹیم سے رابطہ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NZ Health Connect 集成需要健康信息平台（HIP）连接器。请联系你的 PHO 或 DHB IT 团队。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NZ Health Connect 整合需要 Health Information Platform（HIP）連接器。請聯絡你的 PHO 或 DHB IT 團隊。"
          }
        }
      }
    },
