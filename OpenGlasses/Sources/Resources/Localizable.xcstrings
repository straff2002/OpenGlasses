        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法從裝置讀回其記錄。"
          }
        }
      }
    },
    "Its steps and check-ins go too. This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف معه خطواته ومتابعاته. لا يمكن التراجع عن هذا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se van sus pasos y seguimientos. Esto no se puede deshacer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
