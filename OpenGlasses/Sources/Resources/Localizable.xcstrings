        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스프레드시트에서 수정한 후 다시 가져오거나 여기서 항목을 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
