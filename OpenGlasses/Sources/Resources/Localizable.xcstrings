    "Couldn't load the models for your xAI account. Sign out and sign in again, or type a model ID below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تحميل النماذج لحساب xAI الخاص بك. سجّل الخروج ثم سجّل الدخول مرة أخرى، أو اكتب معرّف نموذج أدناه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar los modelos de tu cuenta de xAI. Cierra sesión y vuelve a iniciarla, o escribe abajo un ID de modelo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les modèles de votre compte xAI. Déconnectez-vous puis reconnectez-vous, ou saisissez un identifiant de modèle ci-dessous."
