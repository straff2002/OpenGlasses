    "%@ no longer offers the voice model in use, so replies use another voice. Choose another voice in Settings › Connections › Services & Integrations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد %@ يوفر نموذج الصوت المستخدم، لذا تستخدم الردود صوتًا آخر. غيّر الأصوات في الإعدادات › الاتصالات › الخدمات والتكاملات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no ofrece el modelo de voz en uso, así que las respuestas usan otra voz. Cambia de voz en Configuración › Conexiones › Servicios e integraciones."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’offre plus le modèle de voix utilisé, donc les réponses utilisent une autre voix. Changez de voix dans Réglages › Connexions › Services et intégrations."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ már nem kínálja a használt hangmodellt, ezért a válaszok másik hangot használnak. A hangokat itt módosíthatja: Beállítások › Kapcsolatok › Szolgáltatások és integrációk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non offre più il modello vocale in uso, quindi per le risposte viene utilizzata un’altra voce. Cambia le voci in Impostazioni › Connessioni › Servizi e integrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が使用中の音声モデルの提供を終了したため、返信は別の音声を使用します。音声は設定 › 接続 › サービスと連携で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 사용 중인 음성 모델을 더 이상 제공하지 않아 답변에 다른 음성이 사용됩니다. 음성은 설정 › 연결 › 서비스 및 연동에서 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ biedt het gebruikte stemmodel niet meer aan, dus antwoorden gebruiken een andere stem. Wijzig stemmen in Instellingen › Verbindingen › Diensten en integraties."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não oferece mais o modelo de voz em uso, então as respostas usam outra voz. Altere as vozes em Configurações › Conexões › Serviços e integrações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ больше не предлагает используемую голосовую модель, поэтому ответы звучат другим голосом. Сменить голос можно в разделе «Настройки › Подключения › Сервисы и интеграции»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ اب زیرِ استعمال صوتی ماڈل پیش نہیں کرتا، اس لیے جوابات کسی دوسری آواز میں ہیں۔ آوازیں ترتیبات › کنکشنز › سروسز اور انٹیگریشنز میں تبدیل کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不再提供当前使用的语音模型，因此回复使用其他语音。可在设置 › 连接 › 服务与集成中更改语音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不再提供目前使用的語音模型，因此回覆會使用其他語音。在 設定 › 連線 › 服務與整合 中更改語音。"
          }
        }
      }
    },
    "%@ no longer offers the voice model in use, so replies use the built-in voice. Choose another voice in Settings › Connections › Services & Integrations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد %@ يوفر نموذج الصوت المستخدم، لذا تستخدم الردود الصوت المدمج. غيّر الأصوات في الإعدادات › الاتصالات › الخدمات والتكاملات."
          }
