    "Nothing is switched on until you choose it. Each job can be changed later under Roles in AI & Personality." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يتم تشغيل أي شيء حتى تختاره. يمكن تغيير كل مهمة لاحقًا ضمن «الأدوار» في «الذكاء الاصطناعي والشخصية»."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada se activa hasta que lo elijas. Puedes cambiar cada tarea después en Roles, dentro de IA y personalidad."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
