          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FHIR سرور نے اسناد قبول نہیں کیں۔ میڈیکل ایکسپورٹ کی ترتیبات میں انہیں چیک کریں یا تبدیل کریں۔"
