    "The assistant warns at or below the minimum. Leave it empty for no warning until the last one is used." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينبّه المساعد عند الوصول إلى الحد الأدنى أو دونه. اتركه فارغًا لعدم التنبيه حتى استخدام آخر قطعة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente avisa cuando se llega al mínimo o se baja de él. Déjalo vacío para no recibir aviso hasta que se use la última."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant avertit lorsque la quantité atteint le minimum ou passe en dessous. Laissez vide pour ne recevoir aucun avertissement avant que le dernier soit utilisé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az asszisztens a minimumnál vagy az alatt figyelmeztet. Hagyja üresen, ha nem kér figyelmeztetést az utolsó darab elhasználásáig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistente avvisa quando la quantità raggiunge il minimo o scende al di sotto. Lascialo vuoto per non ricevere avvisi finché non viene usato l’ultimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最小数量以下になると、アシスタントが警告します。最後の1つを使い切るまで警告しない場合は、空のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어시스턴트는 최소 수량 이하가 되면 경고합니다. 마지막 하나를 쓸 때까지 경고하지 않으려면 비워 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De assistent waarschuwt bij of onder het minimum. Laat het leeg voor geen waarschuwing tot de laatste is gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente avisa quando atinge o mínimo ou fica abaixo dele. Deixe vazio para não receber aviso até que a última seja usada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ассистент предупреждает, когда остаток достигает минимума или ниже. Оставьте поле пустым, чтобы предупреждений не было, пока не будет использован последний."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسسٹنٹ کم از کم حد پر یا اس سے نیچے انتباہ دیتا ہے۔ آخری استعمال ہونے تک انتباہ نہ دینے کے لیے اسے خالی چھوڑ دیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "库存降至最低数量或以下时，助手会发出警告。留空则不发警告，直到最后一件用完。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "庫存降至最低數量或以下時，助理會發出警告。留空則不發出警告，直到最後一件用完。"
          }
        }
      }
    },
