    "The Discord is the fastest way to ask a question or share what you've built." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دي سكورد هو أسرع وسيلة لطرح سؤال أو مشاركة ما قمت ببنائه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord es la forma más rápida de hacer una pregunta o compartir lo que has creado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord est le moyen le plus rapide pour poser une question ou partager ce que vous avez créé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Discord a leggyorsabb módja annak, hogy kérdést tegyél fel, vagy megoszd, amit építettél."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord è il modo più veloce per porre una domanda o condividere ciò che hai costruito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discordは質問をしたり、作成したものを共有する最速の方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord는 질문을 하거나 자신이 만든 것을 공유하는 가장 빠른 방법입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord is de snelste manier om een vraag te stellen of te delen wat je hebt gebouwd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
