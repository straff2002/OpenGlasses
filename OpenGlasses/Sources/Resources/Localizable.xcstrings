            "value" : "Деталь: %@"
          }
        }
      }
    },
    "Partial units round up, with a minimum of one unit after any recorded work. Applied to new jobs; the exact time remains in the record." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неполные единицы округляются в большую сторону, минимум одна единица после любой зафиксированной работы. Применяется к новым заданиям; точное время сохраняется в записи."
          }
        }
      }
    },
    "Passcode" : {
