        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een AI-schatting geproduceerd vanuit één camerahoek. Het is geen meting, inspectie of certificering, en alles buiten dat zicht is niet beoordeeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é uma estimativa de IA produzida a partir de uma única visão de câmera. Não se trata de uma medição, de uma inspeção ou de uma certificação, e nada fora dessa visão não foi avaliado."
          }
