    },
    "Capture Glasses Photo" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимок с очков"
          }
        }
      }
    },
    "Capture quality, where recordings are copied, your streaming platform and key, and chat read-aloud — the assistant speaking your live chat into your ear — all live under Services." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Качество захвата, место копирования записей, платформа и ключ трансляции, а также озвучивание чата — когда ассистент читает вам вслух чат в прямом эфире — находятся в разделе «Службы»."
          }
        }
      }
    },
    "Captures a still from the camera and sends it with the prompt." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делает снимок камерой и отправляет его вместе с запросом."
          }
        }
      }
    },
