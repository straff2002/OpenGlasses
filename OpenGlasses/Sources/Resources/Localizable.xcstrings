    "Smart-home and Home Assistant actuation is blocked when you're away from your home region." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحظر تشغيل المنزل الذكي وHome Assistant عندما تكون بعيدًا عن منطقة منزلك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La acción en la casa inteligente y en Home Assistant se bloquea cuando estás lejos de tu región de residencia."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’actionnement de la maison intelligente et de Home Assistant est bloqué quand vous êtes hors de votre région d’origine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az okosotthon- és Home Assistant-vezérlés le van tiltva, ha távol van az otthoni régiójától."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'azionamento di casa intelligente e Home Assistant è bloccato quando sei fuori dalla tua regione di casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お住まいの地域から離れているときは、スマートホームとHome Assistantの操作がブロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집이 있는 지역을 벗어나면 스마트 홈 및 Home Assistant 작동이 차단됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bediening van slimme woning en Home Assistant wordt geblokkeerd als u buiten uw thuisregio bent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acionamento da casa inteligente e do Home Assistant é bloqueado quando você está fora da sua região de casa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управление умным домом и Home Assistant блокируется, когда вы вне своего домашнего региона."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب آپ اپنے ہوم ریجن سے باہر ہوں تو اسمارٹ ہوم اور Home Assistant ایکچویشن بلاک ہوتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你离开家所在的区域时，会阻止智能家居和 Home Assistant 的执行动作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你離開所在的居家地區時，智慧家庭與 Home Assistant 的致動會被封鎖。"
          }
        }
      }
    },
    "Smart-home service calls, saved shortcuts, opening another app, and the ready-made templates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
