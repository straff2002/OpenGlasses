    "The office approved a different phone. Nothing on this phone changed. Ask the office for a new code." : {
      "comment" : "A message displayed when the office approves a phone that's already been paired.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المكتب وافق على هاتف مختلف. لم يتغير شيء على هذا الهاتف. اطلب من المكتب رمزًا جديدًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oficina aprobó otro celular. No cambió nada en este celular. Pídele a la oficina un código nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bureau a approuvé un autre téléphone. Rien sur ce téléphone n'a changé. Demandez un nouveau code au bureau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iroda egy másik telefont hagyott jóvá. Ezen a telefonon semmi nem változott. Kérj új kódot az irodától."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ufficio ha approvato un telefono diverso. Non è cambiato nulla su questo telefono. Chiedere in ufficio un nuovo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事務所は別の電話を承認しました。この電話上の内容は何も変更されていません。新しいコードは事務所に問い合わせてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사무실에서 다른 전화를 승인했습니다. 이 전화기에는 아무것도 바뀌지 않았습니다. 사무실에 새 코드를 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kantoor heeft een andere telefoon goedgekeurd. Er is niets op deze telefoon veranderd. Vraag het kantoor om een nieuwe code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escritório aprovou um telefone diferente. Nada neste telefone mudou. Peça ao escritório um novo código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офис одобрил другой телефон. На этом телефоне ничего не изменилось. Попросите у офиса новый код."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آفس نے کسی دوسرے فون کی منظوری دی۔ اس فون پر کچھ تبدیل نہیں ہوا۔ آفس سے نیا کوڈ مانگیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "办公室批准了另一部电话。这部电话上的任何内容都没有改变。向办公室询问新的代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辦公室批准了另一支電話。這支電話上的任何內容都沒有改變。請向辦公室索取新代碼。"
          }
        }
      }
    },
    "The office binding could not be verified. Check the office details and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر التحقق من ربط المكتب. تحقق من تفاصيل المكتب وحاول مرة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el vínculo con la oficina. Revisa los datos de la oficina e intenta de nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liaison du bureau n’a pas pu être vérifiée. Vérifiez les détails du bureau et réessayez."
