          }
        }
      }
    },
    "Goes to the developer of Avenkin at %@, not to your company's support. It contains no conversations or private data. No account needed, and you can add to it before you send." : {
      "comment" : "A description of the report, including a disclaimer and a call to action.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
