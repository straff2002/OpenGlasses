    "Radius %lld m" : {
      "comment" : "A stepper that lets the user set the radius of a geofence around their home.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
