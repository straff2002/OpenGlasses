    "Select a device, automation, scene, or script. Choose \"All\" to target every entity of the service domain." : {
      "comment" : "A description of the available entities.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد جهازًا، أو أتمتة، أو مشهدًا، أو سكريبت. اختر \"الكل\" لاستهداف كل كيان في مجال الخدمة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un dispositivo, una automatización, una escena o un script. Elige “All” para dirigirte a todas las entidades del dominio del servicio."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionner un appareil, une automatisation, une scène ou un script. Choisissez « Tout » pour cibler toutes les entités du domaine de service."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon ki egy eszközt, automatikát, jelenetet vagy szkriptet. Válassza az „Összes” lehetőséget a szolgáltatási tartomány minden entitásának megcélzásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona un dispositivo, un'automazione, una scena o uno script. Scegli \"Tutti\" per scegliere come target ogni entità del dominio del servizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス、オートメーション、シーン、またはスクリプトを選択します。「すべて」を選ぶと、サービスドメイン内のすべてのエンティティを対象にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
