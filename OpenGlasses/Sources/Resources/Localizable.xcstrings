    "Resets content-free occurrence markers only. It does not delete Calendar, Reminders, routes, or digest items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد ضبط مؤشرات حدوث المحتوى الفارغ فقط. لا يقوم بحذف التقويم، التذكيرات، الطرق، أو عناصر الملخص."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece solo los marcadores de ocurrencia sin contenido. No elimina elementos de Calendario, Recordatorios, rutas ni del resumen."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialise uniquement les marqueurs d'occurrences sans contenu. Cela ne supprime pas le calendrier, les rappels, les itinéraires ou les éléments de synthèse."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a tartalommentes előfordulásjelzőket állítja vissza. Nem törli a naptárat, az emlékeztetőket, az útvonalakat vagy a kivonatelemeket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reimposta solo i marcatori di occorrenze prive di contenuto. Non elimina Calendario, Promemoria, percorsi o elementi riassuntivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテンツなしの発生マーカーのみをリセットします。カレンダー、リマインダー、ルート、またはダイジェスト項目は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내용이 없는 발생 마커만 재설정합니다. 달력, 미리 알림, 경로 또는 요약 항목은 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset alleen content-vrije gebeurtenismarkers. Het verwijdert geen Agenda, Herinneringen, routes of digest-items."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefine apenas marcadores de ocorrência sem conteúdo. Ele não exclui calendário, lembretes, rotas ou itens de resumo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбрасывает только маркеры событий без содержимого. Не удаляет Календарь, Напоминания, маршруты или элементы дайджеста."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف بغیر مواد والے وقوعہ نشانات ری سیٹ کرتا ہے۔ یہ کیلنڈر، یاد دہانیاں، راستے یا ڈائجسٹ آئٹمز حذف نہیں کرتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅重置无内容发生标记。不会删除日历、提醒事项、路线或摘要项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅重置無內容的事件標記。不會刪除行事曆、提醒事項、路線或摘要項目。"
          }
        }
      }
    },
    "Resets soul, skills, and memory to factory defaults. Your learned memories will be lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد الروح والمهارات والذاكرة إلى إعدادات المصنع. سيتم فقدان الذكريات المكتسبة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece el alma, las habilidades y la memoria a los valores de fábrica. Se perderán los recuerdos aprendidos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialise l'âme, les compétences et la mémoire aux réglages d'usine. Vos souvenirs acquis seront perdus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visszaállítja a lelket, a képességeket és a memóriát a gyári alapértékekre. A tanult emlékeid elvesznek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina anima, abilità e memoria alle impostazioni di fabbrica. I tuoi ricordi appresi andranno persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魂、スキル、記憶を工場出荷時の状態にリセットします。学習した記憶は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영혼, 스킬, 메모리를 공장 기본값으로 재설정합니다. 배운 기억은 사라질 것입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset het bewustzijn, de vaardigheden en het geheugen naar de fabrieksinstellingen. Je aangeleerde herinneringen gaan verloren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefine alma, habilidades e memória para os padrões de fábrica. Suas memórias aprendidas serão perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбрасывает личность, навыки и память к заводским настройкам. Ваши накопленные воспоминания будут утеряны."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روح، اسکلز اور میموری کو فیکٹری ڈیفالٹس پر ری سیٹ کرتا ہے۔ آپ کی سیکھی ہوئی یادیں ضائع ہو جائیں گی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将灵魂、技能和记忆重置为出厂默认。您学到的记忆将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將靈魂、技能和記憶重置為出廠默認設置。您已學習的記憶將會丟失。"
          }
        }
      }
    },
    "Resize and compress photos before they're sent to the AI for description — keeps context smaller while preserving readable detail." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير حجم الصور وضغطها قبل إرسالها إلى الذكاء الاصطناعي للوصف — يحافظ على السياق أصغر مع الحفاظ على التفاصيل القابلة للقراءة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensiona y comprime las fotos antes de enviarlas a la IA para su descripción; mantiene el contexto más pequeño y conserva el detalle legible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensionner et compresser les photos avant de les envoyer à l'IA pour description — réduit le contexte tout en préservant les détails lisibles."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méretezze át és tömörítse a fényképeket, mielőtt elküldené őket az MI-nek leírás céljából – a kontextust kisebbre tartja, miközben megőrzi az olvasható részleteket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridimensiona e comprimi le foto prima che vengano inviate all'intelligenza artificiale per la descrizione: mantieni il contesto più piccolo preservando i dettagli leggibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIによる説明のために送信する前に写真のサイズを変更して圧縮します — 読みやすい詳細を保持しながらコンテキストを小さく保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설명을 위해 사진을 AI에 보내기 전에 사진의 크기를 조정하고 압축합니다. 읽을 수 있는 세부 정보를 유지하면서 컨텍스트를 더 작게 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formaat aanpassen en foto's comprimeren voordat ze naar de AI worden gestuurd voor beschrijving — houdt de context kleiner terwijl leesbare details behouden blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensione e comprima fotos antes de enviá-las à IA para descrição — mantém o contexto menor e preserva detalhes legíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменяет размер и сжимает фото перед отправкой в ИИ для описания — уменьшает контекст, сохраняя читаемые детали."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفصیل کے لیے AI کو بھیجنے سے پہلے تصاویر کا سائز کم اور کمپریس کریں — قابلِ مطالعہ تفصیل برقرار رکھتے ہوئے سیاق کو چھوٹا رکھتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在将照片发送到 AI 描述之前调整大小和压缩 — 保持上下文较小，同时保留可读细节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在將照片發送給 AI 進行描述之前調整大小和壓縮 — 保持上下文較小，同時保留可讀的細節。"
          }
        }
      }
    },
