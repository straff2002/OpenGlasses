        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ گفتگو ختم کرتا ہے۔ اس کے بعد آپ جو بولیں گے اس سے نئی گفتگو شروع ہوگی۔"
