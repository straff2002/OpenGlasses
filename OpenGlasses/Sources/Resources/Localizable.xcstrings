    "Answer by tapping, or just say it — “same job”, “that one's finished”, “not sure”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب عن طريق النقر، أو قلها فقط - \"نفس المهمة\"، \"انتهى هذا العمل\"، \"غير متأكد\"."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde tocando o simplemente dilo: “el mismo trabajo”, “ese ya terminó”, “no estoy seguro”."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez en tapotant, ou dites-le simplement — « même travail », « celui-ci est terminé », « pas sûr »."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszoljon koppintással, vagy csak mondja ki – „ugyanaz a munka”, „az befejeződött”, „nem biztos”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi toccando o semplicemente dicendo: \"stesso lavoro\", \"quello è finito\", \"non sono sicuro\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップで回答するか、ただ言う — 「同じ仕事」、「その仕事は終わった」、「よくわからない」。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하여 대답하거나 \"동일한 작업\", \"그 작업은 끝났습니다\", \"확실하지 않음\"이라고 말하면 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwoord door te tikken, of zeg het gewoon: \"zelfde klus\", \"die is klaar\", \"ik weet het niet zeker\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda tocando ou apenas diga — “mesmo trabalho”, “esse trabalho terminou”, “não tenho certeza”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвечайте нажатием или просто скажите — «то же задание», «это завершено», «не уверен»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹیپ کر کے جواب دیں، یا بس بول دیں — “وہی جاب”، “وہ والی ختم ہو گئی”، “یقین نہیں”۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过点击回答，或者直接说——“同样的工作”，“那已经完成了”，“不确定”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過點選回答，或直接說出 — “相同工作”、“那個已完成”、“不確定”。"
          }
        }
      }
    },
