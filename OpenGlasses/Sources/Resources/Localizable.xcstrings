          }
        }
      }
    },
    "Tap a line to set its count or change its details. Anything said to the assistant shows here too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر سطرًا لضبط عدده أو تغيير تفاصيله. كل ما يُقال للمساعد يظهر هنا أيضًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una línea para establecer su conteo o cambiar sus detalles. Todo lo que le digas al asistente también aparece aquí."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur une ligne pour définir son décompte ou modifier ses détails. Tout ce qui est dit à l’assistant s’affiche aussi ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson egy sorra a darabszám beállításához vagy az adatok módosításához. Itt jelenik meg mindaz is, amit az asszisztensnek mondott."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una riga per impostarne il conteggio o modificarne i dettagli. Anche tutto ciò che dici all’assistente compare qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目をタップして、数量や詳細を設定します。アシスタントに伝えた内容もここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 탭하여 수량이나 세부 정보를 설정하세요. 어시스턴트에게 말한 내용도 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een regel om het aantal in te stellen of de gegevens te wijzigen. Alles wat tegen de assistent is gezegd, verschijnt hier ook."
