    "Connect to the internet once to finish setting up this phone, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بالإنترنت مرة واحدة لإنهاء إعداد هذا الهاتف، ثم حاول مرة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate a internet una vez para terminar de configurar este celular y luego intenta de nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à Internet une fois pour terminer la configuration de ce téléphone, puis réessayez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakozzon egyszer az internethez a telefon beállításának befejezéséhez, majd próbálja újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettiti a Internet una volta per completare la configurazione di questo telefono, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この電話の設定を完了するにはインターネットに一度接続してから、もう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷에 한 번 연결하여 휴대전화 설정을 완료한 후 다시 시도해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak één keer verbinding met internet om het instellen van deze telefoon te voltooien en probeer het vervolgens opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte-se à Internet uma vez para concluir a configuração do telefone e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключитесь к интернету один раз, чтобы завершить настройку этого телефона, затем повторите попытку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس فون کا سیٹ اپ مکمل کرنے کے لیے ایک بار انٹرنیٹ سے منسلک ہوں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接到互联网一次以完成此手机的设置，然后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先連接網路以完成此手機的設定，然後再試一次。"
          }
        }
      }
    },
    "Connect to the internet to renew by %@. This phone renews on its own whenever it can reach %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بالإنترنت للتجديد قبل %1$@. يجدد هذا الهاتف نفسه تلقائيًا كلما أمكنه الوصول إلى %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to the internet to renew by %1$@. This phone renews on its own whenever it can reach %2$@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate a internet para renovar antes del %1$@. Este celular se renueva solo siempre que pueda comunicarse con %2$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à Internet pour renouveler avant le %1$@. Ce téléphone se renouvelle de lui-même dès qu’il peut joindre %2$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakozzon az internethez, hogy megújíthassa eddig: %1$@. Ez a telefon magától megújul, amikor eléri ezt: %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettiti a Internet per rinnovare entro %1$@. Questo telefono si rinnova da solo ogni volta che riesce a raggiungere %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@までにインターネットに接続して更新してください。このiPhoneは、%2$@に接続できるときは自動で更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@까지 인터넷에 연결하여 갱신하세요. 이 휴대전화는 %2$@에 연결할 수 있을 때마다 자동으로 갱신됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak verbinding met internet om vóór %1$@ te verlengen. Deze telefoon verlengt automatisch zodra hij %2$@ kan bereiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte-se à internet para renovar até %1$@. Este telefone se renova sozinho sempre que consegue alcançar %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключитесь к интернету, чтобы продлить до %1$@. Этот телефон продлевает сам, как только может связаться с %2$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ تک تجدید کے لیے انٹرنیٹ سے منسلک ہوں۔ جب بھی یہ فون %2$@ تک پہنچ سکتا ہے، خود تجدید کر لیتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请连接互联网，在 %1$@ 前完成续期。只要能连接到 %2$@，这部手机就会自行续期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請連上網際網路，在 %1$@ 前完成續期。只要能連上 %2$@，這支手機就會自行續期。"
          }
        }
      }
    },
