    "Clinical recordings and transcripts are stored separately from general notes, with clear labelling of purpose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن التسجيلات والنصوص السريرية بشكل منفصل عن الملاحظات العامة، مع تسمية واضحة للغرض."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones y transcripciones clínicas se guardan por separado de las notas generales, con una indicación clara de su finalidad."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements et transcriptions cliniques sont stockés séparément des notes générales, avec une indication claire de leur finalité."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A klinikai felvételek és átiratok az általános jegyzetektől elkülönítve vannak tárolva, a cél egyértelmű jelölésével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registrazioni e le trascrizioni cliniche sono conservate separatamente dalle note generali, con indicazione chiara della finalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "臨床の録音と文字起こしは、目的を明確に表示したうえで、一般のメモとは別に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "임상 녹음과 대화 기록은 목적을 명확히 표시하여 일반 메모와 별도로 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klinische opnames en transcripties worden gescheiden van algemene notities opgeslagen, met duidelijke vermelding van het doel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravações e transcrições clínicas são guardadas separadamente das anotações gerais, com a finalidade claramente identificada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клинические записи и расшифровки хранятся отдельно от обычных заметок, с чётким указанием назначения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طبی ریکارڈنگز اور ٹرانسکرپٹس عمومی نوٹس سے الگ محفوظ کی جاتی ہیں، مقصد کی واضح لیبلنگ کے ساتھ۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "临床录音和转录与一般笔记分开存储，并明确标注用途。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "臨床錄音與逐字稿會與一般備註分開儲存，並清楚標示用途。"
          }
        }
      }
    },
