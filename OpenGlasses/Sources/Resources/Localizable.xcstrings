    "Audit log provides a record of all data access for breach investigation and notification requirements." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوفر سجل التدقيق سجلًا لكل عمليات الوصول إلى البيانات لأغراض التحقيق في الاختراقات ومتطلبات الإخطار."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de auditoría deja constancia de todo acceso a datos para la investigación de brechas y los requisitos de notificación."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal d’audit consigne tous les accès aux données pour les enquêtes sur les atteintes et les exigences de notification."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az auditnapló rögzít minden adathozzáférést az adatvédelmi incidensek kivizsgálásához és a bejelentési követelményekhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il registro di audit conserva traccia di tutti gli accessi ai dati per le indagini sulle violazioni e gli obblighi di notifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "監査ログは、侵害の調査と通知要件のために、すべてのデータアクセスの記録を提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감사 로그는 침해 조사 및 통지 요건을 위해 모든 데이터 접근 기록을 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het auditlogboek bevat een overzicht van alle gegevenstoegang voor onderzoek naar datalekken en meldplichten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro de auditoria guarda todos os acessos a dados para investigação de violações e requisitos de notificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнал аудита ведёт запись всех обращений к данным для расследования нарушений и выполнения требований об уведомлении."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آڈٹ لاگ ڈیٹا کی خلاف ورزی کی تحقیقات اور اطلاع کی ضروریات کے لیے ڈیٹا تک رسائی کا مکمل ریکارڈ فراہم کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审计日志记录所有数据访问，用于数据泄露调查和通知要求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稽核紀錄會保存所有資料存取的紀錄，供外洩調查與通報要求使用。"
          }
        }
      }
    },
