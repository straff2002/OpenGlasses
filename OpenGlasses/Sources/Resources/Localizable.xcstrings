    "Good detail with smaller payloads — a practical default for most vision questions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفصيل جيد بحمولات أصغر — إعداد افتراضي عملي لمعظم أسئلة الرؤية."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buen detalle con cargas más pequeñas: un valor predeterminado práctico para la mayoría de las preguntas de visión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon niveau de détail avec des charges plus légères — un choix par défaut pratique pour la plupart des questions de vision."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jó részletesség kisebb adatmennyiséggel — a legtöbb látással kapcsolatos kérdéshez praktikus alapértelmezés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buon dettaglio con payload più piccoli: un'impostazione predefinita pratica per la maggior parte delle domande di visione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さめのデータで十分な精細さ — ほとんどのビジョンの質問に適した実用的なデフォルトです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적은 용량으로 충분한 디테일을 제공합니다. 대부분의 비전 질문에 실용적인 기본값입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
