    "Always uses a compact prompt; ~%lldk-token context (~%lldk for the prompt)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم دائمًا موجّهًا مضغوطًا؛ سياق بحجم ~%1$lldk رمز (~%2$lldk للموجّه)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Always uses a compact prompt; ~%1$lldk-token context (~%2$lldk for the prompt)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre usa un prompt compacto; contexto de ~%1$lldk tokens (~%2$lldk para el prompt)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
