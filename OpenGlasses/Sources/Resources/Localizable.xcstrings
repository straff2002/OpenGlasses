    "Choose the protocol your server implements and enter the full WebSocket URL. Public endpoints require wss://." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر البروتوكول الذي ينفذه خادمك وأدخل عنوان WebSocket الكامل. تتطلب نقاط الاتصال العامة wss://."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el protocolo que implementa tu servidor e ingresa la URL completa de WebSocket. Los puntos de conexión públicos requieren wss://."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le protocole implémenté par votre serveur et entrez l’URL WebSocket complète. Les points de terminaison publics exigent wss://."
