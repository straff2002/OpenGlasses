          }
        }
      }
    },
    "Goes to the app's developer. No conversations or private data." : {
      "comment" : "Text displayed in a button that opens a new screen for the user to report a problem with the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
