    "Home Assistant isn't set up, so music plays on your phone until you add it under Services." : {
      "comment" : "A description of the music section when Home Assistant isn't configured.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساعد المنزل غير مُعد، لذلك يتم تشغيل الموسيقى على هاتفك حتى تضيفه ضمن الخدمات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant no está configurado, así que la música se reproduce en tu celular hasta que lo agregues en Servicios."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant n'est pas configuré, donc la musique joue sur votre téléphone jusqu'à ce que vous l'ajoutiez sous Services."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Otthoni asszisztens nincs beállítva, így zene szól a telefonon, amíg hozzá nem ad a Szolgáltatások alatt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant non è configurato, quindi la musica viene riprodotta sul telefono finché non la aggiungi in Servizi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistantは設定されていないため、サービスに追加するまで音楽は携帯電話で再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈어시스턴트가 설정되지 않았으므로 서비스 아래에 추가할 때까지 휴대폰에서 음악이 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant is niet ingesteld, dus er wordt muziek op je telefoon afgespeeld totdat je deze toevoegt onder Services."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Home Assistant não está configurado, então a música é reproduzida no seu telefone até você adicioná-la em Serviços."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant не настроен, поэтому музыка играет на телефоне, пока вы не добавите его в разделе «Службы»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant سیٹ اپ نہیں ہے، اس لیے جب تک آپ اسے سروسز کے تحت شامل نہیں کرتے، موسیقی آپ کے فون پر چلتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant 尚未设置，因此音乐会在您的手机上播放，直到您在服务中添加它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant 尚未設置，因此音樂會在您的手機上播放，直到您在服務中添加它。"
          }
        }
      }
    },
