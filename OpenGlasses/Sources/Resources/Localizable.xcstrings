    "A %@ download is what makes this path work on your iPhone — no account, no key. The assistant starts answering on-device as soon as it's finished." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحميل %@ هو ما يجعل هذا المسار يعمل على iPhone الخاص بك — بلا حساب ولا مفتاح. يبدأ المساعد بالإجابة على الجهاز فور اكتماله."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una descarga de %@ es lo que hace funcionar esta ruta en tu iPhone: sin cuenta ni clave. El asistente empieza a responder en el dispositivo en cuanto termina."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un téléchargement de %@ permet à cette voie de fonctionner sur votre iPhone — sans compte ni clé. L’assistant commence à répondre sur l’appareil dès qu’il est terminé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ letöltése teszi lehetővé, hogy ez az útvonal működjön az iPhone-ján — fiók és kulcs nélkül. Az asszisztens azonnal megkezdi a válaszadást az eszközön, amint a letöltés befejeződött."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il download di %@ è ciò che fa funzionare questo percorso sul tuo iPhone: nessun account, nessuna chiave. L'assistente inizia a rispondere sul dispositivo non appena è finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneでこの方法を使うには、%@のダウンロードが必要です。アカウントもキーも不要です。ダウンロードが終わると、アシスタントはすぐにオンデバイスで応答を始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 다운로드로 이 방식이 iPhone에서 작동합니다. 계정도 키도 필요 없습니다. 다운로드가 끝나는 즉시 어시스턴트가 기기에서 응답하기 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een download van %@ zorgt ervoor dat dit pad werkt op uw iPhone — geen account, geen sleutel. De assistent begint op het apparaat te antwoorden zodra de download klaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixar %@ é o que faz este caminho funcionar no seu iPhone — sem conta e sem chave. O assistente começa a responder no dispositivo assim que o download termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка %@ — это то, что включает этот путь на вашем iPhone: без учётной записи, без ключа. Ассистент начнёт отвечать на устройстве, как только она завершится."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ڈاؤن لوڈ ہی آپ کے iPhone پر یہ راستہ ممکن بناتا ہے — نہ اکاؤنٹ، نہ کلید۔ ڈاؤن لوڈ مکمل ہوتے ہی اسسٹنٹ آن ڈیوائس جواب دینا شروع کر دیتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载 %@ 后，此方式即可在你的 iPhone 上运行 — 无需账户，无需密钥。下载完成后，助手会立即开始在设备上回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載%@後，這條路徑才能在你的 iPhone 上運作 — 不需要帳號，也不需要金鑰。下載完成後，助理就會立即開始在裝置上回答。"
          }
        }
      }
    },
