      }
    },
    "Oracle Health (Cerner) uses FHIR R4 with Millennium platform integration." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oracle Health (Cerner) использует FHIR R4 с интеграцией платформы Millennium."
          }
        }
      }
    },
    "Order: Perplexity → Tavily → Brave → SearXNG → Tavily free → DuckDuckGo. With no keys configured, Tavily free runs automatically (rate-limited, no signup). Add a Tavily key to lift the free rate limit." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок: Perplexity → Tavily → Brave → SearXNG → Tavily (бесплатно) → DuckDuckGo. Если ключи не настроены, автоматически используется бесплатный Tavily (с ограничением частоты запросов, без регистрации). Добавьте ключ Tavily, чтобы снять это ограничение."
          }
        }
      }
