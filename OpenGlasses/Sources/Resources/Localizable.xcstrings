        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переведённые субтитры — окружающая речь отображается на вашем языке. По умолчанию выключено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمہ شدہ کیپشنز — آس پاس کی گفتگو آپ کی زبان میں۔ بطورِ طے شدہ آف۔"
