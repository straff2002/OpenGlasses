          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se isso corresponde à tela do escritório"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте, что это совпадает с экраном офиса"
          }
        },
        "ur" : {
