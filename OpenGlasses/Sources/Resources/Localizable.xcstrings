    "Remove %@'s profile?" : {
      "comment" : "A confirmation dialog asking the user to remove a given organisation's profile.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
