    "Headroom" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتفاع الرأس"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margen de memoria"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marge de manœuvre"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejtér"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza libera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッドルーム"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤드룸"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoofdruimte"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura livre"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запас памяти"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گنجائش"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "净空"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "淨空高度"
          }
        }
      }
    },
    "Headroom is how much more memory the app can use before iOS terminates it. A model won't load unless it fits in the current headroom with room to generate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتفاع الرأس هو مقدار الذاكرة الإضافية التي يمكن للتطبيق استخدامها قبل أن يعمل iOS على إنهائه. لن يتم تحميل نموذج ما إلا إذا كان يتناسب مع ارتفاع الرأس الحالي مع وجود مساحة للتوليد."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El margen es cuánta memoria más puede usar la app antes de que iOS la cierre. Un modelo no se carga a menos que quepa en el margen actual con espacio para generar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La marge de manœuvre est la quantité de mémoire supplémentaire que l'application peut utiliser avant que iOS ne l'arrête. Un modèle ne se chargera pas sauf si elle tient dans la marge de manœuvre actuelle avec de la place pour générer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A férőhely azt jelenti, hogy az alkalmazás mennyi memóriát tud felhasználni, mielőtt a iOS leállítja. A modell csak akkor töltődik be, ha elfér az aktuális generálható térben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headroom è la quantità di memoria in più che l'app può utilizzare prima che iOS la termini. Un modello non verrà caricato a meno che non rientri nell'headroom corrente con spazio per generare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッドルームとは、iOS が終了する前にアプリが使用できるメモリの追加容量です。モデルは、生成に必要な余裕を持って現在のヘッドルームに収まらない限り、読み込まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤드룸은 iOS가 앱을 종료하기 전에 앱이 사용할 수 있는 메모리의 양입니다. 생성할 공간이 있는 현재 헤드룸에 맞지 않으면 모델이 로드되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoofdruimte is hoeveel meer geheugen de app kan gebruiken voordat iOS deze beëindigt. Een model wordt niet geladen tenzij het in de huidige hoofdruimte past en ruimte heeft om te genereren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headroom é quanta memória o aplicativo pode usar antes que iOS o termine. Um modelo não será carregado a menos que caiba no espaço atual com espaço para geração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запас памяти — это сколько ещё памяти может использовать приложение, прежде чем iOS его завершит. Модель не загрузится, если она не помещается в текущий запас с местом для генерации."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گنجائش وہ اضافی میموری ہے جو ایپ، iOS کے اسے بند کرنے سے پہلے، استعمال کر سکتی ہے۔ ماڈل اس وقت تک لوڈ نہیں ہوگا جب تک وہ جنریٹ کرنے کی جگہ سمیت موجودہ گنجائش میں نہ سما جائے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "净空是指在 iOS 终止应用程序之前，应用程序还能使用多少内存。模型在当前净空足够生成的情况下才能加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "淨空高度是指應用程式在 iOS 終止之前可以使用的額外記憶體量。模型只有在適合當前淨空高度並有生成空間時才會載入。"
          }
        }
      }
    },
