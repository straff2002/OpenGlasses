    "Pick from the list or type a model ID. Turn on Vision to send photos to the AI." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر من القائمة أو اكتب معرف الطراز. قم بتشغيل رؤية لإرسال الصور إلى الذكاء الاصطناعي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige de la lista o escribe un ID de modelo. Activa Visión para enviar fotos a la IA."
