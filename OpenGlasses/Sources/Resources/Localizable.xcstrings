        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта модель не может использовать инструменты на Chat Completions, поэтому шаги с инструментами используют Responses API."
          }
        },
        "ur" : {
          "stringUnit" : {
