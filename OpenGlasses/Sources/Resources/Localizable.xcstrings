          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آف"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
