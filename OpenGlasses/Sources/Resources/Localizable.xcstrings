    "Grows the card to today's whole list." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزرع البطاقة إلى القائمة الكاملة لليوم."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplía la tarjeta a la lista completa de hoy."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait croître la carte à toute la liste d'aujourd'hui."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Növeli a kártyát a mai teljes listára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la scheda fino all'intero elenco di oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードを今日の全リストに成長させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드를 오늘의 전체 목록으로 늘립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt de kaart uitgebreid tot de hele lijst van vandaag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta o cartão para toda a lista de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разворачивает карточку до полного списка на сегодня."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ کو آج کی پوری فہرست تک بڑا کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将卡片扩展到今天的完整列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將卡片擴展至今天的完整清單。"
          }
        }
      }
    },
    "Grows the card to today's whole list. %lld more than the card shows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزرع البطاقة إلى القائمة الكاملة لليوم. %1$lld أكثر مما تظهره البطاقة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplía la tarjeta a la lista completa de hoy. %lld más de los que muestra la tarjeta."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait croître la carte à toute la liste d'aujourd'hui. %1$lld plus que ce que la carte montre."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Növeli a kártyát a mai teljes listára. %1$lld több, mint amennyit a kártya mutat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la scheda fino all'intero elenco di oggi. %1$lld più di quanto mostrato sulla carta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードを今日の全リストに成長させます。%1$lldはカードに表示されている以上。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드를 오늘의 전체 목록으로 늘립니다. 카드에 표시된 것보다 더 많은 %1$lld가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt de kaart uitgebreid tot de hele lijst van vandaag. %1$lld meer dan de kaart laat zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta o cartão para toda a lista de hoje. %1$lld mais do que o cartão mostra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разворачивает карточку до полного списка на сегодня. Ещё %lld сверх того, что показано в карточке."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ کو آج کی پوری فہرست تک بڑا کرتا ہے۔ کارڈ پر دکھائی گئی سے %lld زیادہ۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将卡片扩展到今天的完整列表。%1$lld 比卡片显示的更多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將卡片擴展至今天的完整清單。%1$lld 超出卡片顯示的部分。"
