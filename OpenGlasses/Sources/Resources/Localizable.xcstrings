        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시징, 웹 검색, 스마트 홈 등 Mac을 통한 56개 이상의 도구."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
