    "%@ has replaced its admin card. Scan the new one to make this an administrator phone again." : {
      "comment" : "A message that appears in the footer of the administrator section of an administrator phone. The argument is the string “your organisation”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قامت %1$@ باستبدال بطاقة المسؤول الخاصة بها. قم بمسح الهاتف الجديد ضوئيًا لجعل هذا الهاتف مسؤولًا مرة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reemplazó su tarjeta de administrador. Escanea la nueva para que este vuelva a ser un celular de administrador."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a remplacé sa carte d'administration. Scannez la nouvelle pour en faire de nouveau un téléphone administrateur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ lecserélte admin kártyáját. Szkennelje be az újat, hogy ismét rendszergazdai telefon legyen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha sostituito la sua scheda amministratore. Scansiona quello nuovo per renderlo nuovamente un telefono amministratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は管理者カードを新しいものに置き換えました。この電話を再び管理者電話にするには、新しいカードをスキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@가 관리자 카드를 교체했습니다. 새 전화를 스캔하여 다시 관리자 전화로 만드세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft de beheerderskaart vervangen. Scan de nieuwe om er weer een beheerderstelefoon van te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ substituiu seu cartão de administração. Digitalize o novo para torná-lo um telefone de administrador novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ заменила административную карту. Отсканируйте новую, чтобы снова сделать этот телефон административным."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے اپنا ایڈمن کارڈ بدل دیا ہے۔ اس فون کو دوبارہ ایڈمنسٹریٹر فون بنانے کے لیے نیا کارڈ اسکین کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已更换其管理卡。扫描新手机，使其再次成为管理员电话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已更換其管理卡。掃描新手機，使其再次成為管理員電話。"
          }
        }
      }
    },
    "%@ has revoked this phone. Its settings no longer apply and its content is locked." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سحب %@ صلاحية هذا الهاتف. لم تعد إعداداته سارية ومحتواه مقفل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ revocó el acceso de este celular. Sus ajustes ya no se aplican y su contenido está bloqueado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a révoqué ce téléphone. Ses réglages ne s’appliquent plus et son contenu est verrouillé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ visszavonta ezt a telefont. A beállításai már nem érvényesek, a tartalma pedig zárolva van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha revocato questo telefono. Le sue impostazioni non si applicano più e i suoi contenuti sono bloccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がこのiPhoneを無効にしました。設定は適用されなくなり、コンテンツはロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이 휴대전화를 해제했습니다. 설정이 더 이상 적용되지 않으며 콘텐츠가 잠깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft deze telefoon ingetrokken. De instellingen gelden niet meer en de inhoud is vergrendeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ revogou este telefone. As configurações dele não valem mais e o conteúdo está bloqueado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ этого телефона отозван (%@). Его настройки больше не применяются, а содержимое заблокировано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے اس فون تک رسائی منسوخ کر دی ہے۔ اس کی ترتیبات اب لاگو نہیں ہوتیں اور اس کا مواد مقفل ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已撤销这部手机。其设置不再生效，内容已被锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已撤銷這支手機。其設定不再適用，內容已鎖定。"
          }
        }
      }
    },
