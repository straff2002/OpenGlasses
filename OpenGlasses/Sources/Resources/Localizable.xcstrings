    "nova-3 has the strongest diarization. Streaming is billed per minute of audio." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدى nova-3 أقوى خاصية تقسيم الأصوات. يتم احتساب البث بالدقيقة لكل صوت."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nova-3 tiene la mejor diarización. El streaming se cobra por minuto de audio."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nova-3 a la diarisation la plus performante. La diffusion continue est facturée à la minute d'audio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a nova-3 a legerősebb a diarizációja. A streamelés percenkénti hangfelvétellel kerül felszámításra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nova-3 ha la diarizzazione più forte. Lo streaming viene fatturato al minuto di audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nova-3は最も強力なダイアリゼーションを備えています。ストリーミングは音声の分ごとに課金されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nova-3는 가장 강력한 분할 기능을 가지고 있습니다. 스트리밍은 오디오의 분당 요금이 청구됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nova-3 heeft de sterkste diarisatie. Streaming wordt gefactureerd per minuut audio."
