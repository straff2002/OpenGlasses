          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока профиль действует, никто на этом телефоне не может это изменить."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروفائل نافذ رہنے تک اس فون پر کوئی بھی انہیں تبدیل نہیں کر سکتا۔"
