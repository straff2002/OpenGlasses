    "This device has no Mail account set up, so the report opened in the share sheet. Send it to %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الجهاز لا يحتوي على حساب بريد معد، لذا تم فتح التقرير في ورقة المشاركة. أرسله إلى %1$@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no tiene una cuenta de Mail configurada, así que el reporte se abrió en la hoja para compartir. Envíalo a %@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n'a pas de compte Mail configuré, donc le rapport s'est ouvert dans la feuille de partage. Envoyez-le à %1$@."
