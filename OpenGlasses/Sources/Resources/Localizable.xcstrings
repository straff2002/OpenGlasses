    "Define a tool name and description. When the AI decides to use your tool, it will run the Siri Shortcut or open the URL you configured." : {
      "comment" : "A description of how to use the custom tools feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد اسم الأداة ووصفها. عندما يقرر الذكاء الاصطناعي استخدام أداتك، فإنه سيقوم بتشغيل اختصار Siri أو يفتح عنوان URL الذي قمت بتكوينه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define el nombre y la descripción de una herramienta. Cuando la IA decida usar tu herramienta, ejecutará el atajo de Siri o abrirá la URL que configuraste."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un nom et une description pour l'outil. Lorsque l'IA décide d'utiliser votre outil, elle exécutera le raccourci Siri ou ouvrira l'URL que vous avez configurée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg az eszköz nevét és leírását. Amikor a mesterséges intelligencia úgy dönt, hogy használja az eszközt, lefuttatja a Siri parancsikont, vagy megnyitja az Ön által konfigurált URL-t."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definire il nome e la descrizione dello strumento. Quando l'IA decide di utilizzare il tuo strumento, eseguirà il collegamento Siri o aprirà l'URL configurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツール名と説明を定義します。AIがあなたのツールを使用すると判断した場合、Siriショートカットを実行するか、設定したURLを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 이름과 설명을 정의합니다. AI가 도구를 사용하기로 결정하면 Siri 바로가기를 실행하거나 구성한 URL을 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definieer een gereedschapsnaam en -beschrijving. Wanneer de AI besluit uw tool te gebruiken, voert deze de snelkoppeling Siri uit of opent de URL die u hebt geconfigureerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina um nome e uma descrição para a ferramenta. Quando a IA decidir usar sua ferramenta, ela executará o atalho Siri ou abrirá a URL que você configurou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте имя и описание инструмента. Когда ИИ решит использовать ваш инструмент, он запустит настроенную команду Siri или откроет заданный URL."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹول کا نام اور تفصیل متعین کریں۔ جب AI آپ کا ٹول استعمال کرنے کا فیصلہ کرے گا، تو یہ آپ کا ترتیب دیا ہوا Siri Shortcut چلائے گا یا URL کھولے گا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定义工具名称和描述。当 AI 决定使用您的工具时，它将运行 Siri 快捷方式或打开您配置的 URL。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定義工具名稱和描述。當 AI 決定使用您的工具時，它將運行 Siri 快捷方式或打開您配置的 URL。"
          }
        }
      }
    },
    "Define what information the AI should provide when calling this tool." : {
      "comment" : "A footer label under the \"Parameters\" section of the custom tool editor.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد المعلومات التي يجب أن يقدمها الذكاء الاصطناعي عند استدعاء هذه الأداة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define qué información debe proporcionar la IA al llamar a esta herramienta."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez quelles informations l'IA doit fournir lors de l'appel à cet outil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Határozza meg, hogy az AI-nak milyen információkat kell megadnia az eszköz meghívásakor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definire quali informazioni l'intelligenza artificiale dovrebbe fornire quando si chiama questo strumento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIがこのツールを呼び出すときに提供すべき情報を定義します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 도구를 호출할 때 AI가 제공해야 하는 정보를 정의합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaal welke informatie de AI moet verstrekken bij het aanroepen van deze tool."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina quais informações a IA deve fornecer ao chamar esta ferramenta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определите, какую информацию ИИ должен предоставлять при вызове этого инструмента."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متعین کریں کہ یہ ٹول استعمال کرتے وقت AI کو کون سی معلومات فراہم کرنی چاہیے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定义调用此工具时 AI 应提供的信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定義 AI 在調用此工具時應提供的資訊。"
          }
        }
      }
    },
    "Definitions are scanned at discovery. Blocked tools are never offered to the AI; quarantined tools are only offered under their full server-prefixed name." : {
      "comment" : "A description of the trust system.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم فحص التعاريف عند الاكتشاف. لا يتم عرض الأدوات المحظورة على الذكاء الاصطناعي أبدًا؛ يتم تقديم الأدوات المعزولة فقط تحت اسمها الكامل البادئ بالخادم."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las definiciones se analizan al descubrirlas. Las herramientas bloqueadas nunca se ofrecen a la IA; las que están en cuarentena solo se ofrecen con su nombre completo, con el prefijo del servidor."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les définitions sont analysées lors de la découverte. Les outils bloqués ne sont jamais proposés à l'IA ; les outils en quarantaine ne sont proposés qu'en utilisant leur nom complet avec préfixe du serveur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A definíciókat a felfedezéskor szkenneljük. A blokkolt eszközöket soha nem ajánlják fel az MI-nek; karanténba helyezett eszközök csak a teljes kiszolgáló-előtaggal ellátott nevük alatt állnak rendelkezésre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le definizioni vengono scansionate al momento del rilevamento. Gli strumenti bloccati non vengono mai offerti all'IA; gli strumenti in quarantena vengono offerti solo con il nome completo con prefisso server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定義は検出時にスキャンされます。ブロックされたツールはAIに提供されず、隔離されたツールは完全なサーバープレフィックス名でのみAIに提供されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정의는 검색 시 스캔됩니다. 차단된 도구는 AI에 제공되지 않습니다. 격리된 도구는 서버 접두사가 붙은 전체 이름으로만 제공됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definities worden bij ontdekking gescand. Geblokkeerde tools worden nooit aan de AI aangeboden; in quarantaine geplaatste tools worden alleen aangeboden onder hun volledige servervoorvoegselnaam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As definições são verificadas na descoberta. Ferramentas bloqueadas nunca são oferecidas à IA; as ferramentas em quarentena são oferecidas apenas com o nome completo prefixado pelo servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определения сканируются при обнаружении. Заблокированные инструменты никогда не предлагаются ИИ; инструменты на карантине предлагаются только под полным именем с префиксом сервера."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دریافت کے وقت تعریفوں کی جانچ کی جاتی ہے۔ بلاک شدہ ٹولز AI کو کبھی پیش نہیں کیے جاتے؛ قرنطینہ شدہ ٹولز صرف سرور کے سابقے والے مکمل نام سے پیش کیے جاتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在发现时会扫描定义。被阻止的工具永远不会提供给 AI；被隔离的工具仅在其完整的服务器前缀名称下提供。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定義會在發現時掃描。被封鎖的工具永遠不會提供給 AI；隔離的工具僅在其完整的伺服器前綴名稱下才會提供。"
          }
        }
      }
    },
