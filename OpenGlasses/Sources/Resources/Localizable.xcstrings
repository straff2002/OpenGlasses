    "Hands-free, domain-grounded guidance for field engineers — load a knowledge vault and run grounded, audited jobs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرشادات بدون استخدام اليدين ومستندة إلى المجال للمهندسين الميدانيين — حمّل خزنة معرفة وشغّل مهام مدقَّقة ومستندة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientación manos libres y fundamentada en su dominio para técnicos de campo: carga una bóveda de conocimiento y ejecuta trabajos fundamentados y auditados."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guidage mains libres, ancré dans le domaine, pour les ingénieurs de terrain — chargez un coffre de connaissances et exécutez des travaux ancrés et audités."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéz nélküli, szakterületi alapú útmutatás terepi mérnököknek — töltsön be egy tudástárolót, és futtasson megalapozott, auditált munkákat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guida a mani libere, basata sul settore, per i tecnici sul campo: carica un deposito di conoscenze ed esegui lavori verificati e fondati su fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現場エンジニア向けの、ハンズフリーで分野に根ざしたガイダンス。ナレッジボールトを読み込んで、根拠のある監査可能なジョブを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현장 엔지니어를 위한 핸즈프리 도메인 기반 안내 — 지식 볼트를 불러와 근거에 기반한 감사 가능한 작업을 실행하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handsfree, domeingebaseerde begeleiding voor veldingenieurs: laad een kenniskluis en voer gefundeerde, gecontroleerde taken uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientação prática e baseada no domínio para engenheiros de campo — carregue um cofre de conhecimento e execute trabalhos fundamentados e auditados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовые, предметно-обоснованные подсказки для полевых инженеров — загрузите хранилище знаний и выполняйте задания на проверяемой основе с аудитом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیلڈ انجینئرز کے لیے ہاتھوں کے بغیر، ڈومین پر مبنی رہنمائی — نالج والٹ لوڈ کریں اور بنیاد والی، آڈٹ شدہ جابز چلائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为现场工程师提供免提且基于领域的指导 — 载入知识保险库，运行有依据且经审计的作业。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為現場工程師提供免持、以領域為依據的引導 — 載入知識保險庫，執行有依據且經稽核的工作。"
          }
        }
      }
    },
    "Hands-free, domain-grounded guidance for field engineers — load a knowledge vault and run grounded, audited sessions." : {
      "comment" : "A description of Field Assist.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
