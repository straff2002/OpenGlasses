        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gesprek staat niet meer op het apparaat, of er is nooit een afslag tegen opgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conversa não está mais no dispositivo ou nenhum turno foi salvo contra ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его разговор больше не хранится на устройстве, либо по нему вообще не было сохранено ни одного хода."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کی گفتگو اب ڈیوائس پر نہیں ہے، یا اس کے ساتھ کبھی کوئی باری محفوظ نہیں ہوئی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的对话不再在设备上，或从未保存过任何回合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的對話已不在裝置上，或者從未有過與它對應的回合被保存。"
          }
        }
      }
    },
    "Its locks lift, the settings it chose go back to yours, and a licence it brought is removed." : {
      "comment" : "The text of a confirmation dialog that lets the user remove an organisation's profile.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرفع أقفاله، وتعود الإعدادات التي اختارها إلى إعداداتك، وتُزال الترخيص الذي جلبه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus bloqueos se levantan, los ajustes que eligió vuelven a ser los tuyos y la licencia que trajo se quita."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses verrous se lèvent, les réglages qu'il a choisis reviennent aux vôtres, et une licence qu'il a apportée est supprimée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zárak feloldódnak, a kiválasztott beállítások visszaállnak a tiédre, a hozott licencet pedig eltávolítják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi blocchi vengono rimossi, le impostazioni scelte tornano alle tue e la licenza che ha portato viene rimossa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのロックは解除され、選択された設定は元の設定に戻り、提供されたライセンスは削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금이 해제되고 선택한 설정이 사용자의 설정으로 돌아가며 가져온 라이센스가 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sloten gaan open, de gekozen instellingen gaan terug naar de jouwe en een meegebrachte licentie wordt verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus bloqueios são levantados, as configurações escolhidas voltam para as suas e uma licença que ele trouxe é removida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Её блокировки снимаются, выбранные ею настройки возвращаются к вашим, а принесённая ею лицензия удаляется."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے لاک ہٹ جاتے ہیں، اس کی منتخب کردہ ترتیبات آپ کی ترتیبات پر واپس آ جاتی ہیں، اور اس کے ساتھ آیا ہوا لائسنس ہٹا دیا جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的锁已解除，它选择的设置恢复为您的设置，并且它带来的许可已被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的鎖被解除，它選擇的設定返回到你的設定，並且它帶來的許可會被移除。"
          }
        }
      }
    },
    "Its manuals are indexed on this phone next; that can take a few minutes for a long one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم فهرسة أدلته على هذا الهاتف بعد ذلك؛ قد يستغرق ذلك بضع دقائق للأدلة الطويلة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enseguida sus manuales se indexan en este celular; puede tardar unos minutos si alguno es largo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses manuels sont indexés sur ce téléphone ensuite ; cela peut prendre quelques minutes pour un long manuel."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kézikönyvek ezen a telefonon indexelve lesznek ezután; ami hosszú ideig eltarthat néhány percig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi manuali sono elencati successivamente su questo telefono; ciò può richiedere alcuni minuti per un lungo periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのマニュアルは次にこの電話でインデックス化されます。長いマニュアルの場合、数分かかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설명서는 다음에 이 전화기에 색인되어 있습니다. 긴 작업의 경우 몇 분 정도 걸릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De handleidingen worden vervolgens op deze telefoon geïndexeerd; dat kan een paar minuten lang duren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus manuais estão indexados neste telefone a seguir; isso pode levar alguns minutos para um longo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далее его руководства индексируются на этом телефоне; для объёмного руководства это может занять несколько минут."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے بعد اس کے مینوئلز اس فون پر انڈیکس ہوتے ہیں؛ لمبے مینوئل کے لیے اس میں چند منٹ لگ سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的手册已在此手机上建立索引；对于较长的手册可能需要几分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的手冊接著會在這支手機上建索引；對較長的手冊可能需要幾分鐘時間。"
          }
        }
      }
    },
    "Its record could not be read back off the device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُمكن قراءة سجله مرة أخرى من الجهاز."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su registro no se pudo leer de vuelta desde el dispositivo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son enregistrement n'a pas pu être lu à partir de l'appareil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rekordot nem lehetett visszaolvasni a készülékről."
