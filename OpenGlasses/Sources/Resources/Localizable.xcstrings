            "value" : "С какой стороны должны проверять напоминания?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ یاد دہانیوں سے کون سی طرف چیک کروانا چاہیں گے؟"
