    "You are asked this once. Each recording after that starts with a short reminder." : {
      "comment" : "A description of the recording consent sheet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطلب منك هذا مرة واحدة. كل تسجيل بعد ذلك يبدأ بتذكير قصير."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto se te pregunta una sola vez. Después, cada grabación empieza con un recordatorio breve."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On vous demande ceci une seule fois. Chaque enregistrement suivant commence par un petit rappel."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt egyszer kérdezzük meg tőled. Minden további felvétel egy rövid emlékeztetővel kezdődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo ti viene chiesto una volta. Ogni registrazione successiva inizia con un breve promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは一度だけ尋ねられます。その後の各記録は短いリマインダーで始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이런 질문을 한 번 받습니다. 그 이후의 각 녹음은 짧은 알림으로 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier wordt je één keer naar gevraagd. Elke opname daarna begint met een korte herinnering."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é perguntado a você uma vez. Cada gravação depois disso começa com um pequeno lembrete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об этом вас спрашивают один раз. Каждая следующая запись начинается с короткого напоминания."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ آپ سے ایک بار پوچھا جاتا ہے۔ اس کے بعد ہر ریکارڈنگ ایک مختصر یاد دہانی سے شروع ہوتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这只会问你一次。之后的每次录音都会以简短提醒开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個問題只會問你一次。之後的每次錄音都會以短提醒開頭。"
          }
        }
      }
    },
    "You are on cellular data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت على بيانات الهاتف المحمول."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás usando datos celulares."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
