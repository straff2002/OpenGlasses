    "Cloud diarization is hard-disabled while HIPAA mode is on, so clinical audio never leaves the device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تعطيل خاصية التسجيل السحابي أثناء تشغيل وضع HIPAA، لذلك لا يغادر الصوت السريري الجهاز أبدًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diarización en la nube queda desactivada por completo mientras el modo HIPAA está activo, para que el audio clínico nunca salga del dispositivo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diarisation dans le cloud est complètement désactivée lorsque le mode HIPAA est activé, donc l'audio clinique ne quitte jamais l'appareil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felhőalapú naplózás keményen le van tiltva, ha a HIPAA mód be van kapcsolva, így a klinikai hang soha nem hagyja el az eszközt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diarizzazione sul cloud è disabilitata in modo permanente mentre la modalità HIPAA è attiva, quindi l'audio clinico non lascia mai il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HIPAAモードが有効な場合、クラウドダイアリゼーションは完全に無効化されるため、臨床音声はデバイスを離れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HIPAA 모드가 켜져 있는 동안에는 클라우드 분할이 하드 비활성화되므로 임상 오디오가 장치 외부로 나가지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clouddiarisatie is uitgeschakeld als de HIPAA-modus is ingeschakeld, zodat klinische audio het apparaat nooit verlaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A diarização da nuvem é desabilitada enquanto o modo HIPAA está ativado, para que o áudio clínico nunca saia do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облачная диаризация полностью отключена, пока включён режим HIPAA, поэтому клинический звук никогда не покидает устройство."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HIPAA موڈ آن ہونے کے دوران کلاؤڈ ڈائرائزیشن مکمل طور پر غیر فعال ہے، اس لیے کلینیکل آڈیو کبھی ڈیوائس سے باہر نہیں جاتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启 HIPAA 模式时云分 diarization 会被硬性禁用，因此临床音频不会离开设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 HIPAA 模式下，雲端日誌功能被強制禁用，因此臨床音頻永遠不會離開設備。"
          }
        }
      }
    },
    "Cloud Dictation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإملاء السحابي"
