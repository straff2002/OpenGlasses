        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기침, 박수, 휘파람 소리로 어시스턴트를 시작합니다. 사용 중에는 마이크를 계속 사용합니다."
          }
        },
        "nl" : {
