    "Per-server outbound data policy, tool trust badges, and recent egress decisions." : {
      "comment" : "A section of MCP Servers that shows the safety and trust of each server.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سياسة البيانات الصادرة لكل خادم، شارات ثقة الأدوات، وقرارات الخروج الأخيرة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Política de datos salientes por servidor, insignias de confianza de las herramientas y decisiones recientes de salida de datos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selon la politique de données sortantes par serveur, badges de confiance des outils et décisions récentes de sortie."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szerverenkénti kimenő adatokra vonatkozó szabályzat, az eszközök megbízhatósági jelvényei és a legutóbbi kilépési döntések."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Policy sui dati in uscita per server, badge di attendibilità degli strumenti e recenti decisioni in uscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーごとのアウトバウンドデータポリシー、ツールの信頼バッジ、および最近のエグレスの決定。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버별 아웃바운드 데이터 정책, 도구 신뢰 배지 및 최근 송신 결정."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgaand gegevensbeleid per server, tool-vertrouwensbadges en recente beslissingen over uitgaand verkeer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Política de dados de saída por servidor, emblemas de confiança de ferramentas e decisões recentes de saída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Политика исходящих данных для каждого сервера, значки доверия инструментов и последние решения по исходящему трафику."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر سرور کی بیرونی ڈیٹا پالیسی، ٹول اعتماد کے بیجز، اور اخراج کے حالیہ فیصلے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照服务器出站数据政策、工具信任徽章以及最近的出站决策。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每伺服器的外發數據政策、工具信任標章及最近的外發決策。"
          }
        }
      }
    },
    "Per-vault. Only session metadata (asset, date, outcome) is donated — never the audit log or captured values." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل خزانة. يتم التبرع فقط ببيانات الجلسة الوصفية (الأصل، التاريخ، النتيجة) — أبداً سجل التدقيق أو القيم الملتقطة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por bóveda. Solo se aportan los metadatos de la sesión (activo, fecha, resultado); nunca el registro de auditoría ni los valores capturados."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par coffre-fort. Seuls les métadonnées de session (ressource, date, résultat) sont partagées — jamais le journal d'audit ni les valeurs capturées."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltozatonként. Csak a munkamenet metaadatait (eszköz, dátum, eredmény) adományozzák – az auditnaplót vagy a rögzített értékeket nem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per caveau. Vengono donati solo i metadati della sessione (risorsa, data, risultato), mai il registro di controllo o i valori acquisiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボールトごと。寄贈されるのはセッションメタデータ（資産、日付、結果）のみであり、監査ログや取得された値は決して含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "볼트당. 세션 메타데이터(자산, 날짜, 결과)만 기부되며 감사 로그나 캡처된 값은 기부되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per kluis. Alleen metagegevens van de sessie (item, datum, resultaat) worden gedoneerd; nooit het auditlogboek of vastgelegde waarden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por cofre. Apenas os metadados da sessão (ativo, data, resultado) são doados – nunca o log de auditoria ou valores capturados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для каждого хранилища отдельно. Передаются только метаданные сеанса (объект, дата, результат) — никогда журнал аудита или захваченные значения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر والٹ کے لحاظ سے۔ صرف سیشن کا میٹا ڈیٹا (اثاثہ، تاریخ، نتیجہ) عطیہ کیا جاتا ہے — آڈٹ لاگ یا کیپچر کی گئی ویلیوز کبھی نہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按保险库。仅捐赠会话元数据（资产、日期、结果）——绝不捐赠审计日志或捕获的值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個金庫。僅會捐贈會話元資料（資產、日期、結果）——絕不捐贈稽核日誌或捕獲的數值。"
          }
        }
      }
    },
