    "The FHIR server didn't accept the credential. Check or replace it in Medical Export settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل خادم FHIR بيانات الاعتماد. تحقق منها أو استبدلها في إعدادات التصدير الطبي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor FHIR no aceptó la credencial. Revísala o reemplázala en la configuración de Exportación médica."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur FHIR n’a pas accepté l’identifiant. Vérifiez-le ou remplacez-le dans les réglages d’Exportation médicale."
