          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Оставьте пустым, и ничего не будет отправлено. Заполните, если вашей конечной точке нужно знать, что результат был зачитан — например, чтобы прекратить повторную отправку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختیاری۔ خالی چھوڑیں تو کبھی کچھ نہیں بھیجا جاتا۔ اگر آپ کا اینڈ پوائنٹ جاننا چاہتا ہے کہ نتیجہ پڑھ کر سنایا گیا — مثلاً اسے دوبارہ بھیجنا روکنے کے لیے — تو اسے سیٹ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。留空则不会发送任何内容。如果你的端点希望知道结果已被读取，例如停止重新发送，则设置它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可選。留空則不會傳送任何資訊。如果您的端點需要知道結果已被讀出，可以設定它——例如用來停止重新傳送。"
          }
        }
      }
    },
