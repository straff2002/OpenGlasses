    "Couldn't prepare the diagnostics file. Try again once the device is unlocked." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تجهيز ملف التشخيص. حاول مرة أخرى بعد فتح قفل الجهاز."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo preparar el archivo de diagnóstico. Intenta de nuevo cuando el dispositivo esté desbloqueado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de préparer le fichier de diagnostic. Réessayez une fois l’appareil déverrouillé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A diagnosztikai fájlt nem sikerült elkészíteni. Próbálja újra, ha az eszköz fel van oldva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile preparare il file di diagnostica. Riprova quando il dispositivo è sbloccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断ファイルを準備できませんでした。デバイスのロックを解除してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진단 파일을 준비할 수 없습니다. 기기 잠금을 해제한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon het diagnosebestand niet voorbereiden. Probeer het opnieuw zodra het apparaat is ontgrendeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível preparar o arquivo de diagnóstico. Tente de novo quando o dispositivo estiver desbloqueado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подготовить файл диагностики. Повторите попытку, когда устройство будет разблокировано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشخیصی فائل تیار نہیں ہو سکی۔ ڈیوائس ان لاک ہونے کے بعد دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法准备诊断文件。请在设备解锁后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法準備診斷檔案。請在裝置解鎖後重試。"
          }
        }
      }
    },
    "Couldn't reach ChatGPT — %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الوصول إلى ChatGPT — %@"
          }
        },
