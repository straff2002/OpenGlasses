    "Unavailable in production builds. Secure LAN pairing is not implemented yet; this cleartext server is limited to Debug development builds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير متاح في نسخ الإنتاج. مزامنة الشبكة المحلية الآمنة لم تُنفذ بعد؛ هذا الخادم النصي الصريح محدود لنسخ تطوير التصحيح."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No disponible en compilaciones de producción. El enlace seguro por LAN aún no está implementado; este servidor de texto sin cifrar se limita a compilaciones de desarrollo Debug."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indisponible dans les versions de production. L'appariement sécurisé LAN n'est pas encore implémenté ; ce serveur en texte clair est limité aux versions de développement Debug."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem elérhető a gyártási verziókban. A biztonságos LAN-párosítás még nincs megvalósítva; ez a tisztán szöveges szerver csak a Debug fejlesztői verziókban használható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponibile nelle build di produzione. L'accoppiamento LAN sicuro non è ancora implementato; questo server in chiaro è limitato alle build di sviluppo di debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "製品版では利用不可。安全なLANペアリングはまだ実装されていません; この平文サーバーはデバッグ開発ビルドに限定されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로덕션 빌드에서는 사용할 수 없습니다. 보안 LAN 페어링은 아직 구현되지 않았습니다. 이 일반 텍스트 서버는 디버그 개발 빌드로 제한됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet beschikbaar in productiebouw. Veilige LAN-koppeling is nog niet geïmplementeerd; deze heldere server is beperkt tot Debug-ontwikkelversies."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indisponível em compilações de produção. O emparelhamento seguro de LAN ainda não foi implementado; este servidor de texto não criptografado é limitado a compilações de desenvolvimento de depuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступно в производственных сборках. Защищённое сопряжение по локальной сети ещё не реализовано; этот нешифрованный сервер работает только в отладочных сборках для разработки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروڈکشن بلڈز میں دستیاب نہیں۔ محفوظ LAN پیئرنگ ابھی نافذ نہیں ہوئی؛ یہ غیر انکرپٹڈ سرور صرف Debug ڈیولپمنٹ بلڈز تک محدود ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生产版本中不可用。安全的局域网配对尚未实现；此明文服务器仅限调试开发版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生產版本中無法使用。安全的 LAN 配對尚未實現；此明文伺服器僅限於 Debug 開發版本。"
          }
        }
      }
    },
