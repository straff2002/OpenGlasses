    "It was deleted, or finished long enough ago to be removed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُذف، أو انتهى منذ وقت كافٍ بحيث أُزيل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó, o terminó hace tanto que ya se quitó."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a été supprimé, ou terminé il y a assez longtemps pour être retiré."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törölték, vagy már olyan régen befejeződött, hogy eltávolították."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato eliminato oppure è stato completato abbastanza tempo fa da essere rimosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除されたか、完了してから時間が経って削除されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제되었거나, 완료된 지 오래되어 제거되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is verwijderd, of lang genoeg geleden voltooid om te zijn opgeruimd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi excluída, ou concluída há tempo suficiente para ser removida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно было удалено или завершено так давно, что его убрали."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسے حذف کر دیا گیا، یا یہ اتنا عرصہ پہلے مکمل ہوا کہ ہٹا دیا گیا۔"
