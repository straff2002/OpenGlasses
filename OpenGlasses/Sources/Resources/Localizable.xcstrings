    "%lld of these %lld items had faces blurred before they were saved and the rest did not. Neither can be changed now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من بين هذه العناصر البالغ عددها %2$lld، جرى تمويه الوجوه في %1$lld منها قبل الحفظ ولم يجرِ ذلك في الباقي. لا يمكن تغيير أي من الحالتين الآن."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of these %2$lld items had faces blurred before they were saved and the rest did not. Neither can be changed now."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de estos %2$lld elementos tenían los rostros difuminados antes de guardarse y el resto no. Ahora no se puede cambiar ninguno."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de ces %2$lld éléments avaient les visages floutés avant leur enregistrement, mais pas les autres. Aucun des deux groupes ne peut être modifié maintenant."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %2$lld elemből %1$lld esetében a mentés előtt elmosták az arcokat, a többinél nem. Egyik sem módosítható már."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %1$lld di questi %2$lld elementi i volti erano sfocati prima del salvataggio, negli altri no. Ora nessuno dei due casi si può modificare."
          }
        },
        "ja" : {
          "stringUnit" : {
