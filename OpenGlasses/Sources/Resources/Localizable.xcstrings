          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com a sua conta da xAI (SuperGrok) — não precisa de chave de API — ou obtenha uma chave de API em console.x.ai. Uma chave definida aqui é usada no lugar do login."
          }
        },
        "ru" : {
          "stringUnit" : {
