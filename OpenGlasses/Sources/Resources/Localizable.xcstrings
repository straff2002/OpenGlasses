    "Pair with a one-time setup code instead of a shared token. The gateway issues a per-device token you can revoke independently." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بالإقران باستخدام رمز إعداد لمرة واحدة بدلاً من رمز مشترك. يصدر البوابة رمزًا لكل جهاز يمكنك إلغاؤه بشكل مستقل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlaza con un código de configuración de un solo uso en lugar de un token compartido. La puerta de enlace emite un token por dispositivo que puedes revocar de forma independiente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appairez avec un code de configuration à usage unique au lieu d'un jeton partagé. La passerelle émet un jeton par appareil que vous pouvez révoquer indépendamment."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párosítsa egyszeri beállítási kóddal a megosztott token helyett. Az átjáró egy eszközönkénti tokent bocsát ki, amelyet függetlenül visszavonhat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associa con un codice di configurazione monouso invece che con un token condiviso. Il gateway emette un token per dispositivo che puoi revocare in modo indipendente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有トークンの代わりに、ワンタイム設定コードでペアリングしてください。ゲートウェイはデバイスごとにトークンを発行し、個別に取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 토큰 대신 일회성 설정 코드와 페어링하세요. 게이트웨이는 독립적으로 취소할 수 있는 장치별 토큰을 발급합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel met een eenmalige installatiecode in plaats van een gedeeld token. De gateway geeft een token per apparaat uit dat u onafhankelijk kunt intrekken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emparelhe com um código de configuração único em vez de um token compartilhado. O gateway emite um token por dispositivo que você pode revogar de forma independente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопрягайтесь с помощью одноразового кода настройки вместо общего токена. Шлюз выдаёт отдельный токен для каждого устройства, который можно отозвать независимо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشترکہ ٹوکن کے بجائے ایک بار کے سیٹ اپ کوڈ سے جوڑیں۔ گیٹ وے ہر ڈیوائس کے لیے ایک ٹوکن جاری کرتا ہے جسے آپ الگ سے منسوخ کر سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用一次性设置代码进行配对，而不是共享令牌。网关会发放每个设备的令牌，你可以独立撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用一次性設定碼進行配對，而不是共享令牌。閘道會發出每個裝置的令牌，您可以獨立撤銷。"
          }
        }
      }
    },
    "Pair with a one-time setup code instead of a shared token. The gateway issues a per-device token you can revoke independently. A setup code fills in the gateway's address when none is saved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقترن برمز إعداد لمرة واحدة بدلًا من رمز مشترك. تصدر البوابة رمزًا لكل جهاز يمكنك إبطاله بشكل مستقل. يملأ رمز الإعداد عنوان البوابة إذا لم يكن هناك عنوان محفوظ."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlaza con un código de configuración de un solo uso en lugar de un token compartido. La puerta de enlace emite un token por dispositivo que puedes revocar de forma independiente. Un código de configuración rellena la dirección de la puerta de enlace cuando no hay ninguna guardada."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appairez avec un code de configuration à usage unique plutôt qu’avec un jeton partagé. La passerelle émet un jeton par appareil que vous pouvez révoquer indépendamment. Un code de configuration renseigne l’adresse de la passerelle lorsqu’aucune n’est enregistrée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párosítson egyszer használatos beállítási kóddal a közös token helyett. Az átjáró eszközönkénti tokent ad ki, amelyet külön-külön visszavonhat. A beállítási kód kitölti az átjáró címét, ha nincs mentett cím."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbina con un codice di configurazione monouso invece di un token condiviso. Il gateway emette un token per dispositivo che puoi revocare in modo indipendente. Un codice di configurazione compila l’indirizzo del gateway quando non ne è stato salvato nessuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有トークンの代わりに、1回限りのセットアップコードでペアリングします。ゲートウェイはデバイスごとのトークンを発行し、個別に無効化できます。ゲートウェイのアドレスが保存されていない場合、セットアップコードからアドレスが入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 토큰 대신 일회용 설정 코드로 페어링합니다. 게이트웨이가 기기별 토큰을 발급하며, 이 토큰은 개별적으로 폐기할 수 있습니다. 저장된 게이트웨이 주소가 없으면 설정 코드로 주소가 채워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel met een eenmalige installatiecode in plaats van een gedeeld token. De gateway geeft een token per apparaat uit dat u los kunt intrekken. Een installatiecode vult het adres van de gateway in als er geen is opgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emparelhe com um código de configuração de uso único em vez de um token compartilhado. O gateway emite um token por dispositivo que você pode revogar de forma independente. Um código de configuração preenche o endereço do gateway quando nenhum está salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните сопряжение с одноразовым кодом настройки вместо общего токена. Шлюз выдаёт токен для каждого устройства, который можно отозвать отдельно. Код настройки подставляет адрес шлюза, если он не сохранён."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشترکہ ٹوکن کے بجائے ایک بار کے سیٹ اپ کوڈ سے جوڑیں۔ گیٹ وے ہر ڈیوائس کے لیے ایک ٹوکن جاری کرتا ہے جسے آپ الگ سے منسوخ کر سکتے ہیں۔ جب کوئی پتہ محفوظ نہ ہو تو سیٹ اپ کوڈ گیٹ وے کا پتہ بھر دیتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用一次性设置码配对，而不是共享令牌。网关会为每台设备签发一个令牌，你可以单独撤销。当没有保存地址时，设置码会自动填入网关的地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用一次性設定碼配對，而不是共用權杖。閘道會為每台裝置核發一個權杖，你可以個別撤銷。當沒有儲存位址時，設定碼會自動填入閘道的位址。"
          }
        }
      }
    },
