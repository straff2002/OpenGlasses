    "Includes company, technician name and ID, licence details and enrolment when configured." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل الشركة واسم الفني ومعرّفه وتفاصيل الترخيص والتسجيل عند الإعداد."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye empresa, nombre e ID del técnico, detalles de la licencia e inscripción, cuando están configurados."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprend l’entreprise, le nom et l’ID du technicien, les détails de la licence et l’inscription, lorsqu’ils sont configurés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartalmazza a céget, a technikus nevét és azonosítóját, a licencadatokat és a regisztrációt, ha be van állítva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include azienda, nome e ID del tecnico, dettagli della licenza e registrazione, se configurati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定されている場合、会社、技術者の氏名とID、ライセンスの詳細、登録情報が含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정되어 있는 경우 회사, 기술자 이름과 ID, 라이선스 세부 정보, 등록 정보가 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevat bedrijf, naam en ID van de technicus, licentiegegevens en inschrijving wanneer geconfigureerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui empresa, nome e ID do técnico, detalhes da licença e inscrição, quando configurados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает компанию, имя и ID техника, данные лицензии и регистрацию, если они настроены."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب دیے جانے پر کمپنی، ٹیکنیشن کا نام اور ID، لائسنس کی تفصیلات اور اندراج شامل ہوتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包括公司、技术人员姓名和编号、授权详情，以及已配置时的注册信息。"
          }
        },
        "zh-Hant" : {
