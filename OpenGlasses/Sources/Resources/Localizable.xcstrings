    "This phone has left %@. Its job records from that time go to %@ when this phone can reach it, and are erased by %@ either way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الهاتف غادر %1$@. سجلات مهامه من ذلك الوقت تنتقل إلى %2$@ عندما يتمكن هذا الهاتف من الوصول إليها، ويتم مسحها بواسطة %3$@ على أي حال."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This phone has left %1$@. Its job records from that time go to %2$@ when this phone can reach it, and are erased by %3$@ either way."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este celular salió de %1$@. Sus registros de trabajo de ese periodo van a %2$@ cuando este celular pueda alcanzarlo, y de cualquier forma se borran a más tardar el %3$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone a quitté %1$@. Ses enregistrements d'activité de cette période seront envoyés à %2$@ lorsque ce téléphone pourra y accéder, et sont effacés par %3$@ de toute façon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a telefon elhagyta a %1$@-t. Ennek időszakára vonatkozó munkaadatai a %2$@-hez kerülnek, amikor a telefon eléri, és mindkettőt a %3$@ törli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo telefono ha lasciato %1$@. I registri dei lavori da quel momento vanno a %2$@ quando questo telefono può raggiungerlo e vengono cancellati da %3$@ in ogni caso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この電話は%1$@を離れました。その時点からの業務記録は、この電話が到達できると%2$@に送られ、いずれにしても%3$@によって消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 전화기는 %1$@를 떠났습니다. 해당 시간의 작업 기록은 이 전화기에 연결할 수 있을 때 %2$@로 이동하며 어느 쪽이든 %3$@에 의해 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze telefoon heeft %1$@ verlaten. Zijn functieregistraties vanaf dat moment gaan naar %2$@ wanneer deze telefoon er verbinding mee kan maken, en worden in ieder geval gewist door %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este telefone saiu de %1$@. Seus registros de trabalho daquele momento vão para %2$@ quando este telefone pode alcançá-lo e são apagados por %3$@ de qualquer maneira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот телефон покинул %1$@. Записи о заданиях за это время отправляются в %2$@, когда телефон сможет с ним связаться, и в любом случае будут удалены не позднее %3$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ فون %1$@ چھوڑ چکا ہے۔ اس دوران کے اس کے جاب ریکارڈز %2$@ کو جائیں گے جب یہ فون اس تک پہنچ سکے، اور ہر صورت میں %3$@ تک مٹا دیے جائیں گے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这部手机已经离开%1$@。它从那时起的工作记录在这部手机能够到达%2$@时会发送过去，并且无论如何都会被%3$@删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這支手機已經離開 %1$@。當這支手機可以連接時，其當時的工作紀錄將傳送到 %2$@，並且無論如何都會被 %3$@ 刪除。"
          }
        }
      }
    },
    "This phone has no Mail account set up, so the file opened in the share sheet. Send it to %@." : {
