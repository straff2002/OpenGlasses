        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的步驟和跟進也會一併刪除。此操作無法還原。"
          }
        }
      }
    },
    "Its template couldn't render a basic exchange." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على قالبه عرض تبادل أساسي."
