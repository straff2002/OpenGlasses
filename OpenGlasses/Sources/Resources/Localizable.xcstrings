          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 模型的金鑰不屬於個人檔案的一部分。您接下來在這支手機上輸入，它會留在這裡。"
          }
        }
      }
    },
    "The AI receives this message. Tap {{ }} to insert a variable from a previous step." : {
