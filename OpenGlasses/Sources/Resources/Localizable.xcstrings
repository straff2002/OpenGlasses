    "Some checks of this table match no row or column in it now. They are kept and not applied." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض فحوصات هذا الجدول لا تطابق الآن أي صف أو عمود فيه. تُحفظ ولا تُطبَّق."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas verificaciones de esta tabla ya no coinciden con ninguna fila ni columna. Se conservan y no se aplican."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines vérifications de ce tableau ne correspondent plus à aucune ligne ni colonne. Elles sont conservées, mais non appliquées."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek a táblázatnak néhány ellenőrzése már nem egyezik egyetlen sorával vagy oszlopával sem. Megmaradnak, de nem érvényesülnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni controlli di questa tabella ora non corrispondono a nessuna riga o colonna. Vengono conservati ma non applicati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この表の現在の行や列に一致しない確認内容があります。それらは保持されますが、適用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 표의 현재 행이나 열과 일치하지 않는 확인 내용이 있습니다. 이 내용은 보관되지만 적용되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige controles van deze tabel komen nu met geen enkele rij of kolom overeen. Ze blijven bewaard en worden niet toegepast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas verificações desta tabela não correspondem mais a nenhuma linha ou coluna. Elas são mantidas e não aplicadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые проверки этой таблицы теперь не соответствуют ни одной строке или столбцу. Они сохранены и не применяются."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس جدول کی کچھ جانچیں اب اس کی کسی قطار یا کالم سے میل نہیں کھاتیں۔ انہیں محفوظ رکھا گیا ہے اور لاگو نہیں کیا گیا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此表格中的某些核对结果现在与其中任何行或列都不匹配。它们会被保留，但不会应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此表格中的某些核對結果現在與其中任何列或欄都不相符。它們會被保留，但不會套用。"
          }
        }
      }
    },
    "Some features of this skill can run on-device with native tools. Full functionality requires OpenClaw." : {
      "comment" : "A description of a skill that can be partially run on-device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض ميزات هذه المهارة يمكن أن تعمل على الجهاز باستخدام أدوات أصلية. الوظائف الكاملة تتطلب OpenClaw."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas funciones de esta habilidad pueden ejecutarse en el dispositivo con herramientas nativas. La funcionalidad completa requiere OpenClaw."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines fonctionnalités de cette compétence peuvent s'exécuter sur l'appareil avec des outils natifs. La fonctionnalité complète nécessite OpenClaw."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek a készségnek egyes funkciói futhatnak az eszközön natív eszközökkel. A teljes funkcionalitáshoz OpenClaw szükséges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune funzionalità di questa competenza possono essere eseguite sul dispositivo con strumenti nativi. La piena funzionalità richiede OpenClaw."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスキルの一部の機能は、ネイティブツールでデバイス上で実行できます。完全な機能にはOpenClawが必要です。"
