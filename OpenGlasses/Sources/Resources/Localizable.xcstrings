          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «+», чтобы просмотреть и установить режимы ИИ, или добавьте свои персоны в настройках."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI موڈز براؤز اور انسٹال کرنے کے لیے + پر ٹیپ کریں، یا ترتیبات میں حسبِ ضرورت پرسونا شامل کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
