      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что было сделано"
          }
        }
      }
    },
    "What was reported, in their words" : {
      "comment" : "A label for the text field where the user can enter the customer's report of the job.",
