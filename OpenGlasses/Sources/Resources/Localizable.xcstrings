        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف کرنے کے لیے سوائپ کریں۔ ایکسپورٹ ایک JSON لائبریری لکھتا ہے جسے آپ AirDrop کر سکتے ہیں یا Files میں محفوظ کر سکتے ہیں؛ امپورٹ ٹرگر جملے کے لحاظ سے ضم کرتا ہے۔"
