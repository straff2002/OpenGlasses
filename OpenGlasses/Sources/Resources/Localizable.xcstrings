    },
    "Capture & Streaming" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захват и трансляция"
          }
        }
      }
    },
    "Capture flows, procedures, playbooks, and custom tools you've authored. Off by default — turn one on to run it by voice." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захватывайте процессы, процедуры, плейбуки и свои инструменты. По умолчанию отключено — включите, чтобы запускать голосом."
          }
        }
      }
    },
    "Capture from camera" : {
      "comment" : "A section header for the teleprompter capture functionality.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захват с камеры"
          }
