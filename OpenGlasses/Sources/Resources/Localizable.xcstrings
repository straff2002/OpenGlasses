    "All providers use the same WebSocket protocol. You can add multiple gateways for failover." : {
      "comment" : "A description of the WebSocket protocol.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم جميع مقدمي الخدمة نفس بروتوكول WebSocket. يمكنك إضافة بوابات متعددة لتجاوز الفشل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los proveedores usan el mismo protocolo WebSocket. Puedes agregar varias puertas de enlace como respaldo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les fournisseurs utilisent le même protocole WebSocket. Vous pouvez ajouter plusieurs passerelles pour la redondance."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden szolgáltató ugyanazt a WebSocket protokollt használja. Több átjárót is hozzáadhat a feladatátvételhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i provider utilizzano lo stesso protocollo WebSocket. È possibile aggiungere più gateway per il failover."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのプロバイダーは同じWebSocketプロトコルを使用します。フェイルオーバーのために複数のゲートウェイを追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 공급자는 동일한 WebSocket 프로토콜을 사용합니다. 장애 조치를 위해 여러 게이트웨이를 추가할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
