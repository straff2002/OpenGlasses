        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előfizetés automatikusan megújul. Bármikor lemondható az iPhone Beállítások → [az Ön neve] → Előfizetések menüpontban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abbonamento si rinnova automaticamente. Annulla in qualsiasi momento in Impostazioni di iPhone → [il tuo nome] → Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは自動的に更新されます。iPhoneの設定 → [自分の名前] → サブスクリプションでいつでもキャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 자동으로 갱신됩니다. iPhone 설정 → [사용자 이름] → 구독에서 언제든지 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnement wordt automatisch verlengd. Annuleer op elk moment in iPhone-instellingen → [je naam] → Abonnementen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura é renovada automaticamente. Cancele a qualquer momento em Ajustes do iPhone → [seu nome] → Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка продлевается автоматически. Отменить можно в любой момент в Настройки iPhone → [ваше имя] → Подписки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبسکرپشن خود بخود تجدید ہوتی ہے۔ کسی بھی وقت iPhone کی ترتیبات → [آپ کا نام] → سبسکرپشنز میں منسوخ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅会自动续订。可随时在 iPhone 设置 → [你的姓名] → 订阅中取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱會自動續訂。隨時可在 iPhone 設定 → [你的姓名] → 訂閱中取消。"
          }
        }
      }
    },
