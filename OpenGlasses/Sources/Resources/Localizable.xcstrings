    "All AI queries are processed on-device. No clinical data is sent to cloud providers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم معالجة جميع استعلامات الذكاء الاصطناعي على الجهاز. لا يتم إرسال أي بيانات سريرية إلى موفري الخدمات السحابية."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las consultas a la IA se procesan en el dispositivo. No se envían datos clínicos a proveedores en la nube."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les requêtes IA sont traitées sur l'appareil. Aucune donnée clinique n'est envoyée aux fournisseurs de cloud."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden AI-lekérdezést az eszközön dolgoz fel. Nem küldenek klinikai adatokat a felhőszolgáltatóknak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le query AI vengono elaborate sul dispositivo. Nessun dato clinico viene inviato ai fornitori di servizi cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのAIクエリは端末内で処理されます。臨床データはクラウドプロバイダーに送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 AI 쿼리는 기기 내에서 처리됩니다. 임상 데이터는 클라우드 공급자에게 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle AI-query's worden op het apparaat verwerkt. Er worden geen klinische gegevens naar cloudproviders verzonden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as consultas de IA são processadas no dispositivo. Nenhum dado clínico é enviado aos provedores de nuvem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все запросы к ИИ обрабатываются на устройстве. Клинические данные не отправляются облачным провайдерам."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام AI سوالات آلے پر ہی پروسیس ہوتے ہیں۔ کوئی طبی ڈیٹا کلاؤڈ فراہم کنندگان کو نہیں بھیجا جاتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人工智能查询均在设备上处理。没有临床数据发送到云服务提供商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人工智慧查詢皆在裝置上處理。無臨床資料會傳送至雲端提供者。"
          }
        }
      }
    },
