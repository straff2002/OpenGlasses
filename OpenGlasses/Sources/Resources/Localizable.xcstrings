    "The AI's private chain-of-thought from its most recent response. This is never spoken aloud." : {
      "comment" : "A description of the last reasoning.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سلسلة الأفكار الخاصة بالذكاء الاصطناعي من استجابته الأخيرة. هذا لا يُقال أبدًا بصوت عالٍ."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cadena de razonamiento privada de la IA en su respuesta más reciente. Nunca se dice en voz alta."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaîne de pensée privée de l'IA de sa réponse la plus récente. Cela n'est jamais exprimé à voix haute."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
