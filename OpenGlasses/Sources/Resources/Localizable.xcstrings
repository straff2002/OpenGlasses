    "In EU and EEA App Store regions, face recognition will stop being available on 2 December 2027." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في مناطق متجر التطبيقات في الاتحاد الأوروبي والمنطقة الاقتصادية الأوروبية، سيتوقف التعرف على الوجه عن العمل في 2 ديسمبر 2027."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En las regiones de App Store de la UE y el EEE, el reconocimiento facial dejará de estar disponible el 2 de diciembre de 2027."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les régions de l'App Store de l'UE et de l'EEE, la reconnaissance faciale ne sera plus disponible à partir du 2 décembre 2027."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az EU és az EGT App Store régióiban az arcfelismerés 2027. december 2-án megszűnik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle regioni dell'App Store UE e SEE, il riconoscimento facciale non sarà più disponibile il 2 dicembre 2027."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EUおよびEEAのApp Store地域では、顔認識機能は2027年12月2日に利用できなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EU 및 EEA App Store 지역에서는 2027년 12월 2일부터 얼굴 인식 기능이 중단됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de App Store-regio's van de EU en de EER is gezichtsherkenning vanaf 2 december 2027 niet meer beschikbaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nas regiões da App Store da UE e do EEE, o reconhecimento facial deixará de estar disponível em 2 de dezembro de 2027."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В регионах App Store в ЕС и ЕЭЗ распознавание лиц перестанет быть доступным 2 декабря 2027 года."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EU اور EEA کے App Store علاقوں میں، چہرے کی شناخت 2 دسمبر 2027 سے دستیاب نہیں رہے گی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在欧盟和欧洲经济区的 App Store 区域，面部识别功能将于 2027 年 12 月 2 日停止使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在歐盟和歐洲經濟區 App Store 區域，臉部識別將於 2027 年 12 月 2 日停止提供。"
          }
        }
      }
    },
    "In Live mode your voice, and the camera when you share it, stream to %@, on this key's quota." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الوضع المباشر يُبث صوتك، والكاميرا عند مشاركتها، إلى %@، ضمن حصة هذا المفتاح."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En modo en vivo, tu voz, y la cámara cuando la compartes, se transmiten a %@, con la cuota de esta clave."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode direct, votre voix, ainsi que la caméra lorsque vous la partagez, sont diffusées en continu vers %@, selon le quota de cette clé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élő módban a hangja, és a kamera, ha megosztja, a(z) %@ felé streamelődik, ennek a kulcsnak a kvótájára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In modalità dal vivo la tua voce, e la fotocamera quando la condividi, vengono trasmesse a %@, con la quota di questa chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブモードでは、あなたの音声と（共有した場合は）カメラ映像が、このキーのクォータで%@にストリーミングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브 모드에서는 사용자의 음성과 공유한 카메라 영상이 이 키의 할당량으로 %@(으)로 스트리밍됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Live-modus worden je stem, en de camera als je die deelt, gestreamd naar %@, op de quota van deze sleutel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No modo ao vivo, sua voz, e a câmera quando você a compartilha, são transmitidas para %@, na cota desta chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме Live ваш голос и камера (когда вы ею делитесь) передаются в %@ в рамках квоты этого ключа."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لائیو موڈ میں آپ کی آواز، اور کیمرا جب آپ اسے شیئر کریں، %@ کو اسٹریم ہوتے ہیں، اس کلید کے کوٹے پر۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Live 模式下，你的语音以及你共享的相机画面会使用此密钥的额度流式传输到 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Live 模式下，你的語音以及你分享的相機畫面會使用此金鑰的額度串流傳送至 %@。"
          }
        }
      }
    },
