    "The FHIR server turned the document down. Check the server settings, or share the transcript instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض خادم FHIR المستند. تحقق من إعدادات الخادم، أو شارك النص المفرَّغ بدلًا من ذلك."
