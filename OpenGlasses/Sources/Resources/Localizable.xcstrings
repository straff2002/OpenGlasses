    "Authenticated session ready. Test microphone audio, replies and tools in a live conversation next." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التحقق من الهوية والجلسة جاهزة. اختبر الآن صوت الميكروفون والردود والأدوات في محادثة مباشرة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión está autenticada y lista. Ahora prueba el audio del micrófono, las respuestas y las herramientas en una conversación en vivo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session est authentifiée et prête. Testez ensuite l’audio du microphone, les réponses et les outils dans une conversation en direct."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hitelesített munkamenet készen áll. Ezután élő beszélgetésben tesztelje a mikrofon hangját, a válaszokat és az eszközöket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione è autenticata e pronta. Ora prova l’audio del microfono, le risposte e gli strumenti in una conversazione dal vivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証済みセッションの準備ができました。次にライブ会話でマイク音声、応答、ツールをテストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증된 세션이 준비되었습니다. 다음으로 실시간 대화에서 마이크 오디오, 응답, 도구를 테스트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sessie is geauthenticeerd en klaar. Test nu microfoonaudio, antwoorden en tools in een livegesprek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão está autenticada e pronta. Agora teste o áudio do microfone, as respostas e as ferramentas em uma conversa ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс прошёл аутентификацию и готов. Затем проверьте звук микрофона, ответы и инструменты в живом разговоре."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصدیق شدہ سیشن تیار ہے۔ اب لائیو گفتگو میں مائیکروفون آڈیو، جوابات اور ٹولز آزمائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已通过身份验证，会话已就绪。接下来请在实时对话中测试麦克风音频、回复和工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已通過驗證，工作階段已就緒。接下來請在即時對話中測試麥克風音訊、回覆和工具。"
          }
        }
      }
    },
