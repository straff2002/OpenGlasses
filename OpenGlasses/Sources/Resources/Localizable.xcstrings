    "Quiet while live captions are running — still watching, so questions are still answered." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هادئ أثناء تشغيل التعليقات المباشرة — لا يزال يراقب، لذا تُجاب الأسئلة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Callado mientras se ejecutan los subtítulos en vivo; sigue observando, así que las preguntas se siguen respondiendo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silencieux pendant les sous-titres en direct — l’observation continue, donc les questions reçoivent toujours une réponse."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csendben marad, amíg az élő feliratok futnak — továbbra is figyel, így a kérdésekre még válaszol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silenzioso mentre i sottotitoli live sono in corso: continua a osservare, quindi le domande ricevono comunque risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ字幕の実行中は静かにします。見守りは続けているので、質問には答えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 자막이 실행되는 동안에는 조용히 합니다. 계속 지켜보고 있으므로 질문에는 답합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stil terwijl live ondertitels draaien — kijkt nog steeds mee, dus vragen worden nog steeds beantwoord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em silêncio enquanto as legendas ao vivo estão ativas — continua observando, então as perguntas ainda são respondidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихо, пока идут живые субтитры, — всё равно слежу, поэтому на вопросы отвечаю."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لائیو کیپشنز چلنے کے دوران خاموش — اب بھی دیکھ رہا ہے، اس لیے سوالات کے جواب اب بھی دیے جاتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时字幕运行期间保持安静 — 仍在观察，因此依然会回答问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時字幕執行期間保持安靜 — 仍在觀察，因此仍會回答問題。"
          }
        }
      }
    },
