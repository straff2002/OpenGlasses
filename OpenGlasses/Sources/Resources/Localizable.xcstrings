        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此辦公室核准已被取代。請匯入其最新的已簽署綁定。"
          }
        }
      }
    },
    "This organisation's management period is not active. Ask for a renewed setup file." : {
      "localizations" : {
        "ar" : {
