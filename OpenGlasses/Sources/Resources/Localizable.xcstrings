    "No auto-advance — drive it with \"next\"/\"back\" by voice or the Neural Band." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تقدّم تلقائي — تحكّم فيه بقول «next»/«back» بالصوت أو عبر Neural Band."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin avance automático: contrólalo diciendo “next”/“back” (en inglés) o con el Neural Band."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’avance automatique — pilotez-la avec « next » / « back » (en anglais) par la voix ou le Neural Band."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs automatikus továbblépés — vezérelje az angol „next”/„back” hangparanccsal vagy a Neural Banddel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun avanzamento automatico: usalo con «next»/«back» (in inglese) a voce o con la Neural Band."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動では進みません。音声または Neural Band で「next」「back」（英語）で操作してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 넘김 없음 — 음성으로 영어로 \"next\"/\"back\"이라고 말하거나 Neural Band로 조작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet automatisch verder — bedien het met “next”/“back” (in het Engels) via spraak of de Neural Band."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem avanço automático — controle com \"next\"/\"back\" (em inglês) por voz ou pela Neural Band."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без автопереключения — управляйте голосом командами «next»/«back» (по-английски) или с помощью Neural Band."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خودکار پیش قدمی نہیں — اسے آواز سے انگریزی میں “next”/“back” کہہ کر یا Neural Band سے چلائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不自动翻页 — 通过语音说英语“next”/“back”，或使用 Neural Band 来操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會自動前進 — 請用語音說英語「next」／「back」，或使用 Neural Band 操作。"
          }
        }
      }
    },
