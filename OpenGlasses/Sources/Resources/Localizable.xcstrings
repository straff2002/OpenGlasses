    "Administrator session. It ends when you leave the app, or after ten minutes without activity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلسة المسؤول. وينتهي عند مغادرة التطبيق، أو بعد عشر دقائق من عدم النشاط."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión de administrador. Termina cuando sales de la app o después de diez minutos sin actividad."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session administrateur. Elle se termine lorsque vous quittez l'application, ou après dix minutes d'inactivité."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adminisztrátori munkamenet. Akkor ér véget, amikor elhagyja az alkalmazást, vagy tíz percnyi tevékenység nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessione dell'amministratore. Termina quando esci dall'app o dopo dieci minuti senza attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者セッション。このセッションはアプリを離れると終了するか、10分間操作がないと終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자 세션. 앱을 종료하거나 10분 동안 활동이 없으면 종료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheerderssessie. Het eindigt wanneer u de app verlaat, of na tien minuten zonder activiteit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessão do administrador. Termina quando você sai do aplicativo ou após dez minutos sem atividade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс администратора. Он завершается, когда вы выходите из приложения, или через десять минут бездействия."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایڈمنسٹریٹر سیشن۔ یہ ایپ چھوڑنے پر، یا دس منٹ تک کوئی سرگرمی نہ ہونے پر ختم ہو جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理员会话。离开应用程序或十分钟没有活动后，会话将结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理員會話。當您離開應用程式或十分鐘無操作後，會話將結束。"
          }
        }
      }
    },
