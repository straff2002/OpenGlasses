    "Export soul, skills, memory, conversations, and quick actions as a portable zip bundle. Compatible with OpenClaw/nanoclaw agent format." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصدير الروح والمهارات والذاكرة والمحادثات والإجراءات السريعة كحزمة مضغوطة قابلة للنقل. متوافق مع تنسيق وكيل OpenClaw / nanoclaw."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta el alma, las habilidades, la memoria, las conversaciones y las acciones rápidas como un paquete zip portátil. Compatible con el formato de agente de OpenClaw/nanoclaw."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter l'âme, les compétences, la mémoire, les conversations et les actions rapides en tant que bundle zip portable. Compatible avec le format d'agent OpenClaw/nanoclaw."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportálhatja a lelket, a készségeket, a memóriát, a beszélgetéseket és a gyors műveleteket hordozható zip-csomagként. Kompatibilis az OpenClaw/nanoclaw ügynök formátummal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta anima, abilità, memoria, conversazioni e azioni rapide come un pacchetto zip portatile. Compatibile con il formato agente OpenClaw/nanoclaw."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魂、スキル、記憶、会話、およびクイックアクションをポータブルZIPバンドルとしてエクスポート。OpenClaw/nanoclawエージェントフォーマット互換。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영혼, 기술, 기억, 대화, 빠른 동작을 휴대용 zip 번들로 내보냅니다. OpenClaw/nanoclaw 에이전트 형식과 호환됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer ziel, vaardigheden, geheugen, gesprekken en snelle acties als een draagbare zip-bundel. Compatibel met OpenClaw/nanoclaw-agentformaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte alma, habilidades, memória, conversas e ações rápidas como um pacote zip portátil. Compatível com o formato de agente OpenClaw/nanoclaw."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортирует личность, навыки, память, разговоры и быстрые действия в переносимый zip-пакет. Совместим с форматом агентов OpenClaw/nanoclaw."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روح، مہارتیں، میموری، گفتگوئیں اور فوری ایکشنز کو ایک قابلِ منتقلی zip بنڈل کے طور پر ایکسپورٹ کریں۔ OpenClaw/nanoclaw ایجنٹ فارمیٹ کے ساتھ مطابقت رکھتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将灵魂、技能、记忆、对话和快速操作导出为可携带的 zip 包。兼容 OpenClaw/nanoclaw 代理格式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將靈魂、技能、記憶、對話和快速操作匯出為可攜式 zip 包。與 OpenClaw/nanoclaw 代理格式兼容。"
          }
        }
      }
    },
