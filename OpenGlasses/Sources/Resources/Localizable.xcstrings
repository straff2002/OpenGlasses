    "Conversations are locked. Unlock them with Face ID to export what was said." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحادثات مقفلة. افتحها بـ Face ID لتصدير ما قيل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conversaciones están bloqueadas. Desbloquéalas con Face ID para exportar lo que se dijo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversations sont verrouillées. Déverrouillez-les avec Face ID pour exporter ce qui a été dit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beszélgetések zárolva vannak. Oldja fel őket Face ID-val, hogy exportálhassa az elhangzottakat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conversazioni sono bloccate. Sbloccale con Face ID per esportare quanto è stato detto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話はロックされています。話した内容を書き出すには、Face IDでロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 잠겨 있습니다. Face ID로 잠금을 해제하면 말한 내용을 내보낼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprekken zijn vergrendeld. Ontgrendel ze met Face ID om te exporteren wat er is gezegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas estão bloqueadas. Desbloqueie com o Face ID para exportar o que foi dito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разговоры заблокированы. Разблокируйте их с помощью Face ID, чтобы экспортировать сказанное."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گفتگوئیں مقفل ہیں۔ جو کچھ کہا گیا اسے ایکسپورٹ کرنے کے لیے Face ID سے ان لاک کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话已锁定。请使用 Face ID 解锁以导出所说的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對話已鎖定。請以 Face ID 解鎖，才能匯出對話內容。"
          }
        }
      }
    },
    "Conversations are locked. Unlock them with Face ID to send one." : {
      "localizations" : {
        "ar" : {
