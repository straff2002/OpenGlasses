    "If nobody approves it by %@, ask the office for a new code." : {
      "comment" : "Text displayed in a notice at the bottom of the screen when the office hasn't approved the phone. The argument is the expiry date.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم يوافق أحد عليه بواسطة %1$@، اطلب من المكتب رمزًا جديدًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si nadie lo aprueba antes de %@, pídele a la oficina un código nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si personne ne l'approuve par %1$@, demandez un nouveau code au bureau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha senki sem hagyja jóvá %1$@-ig, kérjen új kódot az irodától."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se nessuno lo approva tramite %1$@, chiedere all'ufficio un nuovo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もし%1$@によって誰も承認しない場合は、オフィスに新しいコードを依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@까지 아무도 승인하지 않으면 사무실에 새 코드를 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als niemand het door %1$@ goedkeurt, vraag dan bij het kantoor om een nieuwe code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ninguém aprovar por %1$@, peça um novo código ao escritório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если до %@ никто его не одобрит, попросите у офиса новый код."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر %@ تک کوئی اسے منظور نہ کرے تو آفس سے نیا کوڈ مانگیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有人通过 %1$@ 批准它，请向办公室申请新代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果沒有任何人通過 %1$@ 批准，請向辦公室詢問新的代碼。"
          }
        }
      }
    },
    "If true →" : {
      "localizations" : {
