    "Camera triage isn't available in Field Assist editions; first-aid coaching still is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتوفر فرز الكاميرا في إصدارات Field Assist؛ لا يزال التدريب على الإسعافات الأولية قائمًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El triaje con la cámara no está disponible en las ediciones de Field Assist; la guía de primeros auxilios sigue disponible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le triage par caméra n'est pas disponible dans les éditions Field Assist ; le coaching de premiers soins l'est toujours."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fényképezőgép besorolása nem érhető el a Field Assist kiadásokban; az elsősegélynyújtás továbbra is az."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valutazione della fotocamera non è disponibile nelle edizioni Field Assist; il coaching di primo soccorso lo è ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assistエディションではカメラトリアージは使用できませんが、応急処置コーチングは引き続き利用可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assist 버전에서는 카메라 분류를 사용할 수 없습니다. 응급처치 코칭은 아직입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cameratriage is niet beschikbaar in de Field Assist-edities; EHBO-coaching is dat nog steeds."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A triagem de câmeras não está disponível nas edições Field Assist; o treinamento em primeiros socorros ainda é."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сортировка по камере недоступна в редакциях Field Assist; подсказки по первой помощи по-прежнему доступны."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیمرا ٹرائیج Field Assist ایڈیشنز میں دستیاب نہیں ہے؛ ابتدائی طبی امداد کی رہنمائی اب بھی دستیاب ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assist 版本中不提供摄像头分诊；急救指导仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assist 版本中無法使用攝像頭分流；急救教練功能仍可使用。"
          }
        }
      }
    },
