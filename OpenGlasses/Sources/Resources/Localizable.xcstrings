    "This office approval was replaced. Import its newest signed binding." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استُبدلت موافقة المكتب هذه. استورد أحدث ربط موقّع لها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aprobación de la oficina fue reemplazada. Importa su vínculo firmado más reciente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette approbation du bureau a été remplacée. Importez sa plus récente liaison signée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az irodai jóváhagyás le lett cserélve. Importálja a legújabb aláírt kötését."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa approvazione dell'ufficio è stata sostituita. Importa il suo ultimo collegamento firmato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このオフィスの承認は置き換えられました。最新の署名済みバインディングを読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사무실 승인이 교체되었습니다. 가장 최근에 서명된 바인딩을 가져오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kantoorgoedkeuring is vervangen. Importeer de nieuwste ondertekende koppeling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aprovação do escritório foi substituída. Importe a vinculação assinada mais recente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это одобрение офиса заменено. Импортируйте его новейшую подписанную привязку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ آفس کی منظوری بدل دی گئی تھی۔ اس کی تازہ ترین دستخط شدہ بائنڈنگ امپورٹ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此办公室批准已被替换。请导入其最新的已签署绑定。"
