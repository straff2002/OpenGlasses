    },
    "The manual is already unavailable to answers. Keep the app open until this finishes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدليل غير متاح بالفعل للإجابات. احتفظ بالتطبيق مفتوحًا حتى ينتهي هذا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El manual ya no está disponible para las respuestas. Mantén la app abierta hasta que esto termine."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le manuel n'est déjà plus disponible pour répondre. Gardez l'application ouverte jusqu'à ce que cela se termine."
