          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ biedt het gebruikte stemmodel niet meer aan, dus antwoorden gebruiken de ingebouwde stem. Wijzig stemmen in Instellingen › Verbindingen › Diensten en integraties."
          }
        },
        "pt-BR" : {
