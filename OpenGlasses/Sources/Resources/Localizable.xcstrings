      }
    },
    "Enables safeguards for handling protected health information during clinical recordings, consultations, and interactions." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает меры защиты для работы с охраняемой медицинской информацией во время клинических записей, консультаций и взаимодействий."
          }
        }
      }
    },
    "Encrypt Conversations" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шифровать разговоры"
          }
        }
      }
    },
    "Encrypts all saved conversation transcripts using ChaCha20-Poly1305 authenticated encryption. The encryption key is stored in the Secure Enclave via Keychain and requires Face ID, Touch ID, or your device passcode to unlock. Conversations are automatically locked when the app moves to the background." : {
      "comment" : "A description of the security settings in the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шифрует все сохранённые расшифровки разговоров с помощью аутентифицированного шифрования ChaCha20-Poly1305. Ключ шифрования хранится в Secure Enclave через Keychain, и для разблокировки требуется Face ID, Touch ID или код-пароль устройства. При переходе приложения в фон разговоры автоматически блокируются."
          }
        }
      }
    },
