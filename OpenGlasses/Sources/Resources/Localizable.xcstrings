    "%@ sets these settings, so they aren't shown on this phone. Settings › Organisation lists what %@ sets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم %1$@ بتعيين هذه الإعدادات، بحيث لا تظهر على هذا الهاتف. الإعدادات › تسرد المنظمة ما يحدده %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ sets these settings, so they aren't shown on this phone. Settings › Organisation lists what %2$@ sets."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ establece estos ajustes, así que no se muestran en este celular. Configuración › Organización enumera lo que establece %2$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ définit ces réglages, donc ils ne sont pas affichés sur ce téléphone. Réglages › Organisation répertorie ce que %2$@ définit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ beállítja ezeket a beállításokat, így ezen a telefonon nem jelennek meg. Beállítások › A szervezet felsorolja, hogy mit állít be a %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ configura queste impostazioni, quindi non vengono visualizzate su questo telefono. Impostazioni › Organizzazione elenca ciò che %2$@ imposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はこれらの設定を行うため、この電話では表示されません。設定 › 組織で %2$@ が設定する内容を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 이러한 설정을 지정하므로 이 전화기에는 표시되지 않습니다. 설정 › 조직은 %2$@가 설정한 내용을 나열합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ stelt deze instellingen in, zodat ze niet op deze telefoon worden weergegeven. Instellingen › Organisatie geeft weer wat %2$@ instelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ define essas configurações, portanto elas não são mostradas neste telefone. Configurações › Organização lista o que %2$@ define."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ задаёт эти настройки, поэтому на этом телефоне они не показаны. В разделе «Настройки › Организация» перечислено, что задаёт %2$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ترتیبات %1$@ طے کرتا ہے، اس لیے یہ اس فون پر نہیں دکھائی جاتیں۔ ترتیبات › تنظیم میں درج ہے کہ %2$@ کیا طے کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 设置这些设置，因此它们不会显示在此手机上。设置 › 组织列出了 %2$@ 设置的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 設定這些設置，因此它們不會顯示在此手機上。設定 › 組織列出了 %2$@ 設定的內容。"
          }
        }
      }
    },
    "%@ sets these, so they are left out of Settings. An administrator can open them from Administrator Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم %1$@ بتعيين هذه العناصر، لذا يتم استبعادها من الإعدادات. يمكن للمسؤول فتحها من إعدادات المسؤول."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ establece estos ajustes, así que se omiten en Configuración. Un administrador puede abrirlos desde Configuración de administrador."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ définit ceux-ci, donc ils sont exclus de Paramètres. Un administrateur peut les ouvrir depuis Réglages de l'administrateur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ beállítja ezeket, így kimaradnak a Beállításokból. Az adminisztrátor megnyithatja őket a Rendszergazdai beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ li imposta, quindi vengono esclusi dalle Impostazioni. Un amministratore può aprirli dalle Impostazioni amministratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ がこれらを設定するため、設定からは除外されています。管理者は管理者設定からこれらを開くことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 이를 설정하므로 설정에서 제외됩니다. 관리자는 관리자 설정에서 해당 항목을 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ stelt deze in, zodat ze buiten Instellingen worden gelaten. Een beheerder kan ze openen via Beheerdersinstellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ os define, portanto eles ficam de fora das Configurações. Um administrador pode abri-los nas Configurações do administrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ задаёт эти параметры, поэтому в Настройках их нет. Администратор может открыть их в настройках администратора."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ %@ طے کرتا ہے، اس لیے انہیں ترتیبات سے باہر رکھا گیا ہے۔ ایڈمنسٹریٹر انہیں ایڈمنسٹریٹر ترتیبات سے کھول سکتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 设置了这些，因此它们被排除在“设置”之外。管理员可以从管理员设置中打开它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 設定了這些，因此它們被排除在「設定」之外。管理員可以從管理員設定中開啟它們。"
          }
        }
      }
    },
