    "No channel is allowed for job reports. Set one up under Job Reports above." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد قناة مسموح بها لتقارير المهمة. أعدّ واحدة ضمن «تقارير المهمة» أعلاه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún canal permitido para los reportes de trabajo. Configura uno en Reportes de trabajo, arriba."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun canal n’est autorisé pour les rapports de travail. Configurez-en un sous Rapports de travail ci-dessus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyetlen csatorna sincs engedélyezve a munkajelentésekhez. Állítson be egyet fent, a Munkajelentések alatt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun canale è consentito per i rapporti dei lavori. Configuralo in Rapporti di lavoro qui sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブレポートに許可されているチャンネルがありません。上の「ジョブレポート」で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 보고서에 허용된 채널이 없습니다. 위의 작업 보고서에서 설정하세요."
