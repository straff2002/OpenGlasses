    "This truck's own figure is kept unless you switch a line on to take base's." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتفظ برقم هذه الشاحنة ما لم تُفعّل سطرًا لاعتماد رقم المقر."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conserva la cifra propia de este camión, a menos que actives una línea para tomar la de la base."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur propre à ce camion est conservée, sauf si vous activez une ligne pour prendre celle de la base."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A teherautó saját értéke megmarad, kivéve, ha bekapcsol egy sort, hogy a központ értéke érvényesüljön."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cifra propria di questo camion viene mantenuta, a meno che tu non attivi una riga per prendere quella della base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行ごとにオンにして拠点の数値を採用しない限り、このトラック自身の数値が保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목별로 켜서 본부의 수치를 따르지 않는 한 이 트럭 자체의 수치가 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het eigen cijfer van deze wagen blijft behouden, tenzij u een regel aanzet om dat van de basis over te nemen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor próprio deste caminhão é mantido, a menos que você ative uma linha para usar o da base."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собственное значение этой машины сохраняется, если только вы не включите для строки значение базы."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ٹرک کا اپنا عدد رکھا جاتا ہے، جب تک آپ بیس کا عدد لینے کے لیے کوئی لائن آن نہ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非你打开某一行的开关以采用总部的数字，否则保留这辆车自己的数字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非你開啟某個項目的開關以採用總部的數字，否則會保留這輛車自己的數字。"
          }
        }
      }
    },
