        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پریمیم آواز ڈاؤن لوڈ کرنے کے لیے iPhone کی ترتیبات → رسائی پذیری → پڑھیں اور بولیں → آوازیں پر جائیں۔"
