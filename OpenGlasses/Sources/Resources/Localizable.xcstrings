    "Plain text — turn history plus per-cohort latency stats. Copying it is the only way these numbers leave the device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نص عادي — عرض التاريخ بالإضافة إلى إحصائيات التأخير لكل مجموعة. نسخها هو الطريقة الوحيدة التي تخرج بها هذه الأرقام من الجهاز."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto sin formato: historial de turnos más estadísticas de latencia por grupo. Copiarlo es la única forma en que estos números salen del dispositivo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte brut — active l'historique ainsi que les statistiques de latence par cohorte. La copier est le seul moyen pour que ces chiffres quittent l'appareil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszerű szöveg – fordulatelőzmények plusz kohorszonkénti késleltetési statisztikák. A számok másolása az egyetlen módja annak, hogy elhagyja az eszközt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo normale: cronologia dei turni e statistiche sulla latenza per coorte. Copiarlo è l'unico modo in cui questi numeri lasciano il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーンテキスト — 履歴と各コホートのレイテンシ統計。コピーすることが、この数字がデバイスから外に出る唯一の方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 텍스트 — 턴 기록과 코호트별 대기 시간 통계. 복사하는 것이 이 번호가 장치에서 나가는 유일한 방법입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platte tekst: draaigeschiedenis plus latentiestatistieken per cohort. Het kopiëren ervan is de enige manier waarop deze nummers het apparaat verlaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto simples — histórico de turnos e estatísticas de latência por coorte. Copiá-lo é a única maneira de esses números saírem do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычный текст — история реплик и статистика задержек по когортам. Копирование — единственный способ, которым эти данные покидают устройство."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سادہ متن — ٹرن ہسٹری اور ہر گروپ کی تاخیر کے اعداد و شمار۔ اسے کاپی کرنا ہی وہ واحد طریقہ ہے جس سے یہ اعداد ڈیوائس سے باہر جاتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纯文本——显示历史记录以及每个组的延迟统计。复制是这些数据唯一离开设备的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "純文字 — 顯示歷史紀錄及每群組延遲統計。複製它是這些數字離開裝置的唯一方式。"
          }
        }
      }
    },
