    "Leave anything you don't know empty. The brief says what's missing rather than guessing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اترك أي شيء لا تعرفه فارغًا. الموجز يوضح ما هو مفقود بدلاً من التخمين."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja vacío lo que no sepas. El resumen dice qué falta en lugar de adivinar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide tout ce que vous ne savez pas. Le résumé indique ce qui manque plutôt que de deviner."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amit nem tudsz, hagyj üresen. A rövid leírás inkább azt mondja, mi hiányzik, mintsem találgat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto tutto ciò che non conosci. Il brief dice cosa manca piuttosto che indovinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知らないことは空白のままにしてください。概要には推測ではなく不足しているものが書かれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모르는 것은 비워두세요. 개요는 추측하기보다는 누락된 부분을 알려줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat alles wat je niet weet leeg. De opdracht zegt wat er ontbreekt in plaats van te raden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe tudo o que você não conhece vazio. O resumo diz o que está faltando, em vez de adivinhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым всё, чего вы не знаете. Сводка укажет, чего не хватает, вместо того чтобы гадать."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو کچھ آپ نہیں جانتے اسے خالی چھوڑ دیں۔ بریف اندازہ لگانے کے بجائے بتاتا ہے کہ کیا کمی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于你不确定的内容保持空白。简报说明了缺失内容，而不是猜测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留任何你不知道的部分。簡介說明了缺少的內容，而不是猜測。"
          }
        }
      }
    },
