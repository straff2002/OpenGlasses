    "1 clip goes with the report; %lld are too large for %@ and must be shared separately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقطع واحد يُرسل مع التقرير؛ وعدد المقاطع الأكبر من الحد المسموح في %2$@ والتي يجب مشاركتها بشكل منفصل: %1$lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 clip goes with the report; %1$lld are too large for %2$@ and must be shared separately."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 clip se envía con el reporte; %1$lld son demasiado grandes para %2$@ y deben compartirse por separado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 clip accompagne le rapport; %1$lld sont trop volumineux pour %2$@ et doivent être partagés séparément."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 klip a jelentéssel együtt megy; %1$lld túl nagy a(z) %2$@ számára, ezeket külön kell megosztani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 clip allegata al rapporto; %1$lld sono troppo grandi per %2$@ e vanno condivise separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1件のクリップがレポートに添付されます。%1$lld件は%2$@には大きすぎるため、別々に共有する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립 1개는 보고서와 함께 전송됩니다. %1$lld개는 %2$@에 비해 너무 커서 별도로 공유해야 합니다."
