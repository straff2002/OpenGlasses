    "Personal Information Protection and Electronic Documents Act — requires consent, limiting collection, and safeguards appropriate to the sensitivity of health information." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قانون حماية المعلومات الشخصية والمستندات الإلكترونية — يتطلب الموافقة وتحديد الجمع وضمانات تتناسب مع حساسية المعلومات الصحية."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Information Protection and Electronic Documents Act: exige consentimiento, limitar la recopilación y protecciones adecuadas a la sensibilidad de la información de salud."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Information Protection and Electronic Documents Act — exige le consentement, la limitation de la collecte et des mesures de protection proportionnées à la sensibilité des renseignements sur la santé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Személyes adatok védelméről és elektronikus dokumentumokról szóló törvény — beleegyezést, a gyűjtés korlátozását és az egészségügyi információk érzékenységének megfelelő védelmi intézkedéseket ír elő."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Information Protection and Electronic Documents Act: richiede il consenso, la limitazione della raccolta e misure di salvaguardia adeguate alla sensibilità delle informazioni sanitarie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人情報保護及び電子文書法 — 同意の取得、収集の制限、健康情報の機微性に応じた保護措置が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Information Protection and Electronic Documents Act — 동의, 수집 제한, 건강 정보의 민감도에 맞는 보호 조치를 요구합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Information Protection and Electronic Documents Act — vereist toestemming, beperking van gegevensverzameling en waarborgen die passen bij de gevoeligheid van gezondheidsinformatie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Information Protection and Electronic Documents Act — exige consentimento, limitação da coleta e salvaguardas proporcionais à sensibilidade das informações de saúde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закон о защите персональной информации и электронных документов — требует согласия, ограничения сбора и мер защиты, соответствующих чувствительности медицинской информации."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Information Protection and Electronic Documents Act — رضامندی، جمع کرنے کی حد بندی، اور صحت کی معلومات کی حساسیت کے مطابق تحفظات درکار ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《个人信息保护和电子文件法案》— 要求取得同意、限制收集，并根据健康信息的敏感程度采取相应保护措施。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《個人資訊保護與電子文件法》— 要求取得同意、限制蒐集，並採取與健康資訊敏感度相稱的保護措施。"
          }
        }
      }
    },
