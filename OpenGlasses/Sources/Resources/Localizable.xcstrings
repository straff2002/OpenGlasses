    "This build only makes an unencrypted connection to an address on your own network. Use the machine's local IP address, or an https:// address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ هذا الإصدار اتصالًا غير مشفر بعنوان على شبكتك الخاصة فقط. استخدم عنوان IP المحلي للجهاز، أو عنوان https://."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
