    "Ends this one. What you say next starts a fresh conversation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينهي هذا. ما تقوله بعد ذلك يبدأ محادثة جديدة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina esta. Lo siguiente que digas inicia una conversación nueva."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met fin à celle-ci. Ce que vous dites ensuite commence une nouvelle conversation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel véget ér. Amit ezután mondasz, az új beszélgetést indít el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finisce questo. Ciò che dici dopo avvia una nuova conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを終了します。次に言うことが新しい会話を始めます。"
          }
