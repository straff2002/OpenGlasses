        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Ön rendszergazdájának be kell fejeznie ennek a telefon beállítását: a %1$@-nek még szüksége van a kulcsára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'amministratore deve completare la configurazione di questo telefono: %1$@ necessita ancora della chiave."
