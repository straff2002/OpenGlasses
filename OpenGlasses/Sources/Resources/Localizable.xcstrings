        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden, ami a Team csomagban van, szerződéses feltételekkel: white-label, SLA, megőrzés és saját üzemeltetésű szakértői relé."
          }
        },
        "it" : {
