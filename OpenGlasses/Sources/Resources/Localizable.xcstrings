            "value" : "قبو الصحة الشخصية يُفتح مع اشتراك الامتثال الطبي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Bóveda de salud personal se desbloquea con la suscripción a Cumplimiento médico."
