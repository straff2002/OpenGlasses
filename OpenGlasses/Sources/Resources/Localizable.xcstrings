    "No spot saved. Say “I parked on level 2, space 41”, or add a photo of the sign." : {
      "comment" : "Text displayed when the user hasn't selected a parking spot.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم حفظ موقع. قل \"لقد أوقفت سيارتي في المستوى 2، المساحة 41\"، أو أضف صورة للعلامة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún lugar guardado. Di “me estacioné en el nivel 2, lugar 41” o agrega una foto del letrero."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun stationnement enregistré. Dites « J'ai garé au niveau 2, place 41 », ou ajoutez une photo du panneau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs mentett hely. Mondja azt, hogy „Parkoltam a 2. szinten, a 41. helyen”, vagy adjon hozzá egy fotót a tábláról."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun posto salvato. Dì \"Ho parcheggiato al livello 2, spazio 41\" o aggiungi una foto del cartello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スポットが保存されていません。「レベル2、スペース41に駐車しました」と言うか、標識の写真を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 자리가 없습니다. \"2층 41번 공간에 주차했습니다\"라고 말하거나 표지판 사진을 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen plek opgeslagen. Zeg 'Ik heb geparkeerd op niveau 2, veld 41', of voeg een foto van het bord toe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum local salvo. Diga “Estacionei no nível 2, vaga 41” ou adicione uma foto da placa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Место не сохранено. Скажите «машина на уровне 2, место 41» или добавьте фото указателя."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی جگہ محفوظ نہیں۔ کہیں “میں نے لیول 2، جگہ 41 پر پارک کیا”، یا سائن کی تصویر شامل کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无保存的停车位。说“我停在2层41号车位”，或添加标志的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
