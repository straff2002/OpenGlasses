      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإطار ما تريد تسجيله للوظيفة، ثم التقط الصورة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuadra lo que quieras registrar para el trabajo y luego toma la foto."
