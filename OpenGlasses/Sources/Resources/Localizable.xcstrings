        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効化されたペルソナはウェイクワードを聞きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장애인 페르소나는 자신이 깨우는 말을 듣지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehandicapte persona's luisteren niet naar hun wake-word."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas com deficiência não ouvirão sua palavra de alerta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключённые персоны не будут слушать своё слово активации."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غیر فعال پرسونا اپنے ویک ورڈ کو نہیں سنیں گے۔"
