    },
    "Saved with this model and used on every job. Reasoning tokens are billed as output, so higher settings cost more and answer more slowly." : {
      "comment" : "A description of the reasoning setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الحفظ باستخدام هذا النموذج واستخدامه في كل مهمة. يتم فوترتك على رموز الاستدلال كمخرجات، لذلك الإعدادات الأعلى تكلف أكثر وتجيب ببطء أكثر."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda con este modelo y se usa en todos los trabajos. Los tokens de razonamiento se cobran como salida, así que los ajustes más altos cuestan más y responden más lento."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré avec ce modèle et utilisé pour chaque tâche. Les jetons de raisonnement sont facturés comme sortie, donc des réglages plus élevés coûtent plus cher et répondent plus lentement."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel a modellel mentve és minden munkához használt. Az érvelési tokenek kimenetként kerülnek számlázásra, így a magasabb beállítások többe kerülnek, és lassabban válaszolnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato con questo modello e utilizzato in ogni lavoro. I token di ragionamento vengono fatturati come output, quindi le impostazioni più elevate costano di più e rispondono più lentamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルで保存され、すべての作業に使用済み。推論トークンは出力として請求されるため、高設定ではコストが増え、回答に時間がかかります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모델과 함께 저장되어 모든 작업에 사용됩니다. 추론 토큰은 출력으로 청구되므로 설정이 높을수록 비용이 더 많이 들고 응답 속도도 느려집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen met dit model en gebruikt bij elke taak. Redeneringstokens worden als output in rekening gebracht, dus hogere instellingen kosten meer en antwoorde trager."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo com este modelo e usado em todos os trabalhos. Os tokens de raciocínio são cobrados como saída, portanto, configurações mais altas custam mais e respondem mais lentamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняется вместе с этой моделью и используется в каждом задании. Токены рассуждения оплачиваются как выходные, поэтому более высокие значения стоят дороже, а ответы приходят медленнее."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ماڈل کے ساتھ محفوظ ہوتا ہے اور ہر جاب پر استعمال ہوتا ہے۔ ریزننگ ٹوکنز کا بل آؤٹ پٹ کے طور پر بنتا ہے، اس لیے زیادہ ترتیبات کی لاگت زیادہ ہوتی ہے اور جواب آہستہ آتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已与此模型一起保存，并用于每个任务。推理令牌按输出计费，因此设置越高费用越高，回答越慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已與此模型一起儲存並應用於每個工作。推理代幣計為輸出，因此更高設置成本更高且回應速度較慢。"
          }
        }
      }
    },
    "Saves conversation transcripts so you can review them later in the History tab. Also provides context for follow-up questions within a session. When off, conversations are ephemeral and discarded after each session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ نصوص المحادثات لتتمكن من مراجعتها لاحقًا في تبويب السجل. ويوفر أيضًا سياقًا للأسئلة اللاحقة ضمن الجلسة. عند الإيقاف تكون المحادثات مؤقتة وتُهمل بعد كل جلسة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda las transcripciones de las conversaciones para que puedas revisarlas después en la pestaña Historial. También da contexto para preguntas de seguimiento dentro de una sesión. Cuando está desactivado, las conversaciones son efímeras y se descartan al terminar cada sesión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre les transcriptions de conversation afin que vous puissiez les consulter plus tard dans l’onglet Historique. Fournit aussi du contexte pour les questions de suivi au sein d’une session. Lorsque c’est désactivé, les conversations sont éphémères et supprimées après chaque session."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menti a beszélgetések átiratait, hogy később áttekinthesse őket az Előzmények lapon. Emellett kontextust ad a munkameneten belüli követő kérdésekhez. Kikapcsolva a beszélgetések átmenetiek, és minden munkamenet után elvetődnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva le trascrizioni delle conversazioni per poterle rivedere più tardi nella scheda Cronologia. Fornisce anche il contesto per le domande successive nella stessa sessione. Quando è disattivato, le conversazioni sono effimere e vengono scartate al termine di ogni sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話の文字起こしを保存し、後で履歴タブで見返せるようにします。セッション中のフォローアップの質問の文脈にもなります。オフの間、会話は一時的なもので、セッションごとに破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화 기록을 저장하여 나중에 기록 탭에서 다시 볼 수 있습니다. 세션 내 후속 질문의 컨텍스트로도 사용됩니다. 꺼져 있으면 대화는 임시로만 유지되며 세션이 끝날 때마다 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaat gesprekstranscripties op zodat u ze later kunt bekijken op het tabblad Geschiedenis. Biedt ook context voor vervolgvragen binnen een sessie. Als het uit staat, zijn gesprekken vluchtig en worden ze na elke sessie verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva as transcrições das conversas para você revisar depois na aba Histórico. Também dá contexto para perguntas seguintes dentro de uma sessão. Desligado, as conversas são efêmeras e descartadas após cada sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет расшифровки разговоров, чтобы вы могли просмотреть их позже на вкладке «История». Также даёт контекст для уточняющих вопросов в рамках сеанса. Когда выключено, разговоры временные и удаляются после каждого сеанса."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گفتگو کی ٹرانسکرپٹس محفوظ کرتا ہے تاکہ آپ انہیں بعد میں ہسٹری ٹیب میں دیکھ سکیں۔ ایک سیشن کے اندر فالو اپ سوالات کے لیے سیاق بھی فراہم کرتا ہے۔ آف ہونے پر گفتگوئیں عارضی ہوتی ہیں اور ہر سیشن کے بعد ہٹا دی جاتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存对话转录，以便你之后在“历史”标签中查看。也为会话内的后续问题提供上下文。关闭时，对话是临时的，每次会话结束后即被丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存對話逐字稿，讓你之後能在「歷史紀錄」分頁中查看。也為單一工作階段內的後續提問提供背景。關閉時，對話是暫時性的，每次工作階段結束後就會丟棄。"
          }
        }
      }
    },
    "Saves the debrief word for word, labelled as not summarised." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ التقرير التفصيلي كلمة بكلمة، مع وسمه بأنه غير ملخص."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la recapitulación palabra por palabra, etiquetada como no resumida."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre le compte rendu mot pour mot, étiqueté comme non résumé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szóról szóra menti a kitekintést, nem összefoglaltként címkézve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva il debriefing parola per parola, etichettato come non riassunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デブリーフを逐語的に保存し、要約なしとしてラベル付けします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요약되지 않음으로 라벨이 붙은 보고 내용을 한 단어씩 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaat de debriefing woord voor woord op, gelabeld als niet samengevat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva o relatório palavra por palavra, rotulado como não resumido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет отчёт дословно, с пометкой о том, что он не был сокращён."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈی بریف کو لفظ بہ لفظ محفوظ کرتا ہے، اس نشان کے ساتھ کہ اس کا خلاصہ نہیں کیا گیا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐字保存汇报内容，并标记为未汇总。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐字保存簡報，標記為未摘要。"
          }
        }
      }
    },
    "Saving records a count, so the figure is marked as counted from now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل الحفظ عددًا، لذا يُعلَّم الرقم على أنه معدود من الآن."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar registra un conteo, así que la cifra se marca como contada desde ahora."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement consigne un décompte : la quantité est donc marquée comme comptée à partir de maintenant."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mentés egy leltárszámot rögzít, ezért az érték mostantól megszámoltként lesz megjelölve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvare registra un conteggio, quindi la cifra viene contrassegnata come contata da ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存するとカウントが記録され、その数値は今からカウント済みとして扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하면 수량이 기록되며, 이 수치는 지금부터 확인된 수량으로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaren legt een telling vast, dus het cijfer wordt vanaf nu als geteld gemarkeerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar registra uma contagem, então o valor é marcado como contado a partir de agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранение фиксирует подсчёт, поэтому с этого момента значение помечается как подсчитанное."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ کرنے سے ایک گنتی ریکارڈ ہوتی ہے، اس لیے یہ عدد اب سے گنا ہوا شمار ہوگا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存会记录一次清点，因此该数字会从现在起标记为已清点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存會記錄一次清點，因此該數字會從現在起標記為已清點。"
          }
        }
      }
    },
