        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het record kon niet worden teruggelezen van het apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu registro não pôde ser lido no dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его запись не удалось прочитать обратно с устройства."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کا ریکارڈ ڈیوائس سے واپس پڑھا نہیں جا سکا۔"
