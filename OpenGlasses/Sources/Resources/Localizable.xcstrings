    "Show Original adds the source-language words under each translated caption." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض الأصل يضيف الكلمات بلغة المصدر تحت كل عنوان مترجم."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar original agrega las palabras en el idioma de origen debajo de cada subtítulo traducido."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher l'original ajoute les mots dans la langue source sous chaque sous-titre traduit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Eredeti megjelenítése minden lefordított felirat alá hozzáadja a forrásnyelvi szavakat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra originale aggiunge le parole della lingua di partenza sotto ciascuna didascalia tradotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルを表示は、各翻訳されたキャプションの下に原文の単語を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 표시는 번역된 각 캡션 아래에 원어 단어를 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origineel weergeven voegt de woorden in de brontaal toe onder elk vertaald bijschrift."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar original adiciona as palavras do idioma de origem em cada legenda traduzida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Показать оригинал» добавляет слова на исходном языке под каждым переведённым субтитром."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“اصل دکھائیں” ہر ترجمہ شدہ کیپشن کے نیچے ماخذ زبان کے الفاظ شامل کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示原文会在每个翻译的字幕下添加源语言的单词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示原文會在每個翻譯字幕下方添加源語言文字。"
          }
        }
      }
    },
