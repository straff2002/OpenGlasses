    "Closes the job and sends the written record on its own, with no pictures." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إغلاق المهمة وإرسال السجل المكتوب بمفرده، بدون صور."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra el trabajo y envía solo el registro escrito, sin imágenes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferme le travail et envoie l'enregistrement écrit lui-même, sans photos."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lezárja a munkát, és az írásos jegyzőkönyvet önállóan, képek nélkül elküldi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiude il lavoro e invia solo la documentazione scritta, senza immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事を終了し、写真なしで書面の記録を自動送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업을 종료하고 사진 없이 서면 기록을 자체적으로 보냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit de taak en verzendt het schriftelijke document zelfstandig, zonder foto's."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fecha o trabalho e envia sozinho o registro escrito, sem fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрывает задание и отправляет только письменную запись, без изображений."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جاب بند کرتا ہے اور صرف تحریری ریکارڈ بھیجتا ہے، تصاویر کے بغیر۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭任务并自动发送书面记录，无需图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉工作並自動發送書面記錄，不包含圖片。"
          }
        }
      }
    },
