        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült betölteni az xAI-fiókja modelljeit. Jelentkezzen ki, majd újra be, vagy adjon meg egy modellazonosítót lent."
          }
        },
        "it" : {
          "stringUnit" : {
