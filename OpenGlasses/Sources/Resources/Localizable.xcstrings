        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ اب بھی اس گفتگو میں ہے جہاں آپ نے اسے کہا تھا۔ اسے وہاں سے ہٹانے کے لیے وہ گفتگو حذف کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它仍然在您说过它的对话中。删除该对话即可将其移除。"
