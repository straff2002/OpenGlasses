    "NHS Spine integration requires an NHS Digital connection agreement and MESH mailbox. Contact your trust's IT department." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب تكامل NHS Spine اتفاقية اتصال NHS Digital وصندوق بريد MESH. تواصل مع قسم تقنية المعلومات في الهيئة الصحية التابعة لك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con NHS Spine requiere un acuerdo de conexión de NHS Digital y un buzón MESH. Contacta al departamento de TI de tu trust."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration à NHS Spine exige une entente de connexion NHS Digital et une boîte aux lettres MESH. Communiquez avec le service des TI de votre fiducie."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az NHS Spine integrációhoz NHS Digital csatlakozási megállapodás és MESH postafiók szükséges. Forduljon a trust IT-részlegéhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'integrazione con NHS Spine richiede un accordo di connessione NHS Digital e una casella MESH. Contatta il reparto IT della tua struttura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NHS Spineとの連携には、NHS Digitalとの接続契約とMESHメールボックスが必要です。所属するトラストのIT部門にお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NHS Spine 연동에는 NHS Digital 연결 계약과 MESH 사서함이 필요합니다. 소속 트러스트의 IT 부서에 문의하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integratie met NHS Spine vereist een NHS Digital-verbindingsovereenkomst en een MESH-mailbox. Neem contact op met de IT-afdeling van uw trust."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A integração com o NHS Spine exige um acordo de conexão com o NHS Digital e uma caixa postal MESH. Fale com o departamento de TI do seu trust."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интеграция с NHS Spine требует соглашения о подключении к NHS Digital и почтового ящика MESH. Обратитесь в ИТ-отдел вашего траста."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NHS Spine انضمام کے لیے NHS Digital کنکشن معاہدہ اور MESH میل باکس درکار ہے۔ اپنے ٹرسٹ کے IT شعبے سے رابطہ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NHS Spine 集成需要 NHS Digital 连接协议和 MESH 邮箱。请联系你所在信托机构的 IT 部门。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NHS Spine 整合需要 NHS Digital 連線協議以及 MESH 信箱。請聯絡你所屬信託機構的 IT 部門。"
          }
        }
      }
    },
