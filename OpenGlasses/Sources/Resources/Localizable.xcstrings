    },
    "Your administrator needs to finish setting up this phone: %@ still needs its key." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج المسؤول الخاص بك إلى إنهاء إعداد هذا الهاتف: لا يزال %1$@ بحاجة إلى مفتاحه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu administrador necesita terminar de configurar este celular: %@ todavía necesita su clave."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre administrateur doit terminer la configuration de ce téléphone : %1$@ a toujours besoin de sa clé."
          }
