        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 문서에서 감지된 언어와 해당 문서의 구절을 검색하는 데 사용하는 모델입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedetecteerde taal van elk document en het model waarmee de passages worden doorzocht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma detectado de cada documento e o modelo com o qual seus trechos são pesquisados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определённый язык каждого документа и модель, с помощью которой ищутся его фрагменты."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر دستاویز کی شناخت شدہ زبان اور وہ ماڈل جس سے اس کے حصے تلاش کیے جاتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每份文档检测到的语言，以及用于搜索其段落的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每份文件偵測到的語言，以及用於搜尋其段落的模型。"
          }
        }
      }
    },
    "Each job can use its own model, from any key you've saved. A job that uses a cloud model sends that job's data to its provider, on that provider's key." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لكل مهمة استخدام نموذجها الخاص، من أي مفتاح حفظته. المهمة التي تستخدم نموذجًا سحابيًا ترسل بيانات تلك المهمة إلى مزوّدها، عبر مفتاح ذلك المزوّد."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tarea puede usar su propio modelo, con cualquier clave que hayas guardado. Una tarea que usa un modelo en la nube envía los datos de esa tarea a su proveedor, con la clave de ese proveedor."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque tâche peut utiliser son propre modèle, parmi toutes les clés que vous avez enregistrées. Une tâche qui utilise un modèle cloud envoie les données de cette tâche à son fournisseur, avec la clé de ce fournisseur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden feladat használhat saját modellt bármelyik elmentett kulcsból. A felhőmodellt használó feladat az adatait a szolgáltatójának küldi el, annak a kulcsával."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni compito può usare un proprio modello, con qualsiasi chiave che hai salvato. Un compito che usa un modello cloud invia i dati di quel compito al suo provider, con la chiave di quel provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ロールには、保存したキーから選んだ専用のモデルを使えます。クラウドモデルを使うロールは、そのロールのデータをプロバイダーに、そのプロバイダーのキーで送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 역할은 저장한 키 중 어떤 것으로든 자체 모델을 사용할 수 있습니다. 클라우드 모델을 사용하는 역할은 해당 역할의 데이터를 제공자에게 그 제공자의 키로 전송합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke taak kan een eigen model gebruiken, van elke sleutel die je hebt opgeslagen. Een taak die een cloudmodel gebruikt, stuurt de gegevens van die taak naar de provider, via de sleutel van die provider."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tarefa pode usar seu próprio modelo, com qualquer chave que você salvou. Uma tarefa que usa um modelo na nuvem envia os dados dessa tarefa ao provedor dele, com a chave desse provedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая задача может использовать свою модель с любым из сохранённых вами ключей. Задача, использующая облачную модель, отправляет свои данные её провайдеру по ключу этого провайдера."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر کام اپنا ماڈل استعمال کر سکتا ہے، آپ کی محفوظ کردہ کسی بھی کلید سے۔ کلاؤڈ ماڈل استعمال کرنے والا کام اپنا ڈیٹا اس کے فراہم کنندہ کو بھیجتا ہے، اسی فراہم کنندہ کی کلید پر۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个角色都可以使用自己的模型，来自你保存的任意密钥。使用云端模型的角色会用该提供商的密钥，将该角色的数据发送给其提供商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個角色都可以使用自己的模型，來自你儲存的任意金鑰。使用雲端模型的角色會用該提供者的金鑰，將該角色的資料傳送給其提供者。"
          }
        }
      }
    },
    "Each of these is pinned to an exact version and checked against its published checksum before it's installed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل منها مرتبط بإصدار محدد ويتم التحقق منه مقابل مجموع التحقق المنشور قبل تثبيته."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno está fijado a una versión exacta y se compara con su suma de verificación publicada antes de instalarse."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun de ceux-ci est attaché à une version exacte et vérifié par rapport à son checksum publié avant installation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek mindegyike egy pontos verzióhoz van rögzítve, és telepítés előtt ellenőrzi a közzétett ellenőrző összeget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno di questi è fissato a una versione esatta e confrontato con il checksum pubblicato prima di essere installato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの各項目は正確なバージョンに固定され、インストール前に公開済みのチェックサムと照合されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이들 각각은 정확한 버전에 고정되어 설치되기 전에 게시된 체크섬과 비교하여 확인됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk van deze is vastgemaakt aan een exacte versie en gecontroleerd aan de hand van de gepubliceerde controlesom voordat deze wordt geïnstalleerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um deles é fixado em uma versão exata e verificado em relação à soma de verificação publicada antes de ser instalado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый из них привязан к точной версии и проверяется по опубликованной контрольной сумме перед установкой."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان میں سے ہر ایک ایک مخصوص ورژن پر مقرر ہے اور انسٹال ہونے سے پہلے اس کے شائع شدہ checksum سے جانچا جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个组件都会固定到确切版本，并在安装前与其已发布的校验和进行核对。"
