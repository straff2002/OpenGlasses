    "Conversations are processed by the AI provider you choose. Responses are generated by AI and may not always be accurate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم معالجة المحادثات بواسطة موفر الذكاء الاصطناعي الذي تختاره. يتم إنشاء الاستجابات بواسطة الذكاء الاصطناعي وقد لا تكون دقيقة دائمًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conversaciones las procesa el proveedor de IA que elijas. Las respuestas son generadas por IA y no siempre son precisas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversations sont traitées par le fournisseur d'IA que vous choisissez. Les réponses sont générées par l'IA et peuvent ne pas toujours être exactes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beszélgetéseket az Ön által választott AI-szolgáltató dolgozza fel. A válaszokat az MI generálja, és előfordulhat, hogy nem mindig pontosak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conversazioni vengono elaborate dal provider AI scelto. Le risposte sono generate dall'intelligenza artificiale e potrebbero non essere sempre accurate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話は選択したAIプロバイダーによって処理されます。応答はAIによって生成され、必ずしも正確であるとは限りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화는 귀하가 선택한 AI 제공업체에 의해 처리됩니다. 응답은 AI에 의해 생성되므로 항상 정확하지는 않을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprekken worden verwerkt door de AI-provider die u kiest. Reacties worden gegenereerd door AI en zijn mogelijk niet altijd accuraat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas são processadas pelo provedor de IA que você escolher. As respostas são geradas pela IA e podem nem sempre ser precisas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разговоры обрабатываются выбранным вами провайдером ИИ. Ответы генерируются ИИ и не всегда могут быть точными."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گفتگوؤں پر کارروائی آپ کے منتخب کردہ AI فراہم کنندہ کے ذریعے ہوتی ہے۔ جوابات AI تیار کرتا ہے اور ہو سکتا ہے ہمیشہ درست نہ ہوں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话由您选择的 AI 提供商处理。回复由 AI 生成，可能并不总是准确的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對話由您選擇的 AI 供應商處理。回覆由 AI 生成，可能並非總是準確。"
          }
        }
      }
    },
