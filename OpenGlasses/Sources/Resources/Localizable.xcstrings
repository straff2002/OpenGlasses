      }
    },
    "Pipeline" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конвейер"
          }
        }
      }
    },
    "Plain text — turn history plus per-cohort latency stats. Copying it is the only way these numbers leave the device." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычный текст — история реплик и статистика задержек по когортам. Копирование — единственный способ, которым эти данные покидают устройство."
          }
