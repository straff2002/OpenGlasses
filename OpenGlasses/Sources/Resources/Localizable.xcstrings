      }
    },
    "I can describe what I can see, not how they feel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أستطيع وصف ما أراه، ليس كيف يشعرون."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedo describir lo que veo, no cómo se siente la persona."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je peux décrire ce que je vois, pas ce qu'ils ressentent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azt tudom leírni, amit látok, nem azt, hogy mit éreznek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso descrivere ciò che vedo, non come si sentono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は見たものを説明できますが、彼らの感情は説明できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 그들이 느끼는 것이 아니라 내가 본 것을 설명할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik kan beschrijven wat ik zie, niet hoe zij zich voelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso descrever o que vejo, não como eles se sentem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я могу описать то, что вижу, но не то, что человек чувствует."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میں بیان کر سکتا ہوں کہ مجھے کیا نظر آتا ہے، یہ نہیں کہ وہ کیسا محسوس کرتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我可以描述我看到的东西，而不是他们的感受。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我可以描述我所看到的，而不是他們的感受。"
          }
        }
      }
    },
    "I couldn't forget that — it's still saved. Try again from Memory on your phone." : {
      "comment" : "Said or shown when a fact could not be removed from memory.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أتمكن من نسيان ذلك — ما زال محفوظًا. حاول مرة أخرى من الذاكرة على هاتفك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pude olvidar eso; sigue guardado. Intenta de nuevo desde Memoria en tu celular."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n'ai pas pu oublier cela — c'est encore enregistré. Essayez à nouveau depuis Mémoire sur votre téléphone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt nem tudtam elfelejteni – még mindig meg van mentve. Próbálja újra a telefon memóriájából."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potevo dimenticarlo: è ancora salvato. Riprova dalla Memoria del telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それを忘れることはできませんでした—まだ保存されています。携帯のメモリからもう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 그것을 잊을 수 없었다. 그것은 아직도 저장되어 있다. 휴대전화의 메모리에서 다시 시도해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat kon ik niet vergeten: het is nog steeds opgeslagen. Probeer het opnieuw vanuit het geheugen op uw telefoon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu não poderia esquecer disso – ainda está salvo. Tente novamente na memória do seu telefone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось это забыть — оно всё ещё сохранено. Попробуйте ещё раз в разделе «Память» на телефоне."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
