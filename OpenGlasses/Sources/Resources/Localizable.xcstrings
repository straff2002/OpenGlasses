    "“%@” cannot be removed yet: %@. Importing this vault's folder again repairs its manual index." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إزالة «%1$@» بعد: %2$@. يؤدي استيراد مجلد هذه الخزنة مرة أخرى إلى إصلاح فهرس كتيبها."
          }
        },
