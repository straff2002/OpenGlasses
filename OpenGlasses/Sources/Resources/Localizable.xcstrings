    "Simple Mode" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوضع البسيط"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo simple"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode simple"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszerű mód"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modalità semplice"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡易モード"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
