    "No manuals yet. Add your manufacturers' manuals to a vault under Settings › Tools & Actions › Custom Vaults." : {
      "comment" : "A description of the state when a user has no manuals.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد كتيبات بعد. أضف كتيبات المصنعين إلى خزن ضمن الإعدادات › الأدوات والإجراءات › الخزائن المخصصة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay manuales. Agrega los manuales de tus fabricantes a una bóveda en Configuración › Herramientas y acciones › Bóvedas personalizadas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun manuel pour le moment. Ajoutez les manuels de vos fabricants dans un coffre sous Réglages › Outils et actions › Coffres personnalisés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincsenek kézikönyvek. Adja hozzá a gyártói kézikönyveket egy tárolóhoz a Beállítások › Eszközök & Műveletek › Egyedi tárolók alatt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun manuale ancora. Aggiungi i manuali del tuo produttore a un deposito in Impostazioni › Strumenti e azioni › Depositi personalizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マニュアルはまだありません。製造元のマニュアルを設定 › ツールとアクション › カスタムボールトに追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 매뉴얼이 없습니다. 설정 › 도구 및 작업 › 사용자 지정 볼트 아래의 볼트에 제조업체 설명서를 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen handleidingen. Voeg de handleidingen van uw fabrikant toe aan een kluis onder Instellingen › Gereedschappen & Acties › Aangepaste kluizen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há manuais. Adicione os manuais do fabricante a um cofre em Configurações › Ferramentas e ações › Cofres personalizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Руководств пока нет. Добавьте руководства производителей в хранилище в разделе «Настройки › Инструменты и действия › Пользовательские хранилища»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابھی تک کوئی مینوئلز نہیں۔ اپنے مینوفیکچررز کے مینوئلز ترتیبات › ٹولز اور ایکشنز › حسب ضرورت والٹس کے تحت کسی والٹ میں شامل کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无手册。请在 设置 › 工具与操作 › 自定义保险库 下添加厂商手册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無手冊。請將您的製造商手冊添加到 設定 › 工具與操作 › 自訂保險庫 中。"
          }
        }
      }
    },
