    "Protected storage is unavailable. Unlock the device and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التخزين المحمي غير متاح. افتح قفل الجهاز وحاول مرة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El almacenamiento protegido no está disponible. Desbloquea el dispositivo e inténtalo de nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage protégé n’est pas disponible. Déverrouillez l’appareil et réessayez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A védett tárhely nem érhető el. Oldja fel a készüléket, és próbálja újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’archivio protetto non è disponibile. Sblocca il dispositivo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保護されたストレージを利用できません。デバイスのロックを解除して、もう一度お試しください。"
