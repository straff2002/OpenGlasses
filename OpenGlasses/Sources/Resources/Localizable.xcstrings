    "A pack's actions become voice commands the assistant can use. Turning a pack off removes its actions immediately; its settings are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح إجراءات الحزمة أوامر صوتية يمكن للمساعد استخدامها. يؤدي إيقاف تشغيل الحزمة إلى إزالة إجراءاتها على الفور؛ يتم الاحتفاظ بإعداداته."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones de un paquete se vuelven comandos de voz que el asistente puede usar. Al desactivar un paquete, sus acciones se quitan de inmediato; su configuración se conserva."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actions d'un pack deviennent des commandes vocales que l'assistant peut utiliser. Désactiver un pack supprime immédiatement ses actions ; ses réglages sont conservés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csomag műveletei az asszisztens által használható hangutasításokká válnak. A csomag kikapcsolása azonnal megszünteti a műveleteket; beállításai megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le azioni di un pacchetto diventano comandi vocali che l'assistente può utilizzare. La disattivazione di un pacchetto rimuove immediatamente le sue azioni; le sue impostazioni vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パックのアクションはアシスタントが使用できる音声コマンドになります。パックをオフにすると、そのアクションは即座に削除されますが、設定は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팩의 동작은 보조자가 사용할 수 있는 음성 명령이 됩니다. 팩을 끄면 해당 작업이 즉시 제거됩니다. 해당 설정이 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De acties van een roedel worden spraakopdrachten die de assistent kan gebruiken. Als je een pakket uitschakelt, worden de acties onmiddellijk verwijderd; de instellingen blijven behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As ações de um pacote tornam-se comandos de voz que o assistente pode usar. Desligar um pacote remove suas ações imediatamente; suas configurações são mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действия набора становятся голосовыми командами, которые может использовать ассистент. Отключение набора сразу удаляет его действия; настройки при этом сохраняются."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی پیک کے ایکشنز وہ صوتی کمانڈز بن جاتے ہیں جو اسسٹنٹ استعمال کر سکتا ہے۔ پیک بند کرنے سے اس کے ایکشنز فوراً ہٹ جاتے ہیں؛ اس کی ترتیبات برقرار رہتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个包的动作会成为助手可以使用的语音命令。关闭一个包会立即移除其动作；其设置会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一組動作會成為助理可以使用的語音指令。關閉一組動作會立即移除其所有動作；其設定則會保留。"
          }
        }
      }
    },
    "A photo is captured first, then this prompt is sent to the AI along with the image." : {
      "comment" : "A description of how the prompt is used with a photo.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم التقاط الصورة أولاً، ثم يتم إرسال هذه المطالبة إلى الذكاء الاصطناعي مع الصورة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se captura una foto y luego este prompt se envía a la IA junto con la imagen."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une photo est d'abord prise, puis cette invite est envoyée à l'IA avec l'image."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először egy fénykép készül, majd ezt a promptot a képpel együtt elküldi az AI-nak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima viene scattata una foto, quindi questo messaggio viene inviato all'intelligenza artificiale insieme all'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず写真が撮影され、その後、このプロンプトが画像と一緒にAIに送られます。"
