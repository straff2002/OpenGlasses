        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھانسی، تالی یا سیٹی اسسٹنٹ کو شروع کرتی ہے۔ فعال ہونے پر مائیکروفون مسلسل استعمال ہوتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
