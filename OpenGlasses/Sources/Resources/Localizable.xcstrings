    "Medical local-only is on, and every choice for this job leaves the phone, so it is off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع «المحلي فقط» الطبي قيد التشغيل، وكل خيار لهذه المهمة يغادر الهاتف، لذا فهي متوقفة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo solo local (médico) está activado y todas las opciones de esta tarea salen del celular, así que está desactivada."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode local seulement (médical) est activé et tous les choix de cette tâche quittent le téléphone, elle est donc désactivée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az orvosi csak helyi mód be van kapcsolva, és ennek a feladatnak minden választási lehetősége elhagyja a telefont, ezért ki van kapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità solo locale (medico) è attiva e ogni scelta per questo compito esce dal telefono, quindi è disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医療ローカル専用がオンで、このロールの選択肢はすべてiPhoneの外に出るため、オフになっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의료 로컬 전용이 켜져 있고 이 역할의 모든 선택지가 휴대전화 밖으로 나가므로 꺼져 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medisch alleen-lokaal staat aan en elke keuze voor deze taak verlaat de telefoon, dus deze staat uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo somente local (médico) está ativado e todas as opções desta tarefa saem do telefone, então ela está desativada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медицинский режим «только локально» включён, а все варианты для этой задачи покидают телефон, поэтому она выключена."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میڈیکل لوکل-اونلی آن ہے، اور اس کام کا ہر انتخاب فون سے باہر جاتا ہے، اس لیے یہ آف ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已开启医疗仅限本地，而此角色的所有选项都会离开手机，因此已关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已開啟醫療僅限本機，而此角色的所有選項都會離開手機，因此已關閉。"
          }
        }
      }
    },
    "Medical local-only is on, so only choices that stay on this phone are listed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع «المحلي فقط» الطبي قيد التشغيل، لذا لا تُعرض إلا الخيارات التي تبقى على هذا الهاتف."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo solo local (médico) está activado, así que solo se muestran las opciones que se quedan en este celular."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode local seulement (médical) est activé, seuls les choix qui restent sur ce téléphone sont donc affichés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az orvosi csak helyi mód be van kapcsolva, ezért csak a telefonon maradó lehetőségek jelennek meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità solo locale (medico) è attiva, quindi sono elencate solo le scelte che restano su questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医療ローカル専用がオンのため、このiPhone内にとどまる選択肢のみが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의료 로컬 전용이 켜져 있어 이 휴대전화에 남는 선택지만 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medisch alleen-lokaal staat aan, dus alleen keuzes die op deze telefoon blijven worden getoond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
