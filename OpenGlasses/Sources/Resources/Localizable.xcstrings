        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신이 말한 내용은 여전히 대화에 있습니다. 대화를 삭제하려면 해당 대화를 삭제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het staat nog steeds in het gesprek waar je het zei. Verwijder dat gesprek om het daar te verwijderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
