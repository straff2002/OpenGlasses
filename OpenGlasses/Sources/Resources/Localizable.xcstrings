    "Asked for by voice. These need a composer, which only opens on the phone — so nothing has gone yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلب بالصوت. هذه تحتاج إلى ملحن، والذي يفتح فقط على الهاتف - لذلك لم يحدث شيء حتى الآن."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pidieron por voz. Necesitan un redactor, que solo se abre en el celular, así que todavía no se ha enviado nada."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandé par la voix. Ceux-ci ont besoin d'un compositeur, qui ne s'ouvre que sur le téléphone — donc rien n'a encore été fait."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangon kérték. Ezekhez zeneszerző kell, ami csak a telefonon nyílik meg – tehát még semmi sem ment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesto a voce. Questi hanno bisogno di un compositore, che si apre solo sul telefono, quindi non è ancora andato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声で要求されました。これには作曲者が必要で、作曲者は電話でのみ開くため、まだ何も完了していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성으로 요청했습니다. 여기에는 전화로만 열리는 작곡가가 필요하므로 아직 아무것도 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met stem gevraagd. Deze hebben een componist nodig, die alleen op de telefoon wordt geopend - er is dus nog niets verdwenen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado por voz. Eles precisam de um compositor, que só abre no telefone — então nada aconteceu ainda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрошено голосом. Для этого нужен редактор письма, который открывается только на телефоне, — поэтому ничего ещё не отправлено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آواز کے ذریعے درخواست کی گئی۔ ان کے لیے کمپوزر درکار ہے، جو صرف فون پر کھلتا ہے — اس لیے ابھی کچھ نہیں گیا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过语音请求。这些需要一个作曲器，该作曲器只能在手机上打开——所以什么都还没开始"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以語音方式提出。這些需要作曲器，而作曲器僅在手機上打開——所以目前尚未完成任何操作。"
          }
        }
      }
    },
