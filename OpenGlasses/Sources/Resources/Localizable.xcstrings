          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientação prática e baseada no domínio para engenheiros de campo: carregue um cofre de conhecimento e execute sessões auditadas e fundamentadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовые, предметно-обоснованные подсказки для выездных инженеров без использования рук — загрузите хранилище знаний и проводите проверенные, протоколируемые сеансы."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیلڈ انجینئرز کے لیے ہاتھ استعمال کیے بغیر، شعبے پر مبنی رہنمائی — نالج والٹ لوڈ کریں اور مستند، آڈٹ شدہ سیشنز چلائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
