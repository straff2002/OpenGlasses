    "%@ is out of credit, so replies use another voice. Change voices in Settings › Connections › Services & Integrations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رصيد %@ نفد، لذا تستخدم الردود صوتًا آخر. غيّر الأصوات في الإعدادات › الاتصالات › الخدمات والتكاملات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se acabó el crédito de %@, así que las respuestas usan otra voz. Cambia de voz en Configuración › Conexiones › Servicios e integraciones."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est à court de crédit, donc les réponses utilisent une autre voix. Changez de voix dans Réglages › Connexions › Services et intégrations."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ hitelkerete elfogyott, ezért a válaszok másik hangot használnak. A hangokat itt módosíthatja: Beállítások › Kapcsolatok › Szolgáltatások és integrációk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha esaurito il credito, quindi per le risposte viene utilizzata un’altra voce. Cambia le voci in Impostazioni › Connessioni › Servizi e integrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のクレジットが不足しているため、返信は別の音声を使用します。音声は設定 › 接続 › サービスと連携で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 크레딧이 소진되어 답변에 다른 음성이 사용됩니다. 음성은 설정 › 연결 › 서비스 및 연동에서 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het tegoed van %@ is op, dus antwoorden gebruiken een andere stem. Wijzig stemmen in Instellingen › Verbindingen › Diensten en integraties."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está sem crédito, então as respostas usam outra voz. Altere as vozes em Configurações › Conexões › Serviços e integrações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кредит %@ исчерпан, поэтому ответы звучат другим голосом. Сменить голос можно в разделе «Настройки › Подключения › Сервисы и интеграции»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کا کریڈٹ ختم ہو گیا ہے، اس لیے جوابات کسی دوسری آواز میں ہیں۔ آوازیں ترتیبات › کنکشنز › سروسز اور انٹیگریشنز میں تبدیل کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已无信用，因此回复使用其他语音。可在设置 › 连接 › 服务与集成中更改语音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 沒有剩餘信用，因此回覆會使用其他語音。在 設定 › 連線 › 服務與整合 中更改語音。"
          }
        }
      }
    },
