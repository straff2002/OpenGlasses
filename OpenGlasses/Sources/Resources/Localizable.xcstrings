          }
        }
      }
    },
    "The Workiz key could not be saved. Check administrator access and unlock this phone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر حفظ مفتاح Workiz. تحقق من صلاحية المسؤول وافتح قفل هذا الهاتف."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la clave de Workiz. Revisa el acceso de administrador y desbloquea este celular."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé Workiz n’a pas pu être enregistrée. Vérifiez l’accès administrateur et déverrouillez ce téléphone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Workiz-kulcsot nem sikerült menteni. Ellenőrizze a rendszergazdai hozzáférést, és oldja fel a telefont."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile salvare la chiave Workiz. Controlla l'accesso amministratore e sblocca questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workizのキーを保存できませんでした。管理者アクセスを確認し、このiPhoneのロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workiz 키를 저장할 수 없습니다. 관리자 접근 권한을 확인하고 이 휴대전화의 잠금을 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
