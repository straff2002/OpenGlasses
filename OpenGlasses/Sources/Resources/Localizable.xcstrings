            "value" : "يُبقي الوضع التلقائي أدوار الأدوات على Chat Completions دون استدلال، للحفاظ على السرعة والتكلفة المنخفضة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
