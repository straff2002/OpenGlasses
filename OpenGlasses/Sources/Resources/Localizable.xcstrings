    "Download a model first, then select it here. No internet needed after download." : {
      "comment" : "A footer in the Local Model section of the ModelFormView, explaining that users can download models and then select them from the list.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتنزيل نموذج أولاً، ثم اختره هنا. لا حاجة للإنترنت بعد التنزيل."
