    "Phone transport identity is unavailable in this build. Use an Avenkin transport-enabled build." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هوية نقل الهاتف غير متاحة في هذا الإصدار. استخدم إصدار Avenkin الذي يدعم النقل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La identidad de transporte del celular no está disponible en esta compilación. Usa una compilación de Avenkin con transporte habilitado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identité de transport du téléphone n’est pas disponible dans cette version. Utilisez une version d’Avenkin avec transport activé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telefon szállítási azonosítója nem érhető el ebben a buildben. Használjon Avenkin szállítás-képes buildet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'identità di trasporto del telefono non è disponibile in questa build. Usa una build di Avenkin con il trasporto abilitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドでは、電話のトランスポートIDを利用できません。Avenkinのトランスポート対応ビルドを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드에서는 휴대전화 전송 ID를 사용할 수 없습니다. 전송이 활성화된 Avenkin 빌드를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De telefoontransportidentiteit is niet beschikbaar in deze build. Gebruik een Avenkin-build met transport ingeschakeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A identidade de transporte do telefone não está disponível nesta versão. Use uma versão do Avenkin com transporte ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идентификация транспорта телефона недоступна в этой сборке. Используйте сборку Avenkin с поддержкой транспорта."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس بلڈ میں فون ٹرانسپورٹ آئیڈنٹٹی دستیاب نہیں ہے۔ Avenkin کا ٹرانسپورٹ سے لیس بلڈ استعمال کریں۔"
