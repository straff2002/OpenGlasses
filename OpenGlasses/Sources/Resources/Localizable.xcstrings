    "During a Field Assist job, only field tools are offered to the model, which cuts cost per request. Turn off to offer every tool." : {
      "comment" : "Text describing the field assist mode.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلال مهمة Field Assist، يتم تقديم الأدوات الميدانية فقط للنموذج، مما يقلل تكلفة كل طلب. قم بإيقاف التشغيل لتقديم كل الأدوات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante un trabajo de Field Assist, solo se ofrecen al modelo las herramientas de campo, lo que reduce el costo por solicitud. Desactívalo para ofrecer todas las herramientas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant un travail Field Assist, seuls les outils de terrain sont proposés au modèle, ce qui réduit le coût par demande. Désactivez pour proposer tous les outils."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Field Assist munkák során csak terepi szerszámokat kínálnak a modellhez, ami csökkenti a kérésenkénti költséget. Kapcsolja ki az összes eszköz felajánlásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante un lavoro Field Assist, al modello vengono offerti solo gli strumenti da campo, riducendo così i costi per richiesta. Disattiva per offrire ogni strumento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assist ジョブ中は、モデルに対してフィールドツールのみが提供され、リクエストごとのコストが削減されます。すべてのツールを提供するにはオフにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assist 작업 중에는 현장 도구만 모델에 제공되므로 요청당 비용이 절감됩니다. 모든 도구를 제공하려면 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens een Field Assist-taak worden alleen veldgereedschappen aan het model aangeboden, waardoor de kosten per aanvraag worden verlaagd. Schakel uit om elk hulpmiddel aan te bieden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante um trabalho Field Assist, apenas ferramentas de campo são oferecidas ao modelo, o que reduz o custo por solicitação. Desligue para oferecer todas as ferramentas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время задания Field Assist модели предлагаются только полевые инструменты, что снижает стоимость каждого запроса. Выключите, чтобы предлагать все инструменты."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field Assist جاب کے دوران، ماڈل کو صرف فیلڈ ٹولز پیش کیے جاتے ہیں، جس سے فی درخواست لاگت کم ہوتی ہے۔ تمام ٹولز پیش کرنے کے لیے اسے آف کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Field Assist 任务期间，仅向模型提供现场工具，可降低每次请求的成本。关闭以提供所有工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Field Assist 工作期間，模型僅提供現場工具，以降低每次請求的成本。關閉此選項可提供所有工具。"
          }
        }
      }
    },
    "During quiet hours, confirm before sending any message." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء الساعات الهادئة، أكّد قبل إرسال أي رسالة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante las horas de silencio, confirma antes de enviar cualquier mensaje."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant les heures de silence, confirmez avant d’envoyer tout message."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csendes órák alatt minden üzenet elküldése előtt kérjen megerősítést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante le ore di silenzio, chiedi conferma prima di inviare qualsiasi messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かな時間の間は、メッセージを送信する前に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방해 금지 시간에는 메시지를 보내기 전에 확인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestig tijdens stille uren eerst voordat u een bericht verstuurt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante o horário de silêncio, confirme antes de enviar qualquer mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В тихие часы подтверждайте перед отправкой любого сообщения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاموش اوقات کے دوران کوئی بھی پیغام بھیجنے سے پہلے تصدیق کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在静音时段，发送任何消息前先确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在安靜時段內，傳送任何訊息前都要先確認。"
          }
        }
      }
    },
    "During this window the quiet-hours rule confirms before any message is sent." : {
      "comment" : "A description of the quiet-hours rule.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلال هذه النافذة، قاعدة ساعات الصمت تؤكد قبل إرسال أي رسالة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante este periodo, la regla de horas de silencio pide confirmación antes de enviar cualquier mensaje."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant cette période, la règle des heures de silence confirme avant l'envoi de tout message."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebben az ablakban a csendes órák szabálya megerősíti, mielőtt üzenetet küldene."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante questa finestra la regola delle ore di silenzio viene confermata prima dell'invio di qualsiasi messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウィンドウ中は、サイレント時間ルールがメッセージ送信前に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기간 동안 메시지가 전송되기 전에 조용한 시간 규칙이 확인됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens deze periode wordt de regel voor rustige uren bevestigd voordat er een bericht wordt verzonden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante esta janela, a regra do horário de silêncio é confirmada antes de qualquer mensagem ser enviada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
