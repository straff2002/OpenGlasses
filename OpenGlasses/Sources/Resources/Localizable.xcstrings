    "Editing a built-in prompt makes it your own copy, safe from app updates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحرير موجه مدمج يجعله نسختك الخاصة، آمن من تحديثات التطبيق."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar un prompt integrado crea tu propia copia, a salvo de las actualizaciones de la app."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier une invite intégrée en fait votre propre copie, à l'abri des mises à jour de l'application."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beépített prompt szerkesztésével saját másolatot készíthet az alkalmazásfrissítésektől."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica di un prompt integrato ne fa una tua copia, al sicuro dagli aggiornamenti dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みプロンプトを編集すると、自分専用のコピーになり、アプリのアップデートから保護されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장된 프롬프트를 편집하면 앱 업데이트로부터 안전한 나만의 복사본이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door een ingebouwde prompt te bewerken, wordt het uw eigen kopie, beschermd tegen app-updates."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A edição de um prompt integrado torna-o sua própria cópia, protegida contra atualizações de aplicativos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактирование встроенного промпта создаёт вашу собственную копию, которую не затронут обновления приложения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی بلٹ اِن پرامپٹ میں ترمیم کرنے سے وہ آپ کی اپنی نقل بن جاتا ہے، جو ایپ اپ ڈیٹس سے محفوظ رہتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
