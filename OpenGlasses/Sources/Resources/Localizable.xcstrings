    "New jobs start on this vault. A vault can link its own model, used only while a job is running." : {
      "comment" : "A description of the vault's model.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ وظائف جديدة في هذا الخزنة. يمكن للخزنة ربط نموذجها الخاص، يُستخدم فقط أثناء تشغيل وظيفة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los trabajos nuevos empiezan con esta bóveda. Una bóveda puede vincular su propio modelo, que se usa solo mientras hay un trabajo en curso."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux travaux commencent dans ce coffre. Un coffre peut lier son propre modèle, utilisé uniquement pendant l'exécution d'un travail."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Új munkák indulnak ezen a trezoron. A tároló összekapcsolhatja saját modelljét, amelyet csak egy job futása közben használnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuovi lavori iniziano in questo caveau. Un deposito può collegare il proprio modello, utilizzato solo durante l'esecuzione di un lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボールトで新しいジョブが始まります。ボールトは自分のモデルをリンクでき、ジョブ実行中のみ使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 저장소에서 새 작업이 시작됩니다. Vault는 작업이 실행되는 동안에만 사용되는 자체 모델을 연결할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe banen starten op deze kluis. Een kluis kan zijn eigen model koppelen, dat alleen wordt gebruikt terwijl een taak wordt uitgevoerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos trabalhos começam neste cofre. Um vault pode vincular seu próprio modelo, usado apenas enquanto um trabalho está em execução."
          }
