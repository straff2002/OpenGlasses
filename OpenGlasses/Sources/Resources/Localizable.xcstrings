            "value" : "離線模式"
          }
        }
      }
    },
    "Offline Mode hides every tool that needs the internet — handy on planes or in poor coverage. The AI itself still works if you can reach it." : {
      "comment" : "A description of the offline mode feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн-режим скрывает все инструменты, которым нужен интернет — удобно в самолёте или при плохом покрытии. Сам ИИ по-прежнему работает, если до него можно достучаться."
          }
        }
      }
    },
    "Offline Model" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн-модель"
