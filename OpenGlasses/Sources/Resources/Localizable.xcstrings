    "Epic uses SMART on FHIR. Obtain a bearer token from your Epic administrator." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدامات Epic لتقنية SMART على FHIR. احصل على رمز الوصول من مسؤول Epic الخاص بك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic usa SMART on FHIR. Pídele un token Bearer a tu administrador de Epic."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic utilise SMART sur FHIR. Obtenez un jeton d'accès auprès de votre administrateur Epic."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Epic a SMART-ot használja a FHIR-en. Szerezzen be egy hordozó tokent az Epic rendszergazdától."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic utilizza SMART su FHIR. Ottieni un token al portatore dal tuo amministratore Epic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic は SMART on FHIR を使用します。Epic 管理者からベアラートークンを取得してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic은 FHIR에서 SMART를 사용합니다. Epic 관리자로부터 Bearer 토큰을 받으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic gebruikt SMART op FHIR. Vraag een dragertoken aan bij uw Epic-beheerder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Epic usa SMART no FHIR. Obtenha um token ao portador do seu administrador Epic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic использует SMART on FHIR. Получите токен доступа (bearer token) у администратора Epic."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic، SMART on FHIR استعمال کرتا ہے۔ اپنے Epic ایڈمنسٹریٹر سے bearer ٹوکن حاصل کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
