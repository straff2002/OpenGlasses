    "This job file uses format version %lld, which this version of the app can't read. Update the app, or ask the office to send it in an earlier format." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم ملف المهمة هذا الإصدار %lld من التنسيق، ولا يستطيع هذا الإصدار من التطبيق قراءته. حدّث التطبيق، أو اطلب من المكتب إرساله بتنسيق أقدم."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo de trabajo usa la versión de formato %lld, que esta versión de la app no puede leer. Actualiza la app o pide a la oficina que lo envíe en un formato anterior."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier de travail utilise la version de format %lld, que cette version de l’application ne peut pas lire. Mettez à jour l’application, ou demandez au bureau de l’envoyer dans un format antérieur."
