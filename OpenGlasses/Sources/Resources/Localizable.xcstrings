    "Play, pause, skip, and ask what's playing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل وأوقف مؤقتًا وتخطَّ واسأل عمّا يُشغَّل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce, pausa, salta y pregunta qué está sonando."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez, mettez en pause, passez au suivant et demandez ce qui joue."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejátszás, szünet, ugrás, és rákérdezés, mi szól éppen."
