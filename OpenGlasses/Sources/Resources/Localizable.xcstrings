    },
    "Turn-by-turn pedestrian directions on the HUD — “navigate to…”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاتجاهات التكيفية للمشاة على HUD — \"توجه إلى...\"."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
