    },
    "Runs once a day, the first time the assistant checks after midnight." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل مرة في اليوم، أول مرة يفحص فيها المساعد بعد منتصف الليل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta una vez al día, la primera vez que el asistente revisa después de la medianoche."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’exécute une fois par jour, la première fois que l’assistant vérifie après minuit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naponta egyszer fut, amikor az asszisztens éjfél után először ellenőriz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eseguito una volta al giorno, la prima volta che l’assistente controlla dopo la mezzanotte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日1回、午前0時を過ぎてアシスタントが最初に確認するときに実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 한 번, 자정이 지난 뒤 어시스턴트가 처음 확인할 때 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt één keer per dag uitgevoerd, de eerste keer dat de assistent na middernacht controleert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa uma vez por dia, na primeira vez em que o assistente verifica depois da meia-noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняется раз в день — при первой проверке ассистента после полуночи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دن میں ایک بار چلتا ہے، آدھی رات کے بعد پہلی بار جب اسسٹنٹ جانچ کرے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天运行一次，在午夜之后助手第一次检查时运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天執行一次，在午夜之後助理第一次檢查時執行。"
          }
        }
      }
    },
    "Runs once when the agent starts each day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجري مرة واحدة عند بدء الوكيل كل يوم."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta una vez al día, cuando el agente inicia."
          }
        },
        "fr-CA" : {
