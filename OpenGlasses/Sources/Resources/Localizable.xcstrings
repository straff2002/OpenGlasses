        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前はすべてのスプレッドシートに記載されるため、拠点と次のシフトの担当者がどの車両か分かります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이름은 모든 스프레드시트에 기재되므로 본부와 다음 교대 근무자가 어느 차량인지 알 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
