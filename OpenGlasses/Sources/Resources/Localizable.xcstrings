    "\"%@\" is removed from the grid, the widget, the watch and the in-lens launcher." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إزالة «%@» من الشبكة والودجت والساعة ومشغّل داخل العدسة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" se quita de la cuadrícula, del widget, del reloj y del lanzador en los lentes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est retiré de la grille, du widget, de la montre et du lanceur intégré aux verres."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” el lesz távolítva a rácsból, a widgetből, az órából és a lencsén belüli indítóból."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» viene rimosso dalla griglia, dal widget, dall'orologio e dal launcher nelle lenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はグリッド、ウィジェット、Watch、レンズ内ランチャーから削除されます。"
