        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자격 증명을 지웠습니다. 공유를 기다리던 내보내기도 함께 지웠습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
