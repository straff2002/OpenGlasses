    "Validates the flow and exports its JSON. Save it into a vault's flows/ folder (via Vault import) to run it with the capture_flow tool." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بالتحقق من صحة التدفق وتصديره بصيغة JSON. احفظه في مجلد flows/ الخاص بالخزنة (عبر استيراد الخزنة) لتشغيله باستخدام أداة capture_flow."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valida el flujo y exporta su JSON. Guárdalo en la carpeta flows/ de una bóveda (mediante la importación de bóvedas) para ejecutarlo con la herramienta capture_flow."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valide le flux et exporte son JSON. Enregistrez-le dans le dossier flows/ d'un coffre (via l'importation de Vault) pour l'exécuter avec l'outil capture_flow."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érvényesíti a folyamatot és exportálja annak JSON-ját. Mentsd el egy tároló flows/ mappájába (tároló importálása révén), hogy a capture_flow eszközzel futtathasd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convalida il flusso ed esporta il relativo JSON. Salvarlo nella cartella/flow di un Vault (tramite l'importazione di Vault) per eseguirlo con lo strumento capture_flow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローを検証し、その JSON をエクスポートします。キャプチャフロー ツールで実行するには、Vault の flows/ フォルダに保存してください（Vault インポート経由）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흐름을 검증하고 해당 JSON을 내보냅니다. Capture_flow 도구로 실행하려면 Vault의 flow/ 폴더에 저장하세요(Vault 가져오기를 통해)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valideert de stroom en exporteert de JSON. Bewaar het in de flows/ map van een kluis (via Kluis import) om het uit te voeren met het capture_flow gereedschap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valida o fluxo e exporta seu JSON. Salve-o na pasta flows/ de um cofre (via importação de Cofre) para executá-lo com a ferramenta capture_flow."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет поток и экспортирует его JSON. Сохраните его в папку flows/ хранилища (через импорт хранилища), чтобы запускать его инструментом capture_flow."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فلو کی توثیق کرتا ہے اور اس کا JSON ایکسپورٹ کرتا ہے۔ اسے capture_flow ٹول سے چلانے کے لیے کسی والٹ کے flows/ فولڈر میں محفوظ کریں (Vault امپورٹ کے ذریعے)۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证流程并导出其 JSON。将其保存到保险库的 flows/ 文件夹中（通过保险库导入）以使用 capture_flow 工具运行它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證流程並導出其 JSON。將其保存到金庫的 flows/ 資料夾中（透過金庫導入）以便使用 capture_flow 工具執行。"
          }
        }
      }
    },
