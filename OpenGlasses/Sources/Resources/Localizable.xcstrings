    "Managed by %@. Next, choose the AI provider your organisation uses." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدار بواسطة %1$@. بعد ذلك، اختر مزود الذكاء الاصطناعي الذي تستخدمه مؤسستك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrado por %@. Ahora elige el proveedor de IA que usa tu organización."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Géré par %1$@. Ensuite, choisissez le fournisseur d'IA utilisé par votre organisation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezelő: %1$@. Ezután válassza ki a szervezete által használt AI-szolgáltatót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestito da %1$@. Successivamente, scegli il provider di intelligenza artificiale utilizzato dalla tua organizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@によって管理されています。次に、組織が使用するAIプロバイダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 관리합니다. 다음으로, 조직에서 사용하는 AI 공급자를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheerd door %1$@. Kies vervolgens de AI-provider die uw organisatie gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerenciado por %1$@. Em seguida, escolha o provedor de IA que sua organização usa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляется через %@. Далее выберите провайдера ИИ, которого использует ваша организация."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کے زیرِ انتظام۔ اب وہ AI فراہم کنندہ منتخب کریں جو آپ کی تنظیم استعمال کرتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %1$@ 管理。接下来，选择您的组织使用的 AI 提供商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %1$@ 管理。接下來，選擇您的組織使用的 AI 提供者。"
          }
        }
      }
    },
    "Managed by %@. Your organisation chose the AI model, so there is nothing to pick." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدار بواسطة %1$@. اختارت مؤسستك نموذج الذكاء الاصطناعي، لذلك لا يوجد ما تختاره."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrado por %@. Tu organización eligió el modelo de IA, así que no hay nada que elegir."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Géré par %1$@. Votre organisation a choisi le modèle d'IA, il n'y a donc rien à sélectionner."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezelő: %1$@. Az Ön szervezete az AI modellt választotta, így nincs mit választani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestito da %1$@. La tua organizzazione ha scelto il modello AI, quindi non c'è nulla da scegliere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@によって管理されています。組織がAIモデルを選択したため、選ぶ必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 관리합니다. 귀하의 조직에서는 AI 모델을 선택했으므로 선택할 것이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheerd door %1$@. Uw organisatie heeft voor het AI-model gekozen, dus er valt niets te kiezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerenciado por %1$@. Sua organização escolheu o modelo de IA, então não há nada para escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляется через %@. Ваша организация уже выбрала модель ИИ, поэтому выбирать нечего."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کے زیرِ انتظام۔ آپ کی تنظیم نے AI ماڈل منتخب کر لیا ہے، اس لیے کچھ منتخب کرنے کی ضرورت نہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %1$@ 管理。您的组织已选择 AI 模型，因此无需再选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %1$@ 管理。您的組織選擇了 AI 模型，因此無需選擇。"
          }
        }
      }
    },
    "Management expired on %@, and as %@ asked, its content has been erased from this phone. Its vault pack is reinstalled when this phone reaches %@ again. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت الإدارة في %1$@، وكما طلب %2$@، تم مسح محتواها من هذا الهاتف. يُعاد تثبيت حزمة خزنتها عندما يصل هذا الهاتف إلى %3$@ مجددًا. %4$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Management expired on %1$@, and as %2$@ asked, its content has been erased from this phone. Its vault pack is reinstalled when this phone reaches %3$@ again. %4$@"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La administración venció el %1$@ y, como pidió %2$@, su contenido se borró de este celular. Su paquete de bóveda se reinstala cuando este celular vuelva a comunicarse con %3$@. %4$@"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gestion a expiré le %1$@ et, comme %2$@ l’a demandé, son contenu a été effacé de ce téléphone. Son paquet de coffre est réinstallé lorsque ce téléphone joint de nouveau %3$@. %4$@"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kezelés lejárt ekkor: %1$@, és a(z) %2$@ kérésének megfelelően a tartalma törlésre került erről a telefonról. A tároló csomagja újra telepítésre kerül, amikor ez a telefon ismét eléri ezt: %3$@. %4$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gestione è scaduta il %1$@ e, come richiesto da %2$@, il suo contenuto è stato cancellato da questo telefono. Il suo pacchetto di depositi viene reinstallato quando questo telefono raggiunge di nuovo %3$@. %4$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に管理が失効しました。%2$@の依頼により、そのコンテンツはこのiPhoneから消去されました。このiPhoneが再び%3$@に到達すると、そのボールトパックが再インストールされます。%4$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 관리가 만료되었으며, %2$@의 요청에 따라 해당 콘텐츠가 이 휴대전화에서 삭제되었습니다. 이 휴대전화가 %3$@에 다시 연결되면 볼트 팩이 다시 설치됩니다. %4$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het beheer is verlopen op %1$@ en, zoals %2$@ heeft gevraagd, is de inhoud van deze telefoon gewist. Het kluispakket wordt opnieuw geïnstalleerd wanneer deze telefoon %3$@ weer bereikt. %4$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gestão expirou em %1$@ e, a pedido de %2$@, o conteúdo dela foi apagado deste telefone. O pacote de cofre é reinstalado quando este telefone alcançar %3$@ novamente. %4$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управление истекло %1$@, и по запросу %2$@ его содержимое стёрто с этого телефона. Пакет его хранилищ будет установлен заново, когда этот телефон снова свяжется с %3$@. %4$@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ کو انتظام کی مدت ختم ہو گئی، اور جیسا کہ %2$@ نے کہا تھا، اس کا مواد اس فون سے مٹا دیا گیا ہے۔ جب یہ فون دوبارہ %3$@ تک پہنچے گا تو اس کا والٹ پیک دوبارہ انسٹال ہو جائے گا۔ %4$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理已于 %1$@ 到期，并且按 %2$@ 的要求，其内容已从这部手机中清除。当这部手机再次连接到 %3$@ 时，会重新安装其保险库包。%4$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理已於 %1$@ 到期，並依 %2$@ 的要求，其內容已從這支手機清除。這支手機再次連上 %3$@ 時，會重新安裝其保險庫套件。%4$@"
          }
        }
      }
    },
    "Management expired on %@. %@'s content is locked%@, and %@ has asked for it to be erased on %@ if it has not been renewed by then." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت الإدارة في %1$@. محتوى %2$@ مقفل%3$@، وقد طلب %4$@ مسحه في %5$@ إذا لم يُجدَّد بحلول ذلك الوقت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Management expired on %1$@. %2$@'s content is locked%3$@, and %4$@ has asked for it to be erased on %5$@ if it has not been renewed by then."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La administración venció el %1$@. El contenido de %2$@ está bloqueado%3$@, y %4$@ pidió que se borre el %5$@ si para entonces no se ha renovado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gestion a expiré le %1$@. Le contenu de %2$@ est verrouillé%3$@, et %4$@ a demandé qu’il soit effacé le %5$@ s’il n’a pas été renouvelé d’ici là."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kezelés lejárt ekkor: %1$@. A(z) %2$@ tartalma zárolva van%3$@, és a(z) %4$@ kérte annak törlését ekkor: %5$@, ha addig nem újítják meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gestione è scaduta il %1$@. Il contenuto di %2$@ è bloccato%3$@ e %4$@ ha chiesto di cancellarlo il %5$@ se non sarà stato rinnovato entro quella data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に管理が失効しました。%2$@のコンテンツはロックされており%3$@、更新されない場合は%5$@に消去するよう%4$@から求められています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 관리가 만료되었습니다. %2$@의 콘텐츠는 잠겨 있으며%3$@, 그때까지 갱신되지 않으면 %5$@에 삭제하도록 %4$@이(가) 요청했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het beheer is verlopen op %1$@. De inhoud van %2$@ is vergrendeld%3$@, en %4$@ heeft gevraagd deze op %5$@ te wissen als het tegen die tijd niet is verlengd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gestão expirou em %1$@. O conteúdo de %2$@ está bloqueado%3$@, e %4$@ pediu que seja apagado em %5$@ se não for renovado até lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управление истекло %1$@. Содержимое %2$@ заблокировано%3$@; по запросу %4$@ оно будет стёрто %5$@, если к тому времени управление не будет продлено."
