        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ остаётся на этом телефоне, в Связке ключей. Он никогда не отправляется по адресу профиля %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید اسی فون پر، Keychain میں رہتی ہے۔ یہ کبھی %@ کے پروفائل پتے پر نہیں بھیجی جاتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥保存在此电话的钥匙串中。它永远不会发送到%1$@的个人资料地址。"
