        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nova-3 обеспечивает наиболее точную диаризацию. Потоковая передача тарифицируется за минуту аудио."
          }
        },
        "ur" : {
          "stringUnit" : {
