    "Manual removed from this vault. “%@” is no longer on this device; earlier answers may still quote it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُزيل الكتيب من هذه الخزنة. لم يعد «%@» على هذا الجهاز؛ وقد تظل الإجابات السابقة تقتبس منه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manual quitado de esta bóveda. “%@” ya no está en este dispositivo; es posible que respuestas anteriores todavía lo citen."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuel retiré de ce coffre. « %@ » n’est plus sur cet appareil; les réponses précédentes peuvent encore le citer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kézikönyv el lett távolítva ebből a tárolóból. A(z) „%@” már nincs ezen az eszközön; a korábbi válaszok még idézhetik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuale rimosso da questo deposito. «%@» non è più su questo dispositivo; le risposte precedenti potrebbero ancora citarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボールトからマニュアルを削除しました。「%@」はこのデバイスにはなくなりましたが、以前の回答にはまだ引用されている場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 볼트에서 매뉴얼이 제거되었습니다. “%@”은(는) 더 이상 이 기기에 없지만, 이전 답변에서는 계속 인용될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handleiding uit deze kluis verwijderd. “%@” staat niet meer op dit apparaat; eerdere antwoorden kunnen het nog citeren."
          }
