    "Find the workspace ID on its details page in the Model Studio console. Beijing and Singapore workspaces have separate IDs and keys." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجد معرّف مساحة العمل في صفحة تفاصيلها في وحدة تحكم Model Studio. لمساحات العمل في بكين وسنغافورة معرّفات ومفاتيح منفصلة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra el ID del espacio de trabajo en su página de detalles en la consola de Model Studio. Los espacios de Beijing y Singapur tienen ID y claves distintos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identifiant de l’espace de travail se trouve sur sa page de détails dans la console Model Studio. Les espaces de Pékin et de Singapour ont des identifiants et des clés distincts."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munkaterület azonosítója a Model Studio konzolon, a munkaterület részletei oldalon található. A pekingi és a szingapúri munkaterületek azonosítói és kulcsai különbözőek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trovi l’ID dell’area di lavoro nella sua pagina dei dettagli nella console di Model Studio. Le aree di Pechino e di Singapore hanno ID e chiavi separati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペース ID は、Model Studio コンソールのワークスペース詳細ページで確認できます。北京とシンガポールのワークスペースは ID もキーも別々です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 공간 ID는 Model Studio 콘솔의 작업 공간 세부 정보 페이지에서 확인할 수 있습니다. 베이징과 싱가포르 작업 공간은 ID와 키가 서로 다릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vindt de werkruimte-ID op de detailpagina van de werkruimte in de Model Studio-console. Werkruimten in Beijing en Singapore hebben aparte ID’s en sleutels."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre o ID do espaço de trabalho na página de detalhes dele no console do Model Studio. Os espaços de Pequim e de Singapura têm IDs e chaves separados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID рабочей области указан на её странице сведений в консоли Model Studio. У рабочих областей в Пекине и Сингапуре разные ID и ключи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورک اسپیس ID، Model Studio کنسول میں اس کی تفصیلات کے صفحے پر ملتی ہے۔ بیجنگ اور سنگاپور کے ورک اسپیسز کی ID اور کلیدیں الگ الگ ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Model Studio 控制台中工作空间的详情页面可以找到其 ID。北京和新加坡的工作空间 ID 和密钥各不相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
