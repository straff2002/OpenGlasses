          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea, modifica e organizza le azioni nella scheda Voce: lo stesso editor aperto dalla barra stessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボイスタブでアクションを作成、編集、配置します — バー自体が開くのと同じエディタです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 탭에서 작업을 만들고, 편집하고, 정렬하세요. 바 자체에서 열리는 것과 동일한 편집기입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak, bewerk en rangschik de acties op het tabblad Stem – dezelfde editor die de balk zelf opent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça, edite e organize as ações na aba Voz — o mesmo editor que a própria barra abre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте, редактируйте и упорядочивайте действия на вкладке «Голос» — тот же редактор открывает и сама панель."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آواز ٹیب پر ایکشنز بنائیں، ان میں ترمیم کریں اور ترتیب دیں — وہی ایڈیٹر جو بار خود کھولتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在语音标签上创建、编辑和安排操作——与工具栏本身打开的编辑器相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立、編輯並安排語音標籤上的動作 —— 與工具列本身打開的編輯器相同。"
          }
        }
      }
    },
