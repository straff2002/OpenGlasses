        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadrez ce qu'il faut enregistrer pour le travail, puis prenez la photo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keretezze be, hogy mit kell naplózni a munkához, majd készítse el a fényképet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra cosa registrare per il lavoro, quindi scatta la foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作業内容として記録するものを枠に収めて、写真を撮ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업에 대해 기록할 내용을 프레임에 넣은 다음 사진을 찍습니다."
