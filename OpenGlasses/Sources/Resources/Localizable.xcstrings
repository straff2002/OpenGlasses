        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquadre o que registrar para o trabalho e tire a foto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поместите в кадр то, что нужно внести в задание, затем сделайте фото."
