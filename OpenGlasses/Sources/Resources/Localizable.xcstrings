    },
    "Automatic uses this model's lowest setting when tools are attached, to keep answers quick." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم الوضع التلقائي أدنى إعداد لهذا النموذج عند إرفاق الأدوات، للحفاظ على سرعة الإجابات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático usa el ajuste más bajo de este modelo cuando hay herramientas conectadas, para que las respuestas sean rápidas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode automatique, le réglage le plus bas du modèle est utilisé lorsque des outils sont joints, pour des réponses rapides."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus beállítás a modell legalacsonyabb szintjét használja, ha eszközök vannak csatolva, hogy a válaszok gyorsak maradjanak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Automatico si usa l'impostazione più bassa di questo modello quando sono collegati strumenti, per risposte rapide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動では、ツールが接続されているときにこのモデルの最小設定を使い、回答を速くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 도구가 연결되어 있을 때 답변을 빠르게 하기 위해 이 모델의 가장 낮은 설정을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch gebruikt de laagste instelling van dit model wanneer er tools zijn gekoppeld, zodat antwoorden snel blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo automático usa a configuração mais baixa deste modelo quando há ferramentas anexadas, para manter as respostas rápidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При использовании инструментов автоматический режим берёт минимальную настройку этой модели, чтобы ответы приходили быстро."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹولز منسلک ہونے پر خودکار حالت اس ماڈل کی کم سے کم سیٹنگ استعمال کرتی ہے تاکہ جواب تیز رہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会在附带工具时使用此模型的最低设置，以保证回答迅速。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會在附加工具時使用此模型的最低設定，以保持回答迅速。"
          }
        }
      }
    },
    "Automatically classifies each request by complexity and routes it to the right model. Simple queries like \"what time is it\" use a fast, cheap model. Complex reasoning uses your best model. Saves cost without sacrificing quality. Assign models to each tier below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصنّف تلقائيًا كل طلب بحسب تعقيده ويوجّهه إلى النموذج المناسب. تستخدم الاستعلامات البسيطة مثل «كم الساعة» نموذجًا سريعًا ورخيصًا، بينما يستخدم الاستدلال المعقد أفضل نموذج لديك. يقلل التكلفة دون التضحية بالجودة. عيّن نماذج لكل مستوى أدناه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasifica automáticamente cada solicitud por su complejidad y la envía al modelo adecuado. Las consultas simples, como \"qué hora es\", usan un modelo rápido y económico. El razonamiento complejo usa tu mejor modelo. Ahorra costos sin sacrificar calidad. Asigna modelos a cada nivel más abajo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classe automatiquement chaque demande selon sa complexité et l’achemine vers le bon modèle. Les requêtes simples comme « quelle heure est-il » utilisent un modèle rapide et économique. Le raisonnement complexe utilise votre meilleur modèle. Réduit les coûts sans sacrifier la qualité. Attribuez des modèles à chaque niveau ci-dessous."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden kérést összetettség szerint besorol, és a megfelelő modellhez irányít. Az egyszerű kérdések, például a „hány óra van”, gyors, olcsó modellt használnak. Az összetett érvelés a legjobb modelljét. Költséget takarít meg a minőség feláldozása nélkül. Rendeljen modellt az egyes szintekhez lent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifica automaticamente ogni richiesta in base alla complessità e la instrada al modello giusto. Le domande semplici come «che ore sono» usano un modello veloce ed economico. Il ragionamento complesso usa il tuo modello migliore. Fai risparmiare senza rinunciare alla qualità. Assegna un modello a ogni livello qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各リクエストの複雑さを自動で判定し、適切なモデルに振り分けます。「今何時」のような簡単な質問には、高速で低コストなモデルを使います。複雑な推論には最良のモデルを使います。品質を落とさずにコストを節約できます。下で各段階にモデルを割り当ててください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 요청의 복잡도를 자동으로 분류하여 적합한 모델로 보냅니다. \"지금 몇 시야\" 같은 간단한 질문은 빠르고 저렴한 모델을 사용하고, 복잡한 추론은 가장 좋은 모델을 사용합니다. 품질을 떨어뜨리지 않고 비용을 절약합니다. 아래에서 각 단계에 모델을 지정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classificeert elk verzoek automatisch op complexiteit en stuurt het naar het juiste model. Eenvoudige vragen zoals “hoe laat is het” gebruiken een snel, goedkoop model. Complex redeneren gebruikt uw beste model. Bespaart kosten zonder in te leveren op kwaliteit. Wijs hieronder modellen toe aan elk niveau."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifica automaticamente cada pedido por complexidade e o encaminha ao modelo certo. Perguntas simples como \"que horas são\" usam um modelo rápido e barato. Raciocínios complexos usam o seu melhor modelo. Economiza sem abrir mão da qualidade. Atribua modelos a cada nível abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически определяет сложность каждого запроса и направляет его в подходящую модель. Простые запросы вроде «который час» идут в быструю и недорогую модель. Сложные рассуждения — в вашу лучшую модель. Экономит расходы без потери качества. Назначьте модели каждому уровню ниже."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر درخواست کی پیچیدگی کے لحاظ سے خود بخود درجہ بندی کر کے اسے مناسب ماڈل تک پہنچاتا ہے۔ “وقت کیا ہوا ہے” جیسے سادہ سوالات تیز اور سستا ماڈل استعمال کرتے ہیں۔ پیچیدہ استدلال آپ کا بہترین ماڈل استعمال کرتا ہے۔ معیار پر سمجھوتہ کیے بغیر لاگت بچاتا ہے۔ نیچے ہر درجے کے لیے ماڈل مقرر کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动按复杂程度对每个请求分类，并路由到合适的模型。像“现在几点”这样的简单查询使用快速、廉价的模型。复杂推理使用你最好的模型。在不牺牲质量的情况下节省成本。请在下方为每个等级分配模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動依複雜度分類每個請求，並將其路由到合適的模型。像「現在幾點」這類簡單查詢會使用快速、便宜的模型；複雜推理則使用你最好的模型。在不犧牲品質的前提下節省成本。請在下方為每個層級指派模型。"
          }
        }
      }
    },
    "Automatically selects the best available model for %@ requests." : {
