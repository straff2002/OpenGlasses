    "General Data Protection Regulation Article 9 — health data is a special category requiring explicit consent, data minimisation, encryption, and DPIAs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المادة 9 من اللائحة العامة لحماية البيانات — البيانات الصحية فئة خاصة تتطلب موافقة صريحة وتقليل البيانات والتشفير وتقييمات الأثر على حماية البيانات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artículo 9 del Reglamento General de Protección de Datos: los datos de salud son una categoría especial que exige consentimiento explícito, minimización de datos, cifrado y DPIA."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règlement général sur la protection des données, article 9 — les données de santé sont une catégorie particulière qui exige un consentement explicite, la minimisation des données, le chiffrement et des DPIA."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az általános adatvédelmi rendelet 9. cikke — az egészségügyi adatok különleges kategóriába tartoznak, amely kifejezett hozzájárulást, adattakarékosságot, titkosítást és DPIA-t igényel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regolamento generale sulla protezione dei dati (GDPR), articolo 9: i dati sanitari sono una categoria particolare che richiede consenso esplicito, minimizzazione dei dati, crittografia e DPIA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般データ保護規則第9条 — 健康データは特別カテゴリーに当たり、明示的な同意、データ最小化、暗号化、DPIAが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General Data Protection Regulation 제9조 — 건강 데이터는 명시적 동의, 데이터 최소화, 암호화, DPIA가 필요한 특수 범주입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artikel 9 van de Algemene verordening gegevensbescherming — gezondheidsgegevens zijn een bijzondere categorie die uitdrukkelijke toestemming, gegevensminimalisatie, versleuteling en DPIA’s vereist."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General Data Protection Regulation, Artigo 9 — dados de saúde são uma categoria especial que exige consentimento explícito, minimização de dados, criptografia e DPIAs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статья 9 Общего регламента по защите данных — данные о здоровье относятся к особой категории и требуют явного согласия, минимизации данных, шифрования и DPIA."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General Data Protection Regulation کا آرٹیکل 9 — صحت کا ڈیٹا ایک خصوصی زمرہ ہے جس کے لیے صریح رضامندی، ڈیٹا کی کمی سے کمی، انکرپشن اور DPIAs درکار ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《通用数据保护条例》第 9 条 — 健康数据属于特殊类别，需要明确同意、数据最小化、加密和 DPIA。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般資料保護規則第 9 條 — 健康資料屬於特殊類別，需要明確同意、資料最小化、加密和 DPIA。"
          }
        }
      }
    },
