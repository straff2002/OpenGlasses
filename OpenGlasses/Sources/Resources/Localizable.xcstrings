    "%@ is no longer a listed publisher. This vault is left installed and still works; treat its content as unverified." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد %@ ناشرًا مدرجًا. تبقى هذه الخزنة مثبتة وتعمل، لكن تعامل مع محتواها على أنه غير موثّق."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no figura como editor en la lista. Esta bóveda sigue instalada y funcionando; considera su contenido como no verificado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est plus un éditeur répertorié. Ce coffre reste installé et fonctionne toujours; considérez son contenu comme non vérifié."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ már nem szerepel a kiadók listáján. Ez a tároló telepítve marad és továbbra is működik; a tartalmát tekintse ellenőrizetlennek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è più un editore in elenco. Questo deposito resta installato e funziona ancora; considera il suo contenuto non verificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は公開元として掲載されなくなりました。このボールトはインストールされたまま引き続き動作しますが、コンテンツは未検証として扱ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 더 이상 등록된 게시자가 아닙니다. 이 볼트는 설치된 상태로 남아 있으며 계속 작동하지만, 콘텐츠는 확인되지 않은 것으로 간주하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen vermelde uitgever meer. Deze kluis blijft geïnstalleerd en werkt nog steeds; beschouw de inhoud als niet geverifieerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é mais um editor listado. Este cofre continua instalado e funcionando; trate o conteúdo dele como não verificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ больше не входит в список издателей. Это хранилище остаётся установленным и продолжает работать; считайте его содержимое непроверенным."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ اب درج شدہ پبلشر نہیں ہے۔ یہ والٹ انسٹال رہتا ہے اور اب بھی کام کرتا ہے؛ اس کے مواد کو غیر تصدیق شدہ سمجھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@不再是列出的发布者。此保险库仍保持安装并可使用；请将其内容视为未经验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@不再是列名的發布者。此保險庫仍保持安裝並可繼續使用；請將其內容視為未經驗證。"
          }
        }
      }
    },
    "%@ is open on %@. Close it before running a scenario from %@." : {
