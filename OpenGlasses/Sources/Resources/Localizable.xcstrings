        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматический режим оставляет шаги с инструментами на Chat Completions без рассуждений, чтобы было быстро и недорого."
          }
        },
        "ur" : {
          "stringUnit" : {
