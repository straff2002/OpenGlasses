        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前往 %1$@ 上的 Avenkin 開發者，而不是你公司支援。它不包含對話或私人資料。不需要帳號，並且你可以在寄出前添加內容。"
          }
