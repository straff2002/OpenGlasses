          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma foto é capturada primeiro e, em seguida, esse prompt é enviado à IA junto com a imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
