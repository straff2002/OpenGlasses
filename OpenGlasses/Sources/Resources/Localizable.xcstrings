          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、目標を保存できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 목표를 저장할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doelen kunnen nu niet worden bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível salvar as metas agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас цели сохранить нельзя."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اہداف ابھی محفوظ نہیں کیے جا سکتے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法保存目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法儲存目標。"
          }
        }
      }
    },
    "Goals stay on this iPhone. Ask “how's my goal going?” or “what's next?” at any time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الأهداف على هذا الـ iPhone. اسأل «كيف يسير هدفي؟» أو «ما التالي؟» في أي وقت."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las metas se quedan en este iPhone. Pregunta “¿cómo va mi meta?” o “¿qué sigue?” cuando quieras."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les objectifs restent sur cet iPhone. Demandez « où en est mon objectif ? » ou « et ensuite ? » à tout moment."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A célok ezen az iPhone-on maradnak. Bármikor megkérdezheti: „hogy áll a célom?” vagy „mi a következő?”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli obiettivi restano su questo iPhone. Chiedi “come va il mio obiettivo?” o “cosa c’è dopo?” in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標はこのiPhoneにだけ保存されます。いつでも「目標の進み具合は？」や「次は何？」と聞いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표는 이 휴대폰에만 저장됩니다. 언제든 '내 목표 어떻게 되고 있어?' 또는 '다음은 뭐야?'라고 물어보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doelen blijven op deze iPhone. Vraag op elk moment “hoe gaat het met mijn doel?” of “wat is de volgende stap?”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As metas ficam neste iPhone. Pergunte “como está indo minha meta?” ou “qual é o próximo passo?” a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цели остаются на этом iPhone. В любой момент спросите «как продвигается моя цель?» или «что дальше?»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اہداف اسی iPhone پر رہتے ہیں۔ کسی بھی وقت پوچھیں “میرا ہدف کیسا چل رہا ہے؟” یا “اگلا کیا ہے؟”۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标保留在这部 iPhone 上。你可以随时问“我的目标进展如何？”或“下一步是什么？”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標保留在這支 iPhone 上。你可以隨時問「我的目標進展如何？」或「下一步是什麼？」"
          }
        }
      }
    },
    "goes to %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذهب إلى %@"
          }
        },
