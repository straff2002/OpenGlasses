    "Go to iPhone Settings → Accessibility → Read & Speak → Voices to download a premium voice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى إعدادات iPhone → تسهيلات الاستخدام → القراءة والنطق → الأصوات لتحميل صوت مميز."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve a Configuración del iPhone → Accesibilidad → Lectura y voz → Voces para descargar una voz premium."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez dans Réglages de l’iPhone → Accessibilité → Lire et énoncer → Voix pour télécharger une voix premium."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lépjen az iPhone Beállítások → Kisegítő lehetőségek → Felolvasás és kimondás → Hangok menüpontra egy prémium hang letöltéséhez."
          }
        },
        "it" : {
          "stringUnit" : {
