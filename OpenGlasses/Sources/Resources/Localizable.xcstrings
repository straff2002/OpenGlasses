    "Replaces what's on this phone with what the file says." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل ما على هذا الهاتف بما يقوله الملف."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza lo que hay en este celular con lo que dice el archivo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace ce qui se trouve sur ce téléphone par ce que dit le fichier."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telefonon lévő tartalmat a fájl által írottakra cseréli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce il contenuto del telefono con ciò che dice il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この電話にあるものをファイルの内容で置換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 휴대전화에 있는 내용을 파일 내용으로 바꿉니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervangt wat op deze telefoon staat met wat het bestand aangeeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui o que está neste telefone pelo que diz o arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменяет данные на этом телефоне содержимым файла."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس فون پر موجود چیزوں کو فائل کے مندرجات سے بدل دیتا ہے۔"
          }
        },
        "zh-Hans" : {
