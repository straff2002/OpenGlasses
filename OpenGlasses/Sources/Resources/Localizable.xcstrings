          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"라는 이름의 동작이 이미 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bestaat al een actie met de naam “%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe uma ação chamada \"%@\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действие с названием «%@» уже существует."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” نام کا ایکشن پہلے سے موجود ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存在名为“%@”的操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有名為「%@」的操作。"
          }
        }
      }
    },
    "An experiment: asks the iPhone's own mic for noise suppression while you dictate. Only on the iPhone mic, and only when dictation runs its own audio engine. It changes the input format and may add delay, so it stays off until it has been measured. Applies from the next turn." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجربة: تطلب من ميكروفون iPhone نفسه كتم الضوضاء أثناء الإملاء. فقط على ميكروفون iPhone، وفقط عندما يشغّل الإملاء محرك الصوت الخاص به. يغيّر تنسيق الإدخال وقد يضيف تأخيرًا، لذا يبقى متوقفًا إلى أن يُقاس. يسري من الدور التالي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un experimento: pide al micrófono del propio iPhone supresión de ruido mientras dictas. Solo con el micrófono del iPhone, y solo cuando el dictado usa su propio motor de audio. Cambia el formato de entrada y puede agregar retraso, así que permanece desactivado hasta que se haya medido. Se aplica desde el siguiente turno."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une expérience : demande au micro de l’iPhone lui-même une suppression du bruit pendant que vous dictez. Seulement avec le micro de l’iPhone, et seulement lorsque la dictée utilise son propre moteur audio. Cela modifie le format d’entrée et peut ajouter un délai ; l’option reste donc désactivée tant qu’elle n’a pas été mesurée. S’applique dès le prochain tour."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kísérlet: zajszűrést kér az iPhone saját mikrofonjától diktálás közben. Csak az iPhone mikrofonján, és csak akkor, ha a diktálás saját hangmotort futtat. Megváltoztatja a bemeneti formátumot, és késleltetést okozhat, ezért addig ki van kapcsolva, amíg meg nem mérték. A következő körtől érvényes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un esperimento: chiede al microfono dell’iPhone stesso la soppressione del rumore mentre detti. Solo con il microfono dell’iPhone e solo quando la dettatura usa il proprio motore audio. Cambia il formato di ingresso e può aggiungere ritardo, quindi resta disattivato finché non viene misurato. Si applica dal turno successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実験的機能：音声入力中に、iPhone自身のマイクにノイズ抑制を要求します。iPhoneのマイクでのみ、かつ音声入力が独自のオーディオエンジンで動作している場合のみ有効です。入力フォーマットが変わり、遅延が増える場合があるため、測定が済むまでオフのままです。次のターンから適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실험 기능: 받아쓰기 중에 iPhone 자체 마이크에 소음 억제를 요청합니다. iPhone 마이크에서만, 그리고 받아쓰기가 자체 오디오 엔진으로 실행될 때만 적용됩니다. 입력 형식이 바뀌고 지연이 늘어날 수 있으므로 측정이 끝날 때까지 꺼져 있습니다. 다음 차례부터 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een experiment: vraagt de eigen microfoon van de iPhone om ruisonderdrukking terwijl u dicteert. Alleen op de iPhone-microfoon, en alleen wanneer dictatie zijn eigen audio-engine gebruikt. Het wijzigt het invoerformaat en kan vertraging toevoegen, dus het blijft uit totdat het is gemeten. Geldt vanaf de volgende beurt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um experimento: pede ao microfone do próprio iPhone supressão de ruído enquanto você dita. Somente no microfone do iPhone, e somente quando o ditado usa seu próprio mecanismo de áudio. Altera o formato de entrada e pode adicionar atraso, por isso fica desativado até ser medido. Vale a partir da próxima interação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эксперимент: запрашивает у микрофона самого iPhone шумоподавление во время диктовки. Только на микрофоне iPhone и только когда диктовка использует собственный аудиодвижок. Меняет формат ввода и может добавить задержку, поэтому остаётся выключенным, пока не будет измерено. Действует со следующей реплики."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک تجربہ: ڈکٹیشن کے دوران iPhone کے اپنے مائیک سے شور کم کرنے کو کہتا ہے۔ صرف iPhone مائیک پر، اور صرف جب ڈکٹیشن اپنا آڈیو انجن چلائے۔ یہ ان پٹ فارمیٹ بدل دیتا ہے اور تاخیر بڑھا سکتا ہے، اس لیے جب تک اس کی پیمائش نہ ہو یہ بند رہتا ہے۔ اگلے ٹرن سے لاگو ہوتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实验性功能：听写时请求 iPhone 自身的麦克风进行噪声抑制。仅适用于 iPhone 麦克风，且仅在听写使用自己的音频引擎时有效。它会改变输入格式，并可能增加延迟，因此在测量之前保持关闭。从下一轮对话起生效。"
          }
