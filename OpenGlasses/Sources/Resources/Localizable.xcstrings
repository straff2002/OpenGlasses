    "The assistant is busy. Try again when it has finished." : {
      "comment" : "Goals screen: a draft while a turn is running.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساعد مشغول. حاول مرة أخرى عندما ينتهي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente está ocupado. Inténtalo de nuevo cuando termine."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant est occupé. Réessayez lorsqu’il aura terminé."
