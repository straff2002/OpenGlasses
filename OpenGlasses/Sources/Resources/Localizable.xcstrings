    "Pre-built templates for email, messages, health, smart home, and more. Preview each before installing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قوالب مُعدة مسبقًا للبريد الإلكتروني، الرسائل، الصحة، المنزل الذكي، والمزيد. قم بمعاينة كل منها قبل التثبيت."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plantillas prediseñadas para correo, mensajes, salud, casa inteligente y más. Revisa la vista previa de cada una antes de instalarla."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèles préconçus pour courriel, messages, santé, maison intelligente et plus. Prévisualisez chacun avant l'installation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Előre elkészített sablonok e-mailekhez, üzenetekhez, egészségügyhöz, intelligens otthonhoz és egyebekhez. Telepítés előtt tekintse meg mindegyik előnézetét."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelli predefiniti per e-mail, messaggi, salute, casa intelligente e altro ancora. Visualizza l'anteprima di ciascuno prima dell'installazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メール、メッセージ、健康、スマートホームなどの事前構築テンプレート。インストール前に各テンプレートをプレビューできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일, 메시지, 건강, 스마트 홈 등을 위한 사전 구축된 템플릿입니다. 설치하기 전에 각각을 미리 보십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vooraf gebouwde sjablonen voor e-mail, berichten, gezondheid, smart home en meer. Bekijk ze allemaal voordat u ze installeert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos pré-construídos para e-mail, mensagens, saúde, casa inteligente e muito mais. Visualize cada um antes de instalar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовые шаблоны для почты, сообщений, здоровья, умного дома и многого другого. Просмотрите каждый перед установкой."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ای میل، پیغامات، صحت، اسمارٹ ہوم اور مزید کے لیے پہلے سے تیار ٹیمپلیٹس۔ انسٹال کرنے سے پہلے ہر ایک کا پیش نظارہ دیکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为电子邮件、消息、健康、智能家居等预建模板。在安装前预览每个模板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建的電子郵件、訊息、健康、智慧家庭等模板。安裝前可預覽每個模板。"
          }
        }
      }
    },
