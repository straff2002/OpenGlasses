      }
    },
    "Opens each one in turn. Anything you cancel stays here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает их по очереди. Всё, что вы отмените, останется здесь."
          }
        }
      }
    },
    "Opens Field Assist settings, where the default vault is chosen." : {
