    "Attachments and manuals this job names. Large files come over Wi-Fi at the office." : {
      "comment" : "A description of the contents of the section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المرفقات والأدلة هذه الأسماء الوظيفية. تأتي الملفات الكبيرة عبر شبكة Wi-Fi في المكتب."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos adjuntos y manuales que menciona este trabajo. Los archivos grandes llegan por Wi-Fi en la oficina."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pièces jointes et manuels nommés pour ce travail. Les gros fichiers sont transférés via le Wi-Fi au bureau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellékletek és kézikönyvek, amelyeket ez a feladat elnevez. A nagy fájlok az irodai Wi-Fi-n keresztül érkeznek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allegati e manuali nominati da questo lavoro. I file di grandi dimensioni arrivano tramite Wi-Fi in ufficio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイルとマニュアル、この仕事内容の名前です。大きなファイルはオフィスのWi-Fiで送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업의 이름은 첨부 파일과 매뉴얼입니다. 대용량 파일은 사무실에서 Wi-Fi를 통해 제공됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijlagen en handleidingen noemen deze taak. Grote bestanden komen via Wi-Fi op kantoor binnen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexos e manuais que este trabalho nomeia. Arquivos grandes chegam por Wi-Fi no escritório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вложения и руководства, указанные в этом задании. Большие файлы загружаются по Wi-Fi в офисе."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ اٹیچمنٹس اور مینوئلز جن کا یہ جاب نام لیتی ہے۔ بڑی فائلیں آفس میں Wi-Fi پر آتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件和手册此工作的名称。大文件通过办公室的Wi-Fi传输。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作的附件和手冊名稱。大型檔案在辦公室可透過 Wi-Fi 傳輸。"
          }
        }
      }
    },
