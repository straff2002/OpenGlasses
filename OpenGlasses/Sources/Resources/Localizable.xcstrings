        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "办公室的配对没有由您的组织指定的管理员签署，因此没有应用任何内容。请咨询您的管理员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辦公室的配對沒有由您組織指定的管理員簽署，因此未應用任何內容。請詢問您的管理員。"
          }
