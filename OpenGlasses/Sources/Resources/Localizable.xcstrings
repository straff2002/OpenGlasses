    "OpenAI retires the realtime model %@ on %@, so your saved OpenAI live model now uses %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف OpenAI نموذج الوقت الفعلي %1$@ في %2$@، لذا يستخدم نموذجك المباشر المحفوظ من OpenAI الآن %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenAI retires the realtime model %1$@ on %2$@, so your saved OpenAI live model now uses %3$@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI retirará el modelo en tiempo real %1$@ el %2$@, así que tu modelo en vivo de OpenAI guardado ahora usa %3$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI retire le modèle en temps réel %1$@ le %2$@; votre modèle en direct OpenAI enregistré utilise donc maintenant %3$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OpenAI kivezeti a(z) %1$@ valós idejű modellt (dátum: %2$@), ezért a mentett OpenAI élő modellje mostantól a(z) %3$@ modellt használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI ritira il modello in tempo reale %1$@ il %2$@, quindi il tuo modello live OpenAI salvato ora usa %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI はリアルタイムモデル %1$@ を %2$@ に廃止するため、保存済みの OpenAI ライブモデルは %3$@ を使うようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI가 %2$@에 실시간 모델 %1$@을(를) 종료하므로, 저장된 OpenAI 라이브 모델이 이제 %3$@을(를) 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI stopt op %2$@ met het realtime model %1$@, dus je opgeslagen OpenAI-livemodel gebruikt nu %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A OpenAI vai desativar o modelo em tempo real %1$@ em %2$@, então seu modelo ao vivo da OpenAI salvo agora usa %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI выводит модель реального времени %1$@ из эксплуатации %2$@, поэтому ваша сохранённая живая модель OpenAI теперь использует %3$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI ریئل ٹائم ماڈل %1$@ کو %2$@ کو ختم کر رہا ہے، اس لیے آپ کا محفوظ کردہ OpenAI لائیو ماڈل اب %3$@ استعمال کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 将于 %2$@ 停用实时模型 %1$@，因此您保存的 OpenAI 实时模型现在使用 %3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 將於 %2$@ 停用即時模型 %1$@，因此您儲存的 OpenAI 即時模型現在使用 %3$@。"
          }
        }
      }
