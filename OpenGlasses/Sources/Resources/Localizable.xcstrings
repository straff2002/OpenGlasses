    "Data Protection Act 2018 (UK GDPR) — health data as special category, requires appropriate policy documents, encryption, and lawful basis for processing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قانون حماية البيانات 2018 (UK GDPR) — البيانات الصحية فئة خاصة، وتتطلب وثائق سياسة مناسبة وتشفيرًا وأساسًا قانونيًا للمعالجة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ley de Protección de Datos de 2018 (UK GDPR): los datos de salud son una categoría especial y exigen documentos de política adecuados, cifrado y una base legal para su tratamiento."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Protection Act 2018 (RGPD du R.-U.) — les données de santé sont une catégorie particulière; cela exige des documents de politique appropriés, le chiffrement et un fondement licite du traitement."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2018-as adatvédelmi törvény (UK GDPR) — az egészségügyi adatok különleges kategóriába tartoznak, megfelelő szabályzati dokumentumokat, titkosítást és az adatkezelés jogalapját igénylik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Protection Act 2018 (UK GDPR): i dati sanitari sono una categoria particolare e richiedono documenti sulla politica adeguata, crittografia e una base giuridica per il trattamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2018年データ保護法（英国GDPR）— 健康データは特別カテゴリーに当たり、適切なポリシー文書、暗号化、処理の適法な根拠が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Protection Act 2018 (UK GDPR) — 건강 데이터는 특수 범주로, 적정 정책 문서, 암호화, 처리의 적법 근거가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Protection Act 2018 (UK GDPR) — gezondheidsgegevens als bijzondere categorie; vereist passende beleidsdocumenten, versleuteling en een rechtmatige grondslag voor verwerking."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Protection Act 2018 (UK GDPR) — dados de saúde são uma categoria especial e exigem documentos de política adequados, criptografia e base legal para o tratamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закон о защите данных 2018 года (UK GDPR) — данные о здоровье как особая категория, требуются соответствующие документы о политике, шифрование и законное основание для обработки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Protection Act 2018 (UK GDPR) — صحت کا ڈیٹا خصوصی زمرہ ہے، جس کے لیے مناسب پالیسی دستاویزات، انکرپشن اور پروسیسنگ کی قانونی بنیاد درکار ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《2018 年数据保护法》（英国 GDPR）— 健康数据属于特殊类别，需要适当的政策文件、加密和合法的处理依据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2018 年資料保護法（英國 GDPR）— 健康資料屬於特殊類別，需要適當的政策文件、加密以及合法的處理依據。"
          }
        }
      }
    },
    "Data Protection Impact Assessment (DPIA)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
