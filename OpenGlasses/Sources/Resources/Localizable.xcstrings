    "Separate from the job report. A request is marked sent once the order goes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منفصل عن تقرير المهمة. يُعلَّم الطلب على أنه مُرسَل بمجرد إرسال الأمر."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparte del reporte del trabajo. Una solicitud se marca como enviada en cuanto sale el pedido."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distinct du rapport de travail. Une demande est marquée comme envoyée dès que la commande part."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Külön a munka jelentésétől. A kérés elküldöttként lesz megjelölve, amint a megrendelés elmegy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separato dal rapporto del lavoro. Una richiesta viene contrassegnata come inviata quando l’ordine parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブレポートとは別です。注文が送信されると、依頼は送信済みになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 보고서와는 별개입니다. 주문이 전송되면 요청이 전송됨으로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los van het opdrachtrapport. Een verzoek wordt als verzonden gemarkeerd zodra de bestelling de deur uit is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separado do relatório do trabalho. Uma solicitação é marcada como enviada assim que o pedido sai."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдельно от отчёта о задании. Запрос помечается как отправленный, когда заказ уходит."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جاب رپورٹ سے الگ۔ آرڈر جاتے ہی درخواست کو بھیجی گئی کے طور پر نشان زد کر دیا جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与工作报告分开。订单发出后，申请才会标记为已发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與工作報告分開。訂單送出後，申請才會標記為已傳送。"
          }
        }
      }
    },
