          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام ہر اسپریڈشیٹ پر آتا ہے، تاکہ بیس اور اگلی شفٹ کو معلوم ہو کہ یہ کون سی گاڑی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
