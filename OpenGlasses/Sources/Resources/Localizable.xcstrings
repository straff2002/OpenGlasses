    "This vault ships with the app. Its manuals cannot be removed one at a time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي هذه الخزنة مع التطبيق. لا يمكن إزالة كتيباتها واحدًا تلو الآخر."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta bóveda viene con la app. Sus manuales no se pueden quitar de uno en uno."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce coffre est livré avec l’application. Ses manuels ne peuvent pas être retirés un à un."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a tároló az alkalmazással érkezik. A kézikönyvei nem távolíthatók el egyenként."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo deposito è incluso nell'app. I suoi manuali non possono essere rimossi uno alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボールトはアプリに同梱されています。マニュアルを1つずつ削除することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 볼트는 앱에 포함되어 있습니다. 매뉴얼을 하나씩 제거할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kluis wordt met de app meegeleverd. De handleidingen ervan kunnen niet één voor één worden verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cofre vem com o app. Os manuais dele não podem ser removidos um a um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это хранилище поставляется с приложением. Его руководства нельзя удалять по одному."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ والٹ ایپ کے ساتھ آتا ہے۔ اس کے مینوئلز ایک ایک کر کے ہٹائے نہیں جا سکتے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此保险库随应用一起提供。其手册无法逐本移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此保險庫隨 App 附帶。其手冊無法逐份移除。"
          }
        }
      }
    },
    "This vault was installed from a link that wasn't signed by a listed publisher. Its reference files guide the assistant's answers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبّتت هذه الخزنة من رابط لم يوقّعه ناشر مدرج. تُوجّه ملفات المرجع فيها إجابات المساعد."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta bóveda se instaló desde un enlace que no estaba firmado por un editor de la lista. Sus archivos de referencia guían las respuestas del asistente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce coffre a été installé à partir d’un lien qui n’a pas été signé par un éditeur répertorié. Ses fichiers de référence orientent les réponses de l’assistant."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a tároló olyan hivatkozásból lett telepítve, amelyet nem egy listázott kiadó írt alá. A referenciafájljai irányítják az asszisztens válaszait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo deposito è stato installato da un link non firmato da un editore in elenco. I suoi file di riferimento guidano le risposte dell'assistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボールトは、掲載された公開元の署名がないリンクからインストールされました。その参照ファイルが、アシスタントの回答の拠り所になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 볼트는 등록된 게시자가 서명하지 않은 링크로 설치되었습니다. 이 볼트의 참조 파일이 어시스턴트의 답변을 안내합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kluis is geïnstalleerd vanaf een link die niet door een vermelde uitgever is ondertekend. De referentiebestanden sturen de antwoorden van de assistent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cofre foi instalado a partir de um link que não foi assinado por um editor listado. Os arquivos de referência dele orientam as respostas do assistente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это хранилище установлено по ссылке, не подписанной издателем из списка. Его справочные файлы направляют ответы ассистента."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ والٹ ایسے لنک سے انسٹال کیا گیا تھا جس پر درج شدہ پبلشر نے دستخط نہیں کیے تھے۔ اس کی حوالہ فائلیں اسسٹنٹ کے جوابات کی رہنمائی کرتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此保险库是通过未经列出的发布者签署的链接安装的。其参考文件会指导助手的回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此保險庫是從未經列名發布者簽署的連結安裝的。其參考檔案會引導助理的回答。"
          }
        }
      }
    },
    "This version of Avenkin can't join an office by scanning its code. Ask your organisation for an Avenkin Office setup file instead." : {
      "comment" : "A message explaining why the office code can't be scanned.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الإصدار من Avenkin لا يمكنه الانضمام إلى مكتب عن طريق مسح الرمز الخاص به. اطلب من مؤسستك ملف إعداد Avenkin Office بدلاً من ذلك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de Avenkin no puede unirse a una oficina escaneando su código. Mejor pídele a tu organización un archivo de configuración de Avenkin Office."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de Avenkin ne peut pas rejoindre un bureau en scannant son code. Demandez à votre organisation un fichier de configuration Office Avenkin à la place."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a Avenkin verzió nem tud csatlakozni egy irodához a kód beolvasásával. Kérd a szervezetétől a Avenkin Office beállítófájlt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione di Avenkin non può unirsi a un ufficio scansionandone il codice. Chiedi invece alla tua organizzazione un file di installazione di Office Avenkin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンの Avenkin ではコードをスキャンしてオフィスに参加できません。代わりに組織に Avenkin のオフィス設定ファイルを依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 Avenkin는 코드를 스캔하여 사무실에 참여할 수 없습니다. 대신 조직에 Avenkin Office 설치 파일을 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze versie van Avenkin kan geen kantoor betreden door de code te scannen. Vraag in plaats daarvan uw organisatie om een Avenkin Office-setupbestand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão do Avenkin não pode ingressar em um escritório digitalizando seu código. Peça à sua organização um arquivo de configuração do Office Avenkin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия Avenkin не может подключиться к офису по сканированию кода. Попросите у своей организации файл настройки Avenkin Office."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin کا یہ ورژن کوڈ اسکین کر کے آفس میں شامل نہیں ہو سکتا۔ اس کے بجائے اپنی تنظیم سے Avenkin Office سیٹ اپ فائل مانگیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的 Avenkin 无法通过扫描其代码加入办公室。请向您的组织索取 Avenkin 办公室设置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的 Avenkin 無法通過掃描其代碼加入辦公室。請向您的組織索取 Avenkin 辦公室設置檔。"
          }
        }
      }
    },
    "This version of the app could not use these entries, so they are left out." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الإصدار من التطبيق لم يتمكن من استخدام هذه الإدخالات، لذلك تم استبعادها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de la app no pudo usar estas entradas, así que se omiten."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de l'application n'a pas pu utiliser ces entrées, elles sont donc ignorées."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az alkalmazás verzió nem tudta használni ezeket a bejegyzéseket, így ki lettek hagyva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione dell'app non può utilizzare queste voci, quindi vengono escluse."
          }
        },
        "ja" : {
