    "Used for new jobs. An active job keeps its original vault until you finish it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم للوظائف الجديدة. تبقي الوظيفة النشطة خزنتها الأصلية حتى تنتهي منها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para los trabajos nuevos. Un trabajo activo conserva su bóveda original hasta que lo terminas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour de nouveaux travaux. Un travail actif conserve son coffre original jusqu'à ce que vous le terminiez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Új feladatokhoz használatos. Az aktív feladat megőrzi az eredeti tárolóját, amíg be nem fejezed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzato per nuovi lavori. Un lavoro attivo mantiene il suo deposito originale finché non lo finisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいジョブ用に使用。アクティブなジョブは、完了するまで元のボールトを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 직업에 사용됩니다. 활성 작업은 사용자가 완료할 때까지 원래 저장소를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gebruikt voor nieuwe taken. Een actieve taak behoudt zijn oorspronkelijke kluis totdat u deze voltooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para novos trabalhos. Um trabalho ativo mantém seu cofre original até que você o termine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для новых заданий. Активное задание сохраняет своё исходное хранилище, пока вы его не завершите."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نئی جابز کے لیے استعمال ہوتا ہے۔ فعال جاب اپنا اصل والٹ اس وقت تک رکھتی ہے جب تک آپ اسے مکمل نہ کر لیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于新工作。活动工作在完成之前保持其原始保险库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於新工作。一個進行中的工作會保留其原始保險庫，直到您完成它。"
          }
        }
      }
    },
    "Used when no cloud voice is available or its credit has run out. Download more voices in iPhone Settings → Accessibility → Read & Speak → Voices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم عندما لا يتوفر صوت سحابي أو ينفد رصيده. قم بتنزيل المزيد من الأصوات في إعدادات iPhone → تسهيلات الاستخدام → القراءة والنطق → الأصوات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cuando no hay ninguna voz en la nube disponible o se agotó su crédito. Descarga más voces en Configuración del iPhone → Accesibilidad → Lectura y voz → Voces."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé lorsqu’aucune voix infonuagique n’est disponible ou que son crédit est épuisé. Téléchargez plus de voix dans Réglages de l’iPhone → Accessibilité → Lire et énoncer → Voix."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkor használatos, ha nincs elérhető felhőalapú hang, vagy elfogyott az egyenlege. Tölts le több hangot az iPhone Beállítások → Kisegítő lehetőségek → Felolvasás és kimondás → Hangok menüpontban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzato quando non è disponibile alcuna voce cloud o il suo credito è esaurito. Scarica più voci in Impostazioni di iPhone → Accessibilità → Lettura e voce → Voci."
          }
        },
        "ja" : {
          "stringUnit" : {
