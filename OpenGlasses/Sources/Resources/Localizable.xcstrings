    "Privacy Act 1988 (APP 11) — requires entities to take reasonable steps to protect personal information from misuse, loss, and unauthorised access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قانون الخصوصية 1988 (APP 11) — يلزم الجهات باتخاذ خطوات معقولة لحماية المعلومات الشخصية من إساءة الاستخدام والفقدان والوصول غير المصرح به."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Act 1988 (APP 11): exige que las entidades tomen medidas razonables para proteger la información personal contra el uso indebido, la pérdida y el acceso no autorizado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Act 1988 (APP 11) — exige que les entités prennent des mesures raisonnables pour protéger les renseignements personnels contre l’utilisation abusive, la perte et l’accès non autorisé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Act 1988 (APP 11) — előírja, hogy a szervezetek tegyenek észszerű lépéseket a személyes adatok visszaélés, elvesztés és jogosulatlan hozzáférés elleni védelmére."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Act 1988 (APP 11): richiede alle entità di adottare misure ragionevoli per proteggere le informazioni personali da uso improprio, perdita e accesso non autorizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1988年プライバシー法（APP 11）— 事業者は、個人情報を不正使用、紛失、不正アクセスから守るために合理的な措置を講じる必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Act 1988 (APP 11) — 개인정보의 오용, 분실, 무단 접근을 막기 위해 합리적인 조치를 취하도록 요구합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Act 1988 (APP 11) — vereist dat entiteiten redelijke stappen nemen om persoonsgegevens te beschermen tegen misbruik, verlies en onbevoegde toegang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Act 1988 (APP 11) — exige que as entidades tomem medidas razoáveis para proteger informações pessoais contra uso indevido, perda e acesso não autorizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закон о конфиденциальности 1988 года (APP 11) — требует от организаций принимать разумные меры для защиты персональной информации от неправомерного использования, потери и несанкционированного доступа."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Act 1988 (APP 11) — اداروں سے تقاضا کرتا ہے کہ ذاتی معلومات کو غلط استعمال، نقصان اور غیر مجاز رسائی سے بچانے کے لیے معقول اقدامات کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《1988 年隐私法》（APP 11）— 要求各实体采取合理措施，保护个人信息免遭滥用、丢失和未经授权的访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《1988 年隱私法》（APP 11）— 要求機構採取合理措施，保護個人資訊免遭濫用、遺失和未經授權的存取。"
          }
        }
      }
    },
