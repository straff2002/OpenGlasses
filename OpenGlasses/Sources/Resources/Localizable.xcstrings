            "value" : "Escolha o protocolo implementado pelo servidor e digite a URL completa do WebSocket. Endpoints públicos exigem wss://."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите протокол, реализованный сервером, и введите полный URL WebSocket. Для публичных адресов требуется wss://."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ پروٹوکول منتخب کریں جو آپ کا سرور استعمال کرتا ہے اور مکمل WebSocket URL درج کریں۔ عوامی اینڈ پوائنٹس کے لیے wss:// ضروری ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
