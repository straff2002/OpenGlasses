        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 %1$@ 中技术人员无法查看的设置。其锁定仍对所有人有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開%1$@設定，此設定技術人員無法查看。其鎖定仍對所有人有效。"
          }
        }
      }
    },
    "Opens the share sheet with everything selected, at full size — clips included." : {
