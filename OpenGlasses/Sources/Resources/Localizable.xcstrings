        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فائل کہتی ہے کہ یہ “%@” کی طرف سے ہے۔ یہ فائل کا دعویٰ ہے، ایسی چیز نہیں جس کی یہ فون تصدیق کر سکے۔"
