    "Installs on the safe \"Redact\" data policy. You can change it later under Safety & Trust." : {
      "comment" : "A footer for the button in the `MCPCatalogInstallView`.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التثبيتات على سياسة البيانات الآمنة \"Redact\". يمكنك تغييرها لاحقًا ضمن الأمان والثقة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se instala con la política de datos segura “Redact”. Puedes cambiarla después en Seguridad y confianza."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'installe sur la politique de données du coffre-fort \"Redact\". Vous pouvez la modifier plus tard dans Sécurité et Confiance."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonságos „Redact” adatszabályzatra telepíti. Később módosíthatja a Biztonság és bizalom alatt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si installa sulla policy dei dati sicura \"Redact\". Puoi modificarlo in seguito in Sicurezza e affidabilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全な「非表示」データポリシーにインストールします。後で[安全性と信頼]で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전한 \"수정\" 데이터 정책에 따라 설치됩니다. 나중에 안전 및 신뢰에서 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeert op het veilige \"Redact\"-gegevensbeleid. Je kunt dit later wijzigen onder Veiligheid & Vertrouwen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala na política de dados segura \"Redigir\". Você pode alterá-lo posteriormente em Segurança e Confiança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливается с безопасной политикой данных «Скрывать». Вы можете изменить это позже в разделе «Безопасность и доверие»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ “Redact” ڈیٹا پالیسی پر انسٹال ہوتا ہے۔ آپ اسے بعد میں حفاظت اور اعتماد کے تحت تبدیل کر سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据安全的“编辑”数据策略安装。您可以稍后在安全与信任中更改它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
