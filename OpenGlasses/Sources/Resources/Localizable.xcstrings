    "Turn wake-word listening on or off. Avenkin stays in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الاستماع بكلمة التنبيه أو أوقفه. يبقى Avenkin في الخلفية."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva la escucha de la palabra de activación. Avenkin se queda en segundo plano."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez ou désactivez l'écoute du mot d'activation. Avenkin reste en arrière-plan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be vagy ki az ébresztő szóra való hallgatást. Az Avenkin a háttérben marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva l'ascolto della parola di attivazione. Avenkin resta in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェイクワードのリスニングをオン/オフにします。Avenkinはバックグラウンドで動作し続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웨이크 워드 듣기를 켜거나 끕니다. Avenkin은 백그라운드에 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet luisteren naar het wake-woord aan of uit. Avenkin blijft op de achtergrond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative ou desative a escuta da palavra de ativação. O Avenkin continua em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить или выключить прослушивание слова активации. Avenkin остаётся в фоновом режиме."
          }
