    "OpenAI is retiring older realtime models, so your saved OpenAI live models now use newer ones: %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف OpenAI نماذج الوقت الفعلي الأقدم، لذا تستخدم نماذجك المباشرة المحفوظة من OpenAI الآن نماذج أحدث: %@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI está retirando modelos en tiempo real anteriores, así que tus modelos en vivo de OpenAI guardados ahora usan otros más nuevos: %@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI retire d’anciens modèles en temps réel; vos modèles en direct OpenAI enregistrés utilisent donc maintenant des modèles plus récents : %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OpenAI kivezeti a régebbi valós idejű modelleket, ezért a mentett OpenAI élő modelljei mostantól újabbakat használnak: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI sta ritirando i modelli in tempo reale meno recenti, quindi i tuoi modelli live OpenAI salvati ora usano modelli più nuovi: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI は以前のリアルタイムモデルを廃止するため、保存済みの OpenAI ライブモデルは新しいモデルを使うようになりました: %@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI가 이전 실시간 모델을 종료하므로, 저장된 OpenAI 라이브 모델이 이제 더 새로운 모델을 사용합니다: %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI stopt met oudere realtime modellen, dus je opgeslagen OpenAI-livemodellen gebruiken nu nieuwere: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A OpenAI está desativando modelos em tempo real mais antigos, então seus modelos ao vivo da OpenAI salvos agora usam modelos mais novos: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI выводит из эксплуатации старые модели реального времени, поэтому ваши сохранённые живые модели OpenAI теперь используют более новые: %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI پرانے ریئل ٹائم ماڈلز ختم کر رہا ہے، اس لیے آپ کے محفوظ کردہ OpenAI لائیو ماڈلز اب نئے ماڈلز استعمال کرتے ہیں: %@۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 正在停用较旧的实时模型，因此您保存的 OpenAI 实时模型现在使用较新的模型：%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 正在停用較舊的即時模型，因此您儲存的 OpenAI 即時模型現在使用較新的模型：%@。"
          }
        }
      }
    },
