        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT نے جواب دیا، لیکن بتایا کہ اس اکاؤنٹ کے لیے کوئی ماڈل فعال نہیں ہے۔"
