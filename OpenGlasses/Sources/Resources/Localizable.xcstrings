          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے مراحل اور چیک اِنز بھی حذف ہو جائیں گے۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
