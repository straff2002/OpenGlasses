            "state" : "translated",
            "value" : "Se ejecuta en este iPhone. Agrega una clave de proveedor después en Configuración."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’exécute sur cet iPhone. Ajoutez une clé de fournisseur plus tard dans Réglages."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen az iPhone-on fut. Szolgáltatói kulcsot később is hozzáadhat a Beállításokban."
