    "To change what Avenkin can read, open the Health app, then Sharing, Apps, Avenkin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتغيير ما يمكن أن يقرأه Avenkin، افتح تطبيق الصحة، ثم المشاركة، التطبيقات، Avenkin."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cambiar lo que Avenkin puede leer, abre la app Salud y luego Compartir, Apps, Avenkin."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour changer ce que Avenkin peut lire, ouvrez l'application Santé, puis Partage, Applications, Avenkin."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahhoz, hogy megváltoztasd, mit olvashat a Avenkin, nyisd meg az Egészség alkalmazást, majd a Megosztás, Alkalmazások, Avenkin menüpontot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per modificare ciò che Avenkin può leggere, apri l'app Salute, quindi Condivisione, App, Avenkin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinが読み取れる内容を変更するには、ヘルスケアアプリを開き、「共有」>「アプリ」>「Avenkin」の順に操作してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin가 읽을 수 있는 내용을 변경하려면 건강 앱을 연 다음 공유, 앱, Avenkin를 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te wijzigen wat Avenkin kan lezen, open de Gezondheids-app, ga vervolgens naar Delen, Apps, Avenkin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para alterar o que Avenkin pode ler, abra o aplicativo Saúde e, em seguida, Compartilhamento, Aplicativos, Avenkin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы изменить, что может читать Avenkin, откройте приложение «Здоровье», затем «Доступ», «Приложения», Avenkin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin جو کچھ پڑھ سکتا ہے اسے بدلنے کے لیے Health ایپ کھولیں، پھر اشتراک، ایپس، Avenkin۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要更改 Avenkin 可以读取的内容，请打开“健康”应用，然后选择“共享”，再选择“应用”，最后选择 Avenkin。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要更改 Avenkin 可讀取的內容，請打開健康應用程式，然後前往共享 > 應用程式 > Avenkin。"
          }
        }
      }
    },
