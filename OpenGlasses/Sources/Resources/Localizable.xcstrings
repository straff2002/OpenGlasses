          }
        }
      }
    },
    "Its template drops the model's own replies." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُسقط قالبه ردود النموذج نفسه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su plantilla omite las respuestas del propio modelo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son gabarit omet les réponses du modèle."
          }
        },
        "hu" : {
