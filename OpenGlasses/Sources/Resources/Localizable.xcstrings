          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントが使用する各サウンドを再生し、その意味を伝えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어시스턴트가 사용하는 각 사운드를 재생하고 그 의미를 말합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt elk geluid af dat de assistent gebruikt en zegt wat het betekent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz cada som que o assistente usa e diz o que significa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проигрывает каждый звук, который использует ассистент, и объясняет, что он означает."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسسٹنٹ کی استعمال کردہ ہر آواز چلاتا ہے اور بتاتا ہے کہ اس کا کیا مطلب ہے۔"
