            "value" : "الذاكرة المشتركة للوكيل (memory.md). يقوم الوكيل بتحديث هذا أثناء تعلمه عنك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria compartida del agente (memory.md). El agente la actualiza conforme aprende sobre ti."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
