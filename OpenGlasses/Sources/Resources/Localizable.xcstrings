    "Images are downscaled to the long-edge limit, then JPEG-compressed until they fit the size cap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تقليل حجم الصور إلى حد الحافة الطويلة، ثم يتم ضغطها بصيغة JPEG حتى تتوافق مع الحد الأقصى للحجم."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes se reducen al límite del lado largo y luego se comprimen en JPEG hasta que caben en el tope de tamaño."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images sont réduites à la limite du bord le plus long, puis compressées en JPEG jusqu'à ce qu'elles respectent la limite de taille."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képeket a rendszer a hosszú él határáig kicsinyíti, majd JPEG-formátumba tömöríti, amíg el nem éri a méretkorlátot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini vengono ridotte al limite del bordo lungo, quindi compresse JPEG fino a quando non rientrano nel limite di dimensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像は長辺の制限に合わせて縮小され、その後、サイズ上限に収まるまでJPEGで圧縮されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지는 긴 가장자리 한계까지 축소된 다음 크기 제한에 맞을 때까지 JPEG로 압축됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afbeeldingen worden verkleind tot de limiet voor de lange zijde en vervolgens JPEG-gecomprimeerd totdat ze binnen de maximale grootte passen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens são reduzidas até o limite da borda longa e depois compactadas em JPEG até caberem no limite de tamanho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображения уменьшаются до предела по длинной стороне, затем сжимаются в JPEG, пока не впишутся в ограничение по размеру."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصاویر کو لمبے کنارے کی حد تک چھوٹا کیا جاتا ہے، پھر سائز کی حد میں آنے تک JPEG میں کمپریس کیا جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像会缩小至长边限制，然后进行 JPEG 压缩，直到符合大小上限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影像會被縮放至長邊限制，然後進行 JPEG 壓縮，直到符合大小上限。"
          }
        }
      }
    },
