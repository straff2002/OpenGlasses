        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beszélgetése már nincs a készüléken, vagy soha nem mentettek el fordulatot ellene."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
