    "Sending messages, calling, smart-home, shortcuts and exports ask for a spoken “confirm” first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب إرسال الرسائل والاتصال والمنزل الذكي والاختصارات والتصدير قول «تأكيد» صوتيًا أولًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar mensajes, llamar, casa inteligente, atajos y exportaciones piden primero un “confirmar” hablado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi de messages, les appels, la maison intelligente, les raccourcis et les exportations demandent d’abord un « confirmer » à voix haute."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az üzenetküldés, hívás, okosotthon, parancsikonok és exportok előbb egy kimondott „megerősítem”-et kérnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invio di messaggi, chiamate, casa intelligente, scorciatoie ed esportazioni richiedono prima una «conferma» a voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージ送信、通話、スマートホーム、ショートカット、書き出しでは、先に音声で「確定」と言って確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 전송, 전화 걸기, 스마트 홈, 단축어, 내보내기는 먼저 음성으로 “확인”이라고 말해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor het verzenden van berichten, bellen, slimme woning, opdrachten en exports wordt eerst om een gesproken “bevestig” gevraagd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar mensagens, ligar, casa inteligente, atalhos e exportações pedem antes um “confirmar” falado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправка сообщений, звонки, умный дом, команды и экспорт сначала просят произнести вслух «подтверждаю»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیغامات بھیجنا، کال کرنا، اسمارٹ ہوم، شارٹ کٹس اور ایکسپورٹس پہلے بول کر “تصدیق” کہنے کا مطالبہ کرتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送消息、通话、智能家居、快捷指令和导出，都会先要求你口头说“确认”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送訊息、撥打電話、智慧家庭、捷徑與匯出，都會先要求你口頭說「確認」。"
          }
        }
      }
    },
