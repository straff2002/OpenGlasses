    "Sent as a file of its own — the report names it rather than containing it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسل كملف مستقل — يسميه التقرير ولا يتضمنه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía como un archivo aparte: el reporte lo nombra en lugar de contenerlo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé comme fichier distinct — le rapport le nomme plutôt que de le contenir."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Külön fájlként küldve — a jelentés megnevezi, de nem tartalmazza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato come file a sé: il rapporto lo nomina senza contenerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単独のファイルとして送信されます。レポートにはその名前が記載され、中身は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별도의 파일로 전송됩니다. 보고서에는 내용이 포함되지 않고 파일 이름만 기재됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als apart bestand verzonden — het rapport noemt het in plaats van het te bevatten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado como arquivo próprio — o relatório o cita em vez de contê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено отдельным файлом — отчёт называет его, а не содержит."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الگ فائل کے طور پر بھیجا گیا — رپورٹ اس کا نام بتاتی ہے، اسے شامل نہیں کرتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作为单独的文件发送 — 报告只写明其名称，不包含其内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以獨立檔案傳送 — 報告只會註明它，而不會包含它。"
          }
        }
      }
    },
