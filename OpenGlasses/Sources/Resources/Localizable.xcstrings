          "stringUnit" : {
            "state" : "translated",
            "value" : "میں اس ماڈل کا لائسنس قبول کرتا ہوں"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我接受此模型的许可"
          }
        },
