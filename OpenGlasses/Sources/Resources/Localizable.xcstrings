    "Runs on this iPhone. Add a provider key later in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل على هذا iPhone. أضف مفتاح مزود لاحقًا في الإعدادات."
