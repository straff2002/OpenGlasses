    "Use Apple Speech, switching to the offline on-device recognizer once its model is downloaded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم Apple Speech، مع التحول إلى أداة التعرف على الجهاز دون اتصال بمجرد تحميل نموذجها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el reconocimiento de voz de Apple y cambia al reconocedor sin conexión en el dispositivo en cuanto se descargue su modelo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser Apple Speech, en passant au module de reconnaissance hors ligne sur l’appareil une fois son modèle téléchargé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple Speech használata, majd váltás az offline, eszközön futó felismerőre, amint a modellje letöltődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple Speech, passando al riconoscitore offline sul dispositivo una volta scaricato il suo modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの音声認識を使い、モデルのダウンロードが終わるとオフラインのオンデバイス認識に切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 음성 인식을 사용하고, 모델이 다운로드되면 오프라인 기기 내 인식기로 전환합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Apple Speech en schakel over op de offline spraakherkenner op het apparaat zodra het model is gedownload."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o Apple Speech, mudando para o reconhecedor offline no dispositivo assim que o modelo dele for baixado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать Apple Speech, переключаясь на офлайн-распознаватель на устройстве, когда его модель будет загружена."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Speech استعمال کریں، اور ماڈل ڈاؤن لوڈ ہوتے ہی آف لائن آن ڈیوائس ریکگنائزر پر منتقل ہو جائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 语音识别，待其离线设备端识别器的模型下载完成后切换到它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
