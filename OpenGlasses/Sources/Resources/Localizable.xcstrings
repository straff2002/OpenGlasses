    },
    "Goals are what you're working on, kept with you step by step. Activity is what the assistant has done for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأهداف هي ما تعمل عليه، تُحفظ معك خطوة بخطوة. النشاط هو ما فعله المساعد من أجلك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las metas son lo que estás sacando adelante, paso a paso y contigo. La actividad es lo que el asistente ha hecho por ti."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les objectifs sont ce sur quoi vous travaillez, suivis avec vous étape par étape. L’activité est ce que l’assistant a fait pour vous."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A célok azok, amiken dolgozik, lépésről lépésre Önnel együtt vezetve. A tevékenység az, amit az asszisztens megtett Önért."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli obiettivi sono ciò su cui stai lavorando, seguiti insieme a te passo dopo passo. L’attività è ciò che l’assistente ha fatto per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標は、あなたが取り組んでいることをステップごとに記録するものです。アクティビティは、アシスタントがあなたのために行ったことです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표는 지금 하고 있는 일을 단계별로 기록해 두는 것입니다. 활동은 어시스턴트가 나를 위해 한 일입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doelen zijn waar u aan werkt, stap voor stap bijgehouden. Activiteit is wat de assistent voor u heeft gedaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metas são aquilo em que você está trabalhando, acompanhado etapa por etapa. Atividade é o que o assistente fez por você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цели — это то, над чем вы работаете, с отслеживанием шаг за шагом. Активность — это то, что ассистент сделал для вас."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اہداف وہ ہیں جن پر آپ کام کر رہے ہیں، جو قدم بہ قدم آپ کے ساتھ رکھے جاتے ہیں۔ سرگرمی وہ ہے جو اسسٹنٹ نے آپ کے لیے کیا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标是你正在做的事，会一步一步陪你记录。活动是助手为你做过的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標是你正在做的事，會一步一步陪你記錄。活動是助理為你做過的事。"
          }
        }
      }
    },
    "Goals can't be saved right now." : {
      "comment" : "Goals screen: the store is unavailable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ الأهداف الآن."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las metas no se pueden guardar en este momento."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les objectifs ne peuvent pas être enregistrés pour le moment."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A célok most nem menthetők."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non è possibile salvare gli obiettivi."
          }
        },
