    },
    "What the last on-device run measured. Speed and first-token time depend on the model, the context length and how warm the phone is." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что измерил последний запуск на устройстве. Скорость и время до первого токена зависят от модели, длины контекста и того, насколько разогрет телефон."
          }
        }
      }
    },
    "What this is" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что это такое"
          }
        }
      }
    },
    "What this phone shows" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
