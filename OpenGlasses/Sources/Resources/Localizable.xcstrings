    "OpenAI no longer offers the realtime model %@, so your saved OpenAI live model now uses %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد OpenAI تقدم نموذج الوقت الفعلي %1$@، لذا يستخدم نموذجك المباشر المحفوظ من OpenAI الآن %2$@."
          }
        },
