          }
        }
      }
    },
    "Opens the settings %@ keeps out of the technician's view. Its locks still apply to everyone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح الإعدادات التي يحتفظ %1$@ بإخفائها عن صاحب التقنية. لا تزال قفلاتها تنطبق على الجميع."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre los ajustes que %@ mantiene fuera de la vista del técnico. Sus bloqueos siguen aplicando para todos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre les réglages que %1$@ garde hors de la vue du technicien. Ses verrous s'appliquent toujours à tout le monde."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megnyitja a beállításokat. %1$@ távol tartja a technikus látóterét. Zárai továbbra is mindenkire vonatkoznak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre le impostazioni che %1$@ tiene nascoste alla vista del tecnico. Le sue serrature valgono ancora per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術者の視界から%1$@が隠す設定を開きます。そのロックは全員に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@가 기술자의 시야에 들어가지 않는 설정을 엽니다. 잠금은 여전히 ​​모든 사람에게 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent de instellingen die %1$@ buiten het zicht van de technicus houdt. De sloten gelden nog steeds voor iedereen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre as configurações que %1$@ mantém fora da visão do técnico. Seus bloqueios ainda se aplicam a todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает настройки, которые %@ скрывает от техника. Его блокировки по-прежнему действуют на всех."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ ترتیبات کھولتا ہے جو %@ ٹیکنیشن کی نظر سے اوجھل رکھتا ہے۔ اس کے لاکس اب بھی سب پر لاگو ہوتے ہیں۔"
          }
