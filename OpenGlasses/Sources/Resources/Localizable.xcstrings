        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계를 멈추고, 녹음을 마친 후, 보낼 수 있는 곳으로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop de klok, voltooit het record en brengt je er naartoe zodat je het kunt verzenden."
