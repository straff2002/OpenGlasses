    "Check-ins are paused while Agentic Features is off. Your goal stays as it is." : {
      "comment" : "Goals screen: check-ins need Agent Mode.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتابعات متوقفة مؤقتًا ما دامت «ميزات الوكيل» متوقفة. يبقى هدفك كما هو."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los seguimientos están en pausa mientras las funciones de agente estén desactivadas. Tu meta se queda como está."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points de suivi sont suspendus tant que les fonctionnalités agentiques sont désactivées. Votre objectif reste tel quel."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rákérdezések szünetelnek, amíg az „Ügynöki jellemzők” ki van kapcsolva. A célja változatlan marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti sono sospesi finché le caratteristiche agentiche sono disattivate. Il tuo obiettivo resta com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェント機能がオフの間は、チェックインは一時停止されます。目標はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 기능이 꺼져 있는 동안 체크인은 일시 중지됩니다. 목표는 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-ins zijn gepauzeerd zolang Agent-functies uit staan. Uw doel blijft zoals het is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os acompanhamentos ficam pausados enquanto os Recursos de agente estiverem desativados. Sua meta permanece como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверки приостановлены, пока агентные функции выключены. Ваша цель остаётся без изменений."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب تک ایجنٹک فیچرز آف ہیں، چیک اِنز موقوف ہیں۔ آپ کا ہدف جوں کا توں رہتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“能动特征”关闭期间，跟进已暂停。你的目标保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自主特徵」關閉期間，跟進已暫停。你的目標維持不變。"
          }
        }
      }
    },
