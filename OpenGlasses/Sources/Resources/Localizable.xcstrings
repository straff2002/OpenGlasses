          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo riproduci al telefono. Non viene inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話で再生します。何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전화로 재생합니다. 아무것도 전송되지 않습니다."
