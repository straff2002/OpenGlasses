        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ модели ИИ не входит в профиль. Вы введёте его на этом телефоне далее, и он останется здесь."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ماڈل کی کلید پروفائل کا حصہ نہیں ہے۔ آپ اسے اگلے مرحلے میں اسی فون پر درج کریں گے، اور یہ یہیں رہے گی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
