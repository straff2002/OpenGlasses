    },
    "ChatGPT is connected, but its model list couldn't be loaded. You can continue with the current default and refresh models later in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT متصل، لكن تعذّر تحميل قائمة نماذجه. يمكنك المتابعة بالنموذج الافتراضي الحالي وتحديث النماذج لاحقًا في الإعدادات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT está conectado, pero no se pudo cargar su lista de modelos. Puedes continuar con el valor predeterminado actual y actualizar los modelos más tarde en Configuración."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT est connecté, mais sa liste de modèles n’a pas pu être chargée. Vous pouvez continuer avec la valeur par défaut actuelle et actualiser les modèles plus tard dans Réglages."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ChatGPT csatlakoztatva van, de a modelllistáját nem sikerült betölteni. Folytathatja a jelenlegi alapértelmezéssel, és később frissítheti a modelleket a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT è collegato, ma non è stato possibile caricare il suo elenco di modelli. Puoi continuare con quello predefinito attuale e aggiornare i modelli più tardi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPTには接続されていますが、モデル一覧を読み込めませんでした。現在のデフォルトのまま続けて、後で設定からモデルを更新できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT는 연결되었지만 모델 목록을 불러올 수 없었습니다. 현재 기본값으로 계속하고 나중에 설정에서 모델을 새로 고칠 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT is verbonden, maar de modellijst kon niet worden geladen. U kunt doorgaan met de huidige standaard en de modellen later vernieuwen in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ChatGPT está conectado, mas não foi possível carregar a lista de modelos. Você pode continuar com o padrão atual e atualizar os modelos depois em Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT подключён, но список его моделей загрузить не удалось. Можно продолжить с текущей моделью по умолчанию и обновить модели позже в Настройках."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT منسلک ہے، لیکن اس کے ماڈلز کی فہرست لوڈ نہیں ہو سکی۔ آپ موجودہ ڈیفالٹ کے ساتھ جاری رکھ سکتے ہیں اور بعد میں ترتیبات میں ماڈلز ریفریش کر سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT 已连接，但无法载入其模型列表。你可以继续使用当前默认设置，稍后在“设置”中刷新模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT 已連接，但無法載入其模型清單。你可以先使用目前的預設值，之後再到「設定」重新整理模型。"
          }
        }
      }
    },
    "ChatGPT rejected the sign-in (HTTP %lld). Sign out and sign in again — if it persists, the backend contract may have changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض ChatGPT تسجيل الدخول (HTTP %lld). سجّل الخروج ثم سجّل الدخول مرة أخرى — وإذا استمرت المشكلة فقد يكون عقد الواجهة الخلفية قد تغيّر."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT rechazó el inicio de sesión (HTTP %lld). Cierra sesión y vuelve a iniciarla; si persiste, puede que el contrato del backend haya cambiado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT a rejeté la connexion (HTTP %lld). Déconnectez-vous puis reconnectez-vous — si le problème persiste, le contrat du serveur a peut-être changé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ChatGPT elutasította a bejelentkezést (HTTP %lld). Jelentkezzen ki, majd újra be — ha a hiba marad, a háttérszolgáltatás szerződése megváltozhatott."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT ha rifiutato l'accesso (HTTP %lld). Esci e accedi di nuovo; se il problema persiste, il contratto del backend potrebbe essere cambiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPTがサインインを拒否しました（HTTP %lld）。サインアウトしてもう一度サインインしてください。それでも直らない場合は、バックエンドの仕様が変わった可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT가 로그인을 거부했습니다(HTTP %lld). 로그아웃한 후 다시 로그인하세요. 계속되면 백엔드 규약이 변경되었을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT heeft de aanmelding geweigerd (HTTP %lld). Meld u af en weer aan — als het blijft gebeuren, is het backendcontract mogelijk gewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ChatGPT recusou o login (HTTP %lld). Saia e entre de novo — se persistir, o contrato do backend pode ter mudado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT отклонил вход (HTTP %lld). Выйдите и войдите снова — если это повторяется, возможно, изменился контракт серверной части."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT نے سائن اِن مسترد کر دیا (HTTP %lld)۔ سائن آؤٹ کر کے دوبارہ سائن اِن کریں — اگر مسئلہ برقرار رہے تو ہو سکتا ہے بیک اینڈ کا معاہدہ بدل گیا ہو۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatGPT 拒绝了登录（HTTP %lld）。请退出登录后重新登录 — 如果问题仍然存在，可能是后端约定已更改。"
