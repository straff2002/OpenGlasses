    "Hidden is not locked: the administrator can open everything else, but the locks above still apply to everyone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المخفي غير مقفل: يمكن للمسؤول فتح كل شيء آخر، لكن الأقفال أعلاه لا تزال تنطبق على الجميع."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculto no es bloqueado: el administrador puede abrir todo lo demás, pero los bloqueos de arriba siguen aplicando para todos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché n'est pas verrouillé : l'administrateur peut tout ouvrir, mais les verrous ci-dessus s'appliquent toujours à tout le monde."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Hidden nincs zárolva: a rendszergazda minden mást megnyithat, de a fenti zárolások továbbra is mindenkire vonatkoznak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascosto non è bloccato: l'amministratore può aprire tutto il resto, ma i blocchi sopra si applicano comunque a tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示はロックされていません: 管理者は他のすべてを開くことができますが、上記のロックは引き続き全員に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨김은 잠겨 있지 않습니다. 관리자는 다른 모든 항목을 열 수 있지만 위의 잠금은 여전히 모든 사람에게 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen is niet op slot: de beheerder kan al het andere openen, maar de bovenstaande vergrendelingen gelden nog steeds voor iedereen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculto não está bloqueado: o administrador pode abrir todo o resto, mas os bloqueios acima ainda se aplicam a todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыто — не значит заблокировано: администратор может открыть всё остальное, но блокировки выше по-прежнему применяются ко всем."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوشیدہ کا مطلب مقفل نہیں: منتظم باقی سب کچھ کھول سکتا ہے، لیکن اوپر والے لاک سب پر بدستور لاگو ہوتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏未锁定：管理员可以打开其他所有内容，但上面的锁仍对所有人适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏未鎖定：管理員可以打開其他所有項目，但上面的鎖仍適用於所有人。"
          }
        }
      }
    },
