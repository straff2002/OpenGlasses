    "Disabled personas won't listen for their wake word." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشخصيات المعطلة لن تستمع إلى كلمة الاستيقاظ الخاصة بها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas desactivadas no escucharán su palabra de activación."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personas désactivés n'écouteront pas leur mot d'activation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fogyatékkal élő személyek nem figyelnek az ébresztő szavukra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone disabili non ascolteranno la loro parola sveglia."
