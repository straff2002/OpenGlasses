    "Let Agents See" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح للوكلاء بالرؤية"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que los agentes vean"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser voir les agents"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ügynökök láthatnak"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vedere agli agenti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントに見せる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트에게 보여주기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agents laten kijken"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixar os agentes verem"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить агентам видеть"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایجنٹس کو دیکھنے دیں"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让代理看见"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓代理看見"
          }
        }
      }
    },
    "Lets a gateway agent ask Avenkin to act (speak, show text on the glasses, check status — and with capture enabled, take photos, record, or read back the recent transcript). Everything is denied while Agent Mode is off; capture always asks for confirmation and announces itself before a sensor starts or recorded speech is read back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح لوكيل البوابة بطلب Avenkin للعمل (التحدث، عرض نص على النظارات، التحقق من الحالة — ومع تمكين الالتقاط، التقاط الصور، التسجيل، أو قراءة النص الأخير). كل شيء مرفوض بينما يكون وضع الوكيل متوقفًا؛ الالتقاط دائمًا يطلب التأكيد ويعلن عن نفسه قبل أن يبدأ المستشعر أو يتم قراءة الكلام المسجل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que un agente de la puerta de enlace le pida a Avenkin que actúe (hablar, mostrar texto en los lentes, revisar el estado y, con la captura activada, tomar fotos, grabar o leer la transcripción reciente). Todo se deniega mientras el modo agente está desactivado; la captura siempre pide confirmación y se anuncia antes de que arranque un sensor o de que se lea voz grabada."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à un agent de passerelle de demander à Avenkin d'agir (parler, afficher du texte sur les lunettes, vérifier le statut — et avec la capture activée, prendre des photos, enregistrer ou lire la transcription récente). Tout est refusé lorsque le mode agent est désactivé; la capture demande toujours une confirmation et s'annonce avant qu'un capteur ne commence ou qu'un discours enregistré soit lu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehetővé teszi, hogy az átjáróügynök felkérje a Avenkin-t, hogy cselekedjen (beszéljen, mutasson szöveget a szemüvegen, ellenőrizze az állapotot – és ha a rögzítés engedélyezve van, készítsen fényképeket, rögzítse vagy olvassa vissza a legutóbbi átiratot). Minden le van tiltva, amíg az Ügynök mód ki van kapcsolva; A rögzítés mindig megerősítést kér, és bejelenti magát, mielőtt az érzékelő elindul, vagy a rögzített beszédet visszaolvassák."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a un agente gateway di chiedere a Avenkin di agire (parlare, mostrare testo sugli occhiali, controllare lo stato e, con l'acquisizione abilitata, scattare foto, registrare o rileggere la trascrizione recente). Tutto è negato mentre la modalità agente è disattivata; l'acquisizione richiede sempre conferma e si annuncia prima dell'avvio di un sensore o della rilettura del parlato registrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイエージェントがAvenkinに行動（話す、メガネにテキストを表示、ステータスを確認 — そしてキャプチャが有効な場合は、写真を撮る、録音する、または最近のテキストを読み返す）を依頼できるようにします。エージェントモードがオフの間はすべて拒否されます。キャプチャは常に確認を求め、センサーが起動する前または録音された音声が読み返される前に通知されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게이트웨이 에이전트가 Avenkin에게 작업(말하기, 안경에 텍스트 표시하기, 상태 확인하기, 캡처가 활성화된 상태에서 사진 찍기, 녹음하기, 최근 기록 읽기)하도록 요청할 수 있습니다. 에이전트 모드가 꺼져 있으면 모든 것이 거부됩니다. 캡처는 항상 확인을 요청하고 센서가 시작되거나 녹음된 음성을 다시 읽기 전에 스스로 알려줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat een gateway-agent Avenkin vragen om actie te ondernemen (spreken, tekst op de bril weergeven, status controleren - en als vastleggen is ingeschakeld, foto's maken, opnemen of het recente transcript teruglezen). Alles wordt geweigerd als de Agent-modus is uitgeschakeld; capture vraagt ​​altijd om bevestiging en kondigt zichzelf aan voordat een sensor start of opgenomen spraak wordt teruggelezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que um agente de gateway peça a Avenkin para agir (falar, mostrar texto nos óculos, verificar o status – e com a captura habilitada, tirar fotos, gravar ou ler a transcrição recente). Tudo é negado enquanto o Modo Agente está desligado; A captura sempre pede confirmação e se anuncia antes que um sensor seja iniciado ou que a fala gravada seja lida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет шлюзовому агенту давать команды Avenkin (говорить, показывать текст на очках, проверять статус, а при включённой съёмке — делать фото, записывать видео или зачитывать недавнюю расшифровку). Пока режим агента выключен, всё запрещено; съёмка всегда запрашивает подтверждение и предупреждает о себе перед запуском датчика или чтением записанной речи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک گیٹ وے ایجنٹ کو Avenkin سے کام کروانے کی اجازت دیتا ہے (بولنا، عینک پر متن دکھانا، اسٹیٹس چیک کرنا — اور کیپچر فعال ہونے پر تصاویر لینا، ریکارڈ کرنا، یا حالیہ ٹرانسکرپٹ پڑھ کر سنانا)۔ ایجنٹ موڈ آف ہونے پر سب کچھ مسترد ہوتا ہے؛ کیپچر ہمیشہ تصدیق مانگتا ہے اور کسی سینسر کے شروع ہونے یا ریکارڈ شدہ گفتگو پڑھ کر سنانے سے پہلے اپنا اعلان کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许网关代理请求 Avenkin 执行操作（说话、在眼镜上显示文本、检查状态——在启用捕获的情况下，可拍照、录音或回读最近的记录）。代理模式关闭时，所有操作均被拒绝；捕获始终需要确认，并在传感器启动或录音回读前自我声明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許網關代理請求 Avenkin 執行動作（說話、在眼鏡上顯示文字、檢查狀態——並且在啟用捕捉時，可拍照、錄音或回讀最近的文字記錄）。當代理模式關閉時一切操作皆被拒絕；捕捉操作總是要求確認，並在啟動感測器或回讀錄音前自我宣布。"
          }
        }
      }
    },
