    "Port 8642 is where Hermes's API server listens. If that's what you set up, switch Connection to API server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنفذ 8642 هو الذي يستمع عليه خادم API الخاص بـ Hermes. إذا كان هذا ما أعددته، فبدّل «الاتصال» إلى خادم API."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puerto 8642 es donde escucha el servidor de API de Hermes. Si eso es lo que configuraste, cambia Conexión a Servidor de API."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le port 8642 est celui où écoute le serveur API de Hermes. Si c’est ce que vous avez configuré, réglez Connexion sur Serveur API."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 8642-es porton figyel a Hermes API-kiszolgálója. Ha ezt állította be, váltson a Csatlakozás beállítást API-kiszolgálóra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La porta 8642 è quella su cui ascolta il server API di Hermes. Se è ciò che hai configurato, imposta Connessione su Server API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポート8642は、HermesのAPIサーバーが待ち受けるポートです。それを設定した場合は、接続を「APIサーバー」に切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포트 8642는 Hermes의 API 서버가 연결을 받는 포트입니다. 해당 서버를 설정하셨다면 연결을 'API 서버'로 바꾸세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poort 8642 is waar de API-server van Hermes op luistert. Als u dat hebt ingesteld, zet Verbinding dan op API-server."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A porta 8642 é onde o servidor de API do Hermes escuta. Se foi isso que você configurou, mude Conexão para Servidor de API."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт 8642 — это порт, на котором слушает API-сервер Hermes. Если вы настроили именно его, переключите «Подключение» на «API-сервер»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پورٹ 8642 پر Hermes کا API سرور سنتا ہے۔ اگر آپ نے یہی سیٹ اپ کیا ہے تو کنکشن کو API سرور پر سوئچ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8642 端口是 Hermes 的 API 服务器所监听的端口。如果你设置的是它，请将“连接”切换为 API 服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接埠 8642 是 Hermes 的 API 伺服器所監聽的連接埠。如果你設定的是它，請將「連線」切換為 API 伺服器。"
          }
        }
      }
    },
    "Port 8765 is where the glasses bridge script listens. If that's what you set up, switch Connection to Bridge script." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنفذ 8765 هو الذي يستمع عليه البرنامج النصي لجسر النظارات. إذا كان هذا ما أعددته، فبدّل «الاتصال» إلى البرنامج النصي للجسر."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puerto 8765 es donde escucha el script puente de los lentes. Si eso es lo que configuraste, cambia Conexión a Script puente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le port 8765 est celui où écoute le script de pont des lunettes. Si c’est ce que vous avez configuré, réglez Connexion sur Script de pont."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 8765-ös porton figyel a szemüveg híd szkriptje. Ha ezt állította be, váltson a Csatlakozás beállítást Híd szkriptre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La porta 8765 è quella su cui ascolta lo script ponte degli occhiali. Se è ciò che hai configurato, imposta Connessione su Script ponte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポート8765は、メガネ用ブリッジスクリプトが待ち受けるポートです。それを設定した場合は、接続を「ブリッジスクリプト」に切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포트 8765는 안경 브리지 스크립트가 연결을 받는 포트입니다. 해당 스크립트를 설정하셨다면 연결을 '브리지 스크립트'로 바꾸세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poort 8765 is waar het bridge-script voor de bril op luistert. Als u dat hebt ingesteld, zet Verbinding dan op Bridge-script."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A porta 8765 é onde o script de ponte dos óculos escuta. Se foi isso que você configurou, mude Conexão para Script de ponte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт 8765 — это порт, на котором слушает скрипт-мост для очков. Если вы настроили именно его, переключите «Подключение» на «Скрипт-мост»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پورٹ 8765 پر عینک کا برج اسکرپٹ سنتا ہے۔ اگر آپ نے یہی سیٹ اپ کیا ہے تو کنکشن کو برج اسکرپٹ پر سوئچ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8765 端口是眼镜桥接脚本所监听的端口。如果你设置的是它，请将“连接”切换为桥接脚本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接埠 8765 是眼鏡橋接腳本所監聽的連接埠。如果你設定的是它，請將「連線」切換為橋接腳本。"
          }
        }
