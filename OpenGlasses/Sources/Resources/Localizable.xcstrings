    "This model can't use tools on Chat Completions, so tool turns use the Responses API." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا النموذج استخدام الأدوات على Chat Completions، لذا تستخدم أدوار الأدوات Responses API."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo no puede usar herramientas en Chat Completions, así que los turnos con herramientas usan la API Responses."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce modèle ne peut pas utiliser d’outils sur Chat Completions; les tours avec outils utilisent donc l’API Responses."
