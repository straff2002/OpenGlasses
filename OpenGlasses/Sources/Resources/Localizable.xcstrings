        }
      }
    },
    "Some protected files could not be removed. Unlock the phone and retry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذرت إزالة بعض الملفات المحمية. افتح قفل الهاتف وأعد المحاولة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron quitar algunos archivos protegidos. Desbloquea el celular e intenta de nuevo."
