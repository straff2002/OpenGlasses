    "Edit it if it came out wrong — only what's here is sent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حررها إذا ظهرت بشكل خاطئ — فقط ما هو موجود هنا سيتم إرساله."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edítalo si salió mal; solo se envía lo que está aquí."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez-le s'il est sorti incorrect — seul ce qui est ici est envoyé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szerkessze, ha rosszul jött ki – csak az itt található tartalmat küldi el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificalo se è risultato sbagliato: viene inviato solo ciò che è qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違って出た場合は編集してください — 送信されるのはここにある内容だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘못 나온 경우 수정하세요. 여기에 있는 내용만 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerk het als het verkeerd uitpakt: alleen wat hier staat wordt verzonden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edite-o se estiver errado – apenas o que está aqui é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отредактируйте, если получилось не так, как надо, — отправляется только то, что здесь."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر غلط آیا ہو تو اس میں ترمیم کریں — صرف وہی بھیجا جائے گا جو یہاں ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果出现错误，请编辑——只会发送此处的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果輸出錯誤，請編輯 — 只有這裡的內容會被傳送。"
          }
        }
      }
