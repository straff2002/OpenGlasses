    "There wasn't room to write the file. Free up space and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تتوفر مساحة لكتابة الملف. حرّر مساحة وحاول مرة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No había espacio para escribir el archivo. Libera espacio e intenta de nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y avait pas assez d’espace pour écrire le fichier. Libérez de l’espace et réessayez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem volt elég hely a fájl megírásához. Szabadítson fel helyet, és próbálja újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'era spazio per scrivere il file. Libera spazio e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを書き込む空き容量がありませんでした。空き容量を確保して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 쓸 공간이 부족했습니다. 공간을 확보한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er was geen ruimte om het bestand te schrijven. Maak ruimte vrij en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não havia espaço para gravar o arquivo. Libere espaço e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не хватило места, чтобы записать файл. Освободите место и повторите попытку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فائل لکھنے کے لیے جگہ نہیں تھی۔ جگہ خالی کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有足够空间写入该文件。请腾出空间后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空間不足，無法寫入檔案。請釋出空間後再試一次。"
          }
        }
      }
    },
