          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить модели для вашей учётной записи xAI. Выйдите и войдите снова или введите ID модели ниже."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے xAI اکاؤنٹ کے ماڈلز لوڈ نہیں ہو سکے۔ سائن آؤٹ کر کے دوبارہ سائن اِن کریں، یا نیچے ماڈل ID لکھیں۔"
