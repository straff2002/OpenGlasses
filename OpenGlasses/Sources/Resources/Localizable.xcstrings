    "Skip this section if you don't run your own server — most users won't need a gateway." : {
      "comment" : "A description of the gateway settings screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخطي هذا القسم إذا لم تقم بتشغيل خادمك الخاص — معظم المستخدمين لن يحتاجوا إلى بوابة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite esta sección si no ejecutas tu propio servidor; la mayoría de los usuarios no necesitan una puerta de enlace."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer cette section si vous ne gérez pas votre propre serveur — la plupart des utilisateurs n’auront pas besoin d’une passerelle."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha nem saját szervert futtat, hagyja ki ezt a részt – a legtöbb felhasználónak nincs szüksége átjáróra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta questa sezione se non gestisci il tuo server: la maggior parte degli utenti non avrà bisogno di un gateway."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のサーバーを運営していない場合、このセクションをスキップ — ほとんどのユーザーはゲートウェイを必要としません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자체 서버를 실행하지 않는 경우 이 섹션을 건너뛰십시오. 대부분의 사용자에게는 게이트웨이가 필요하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla deze sectie over als u uw eigen server niet beheert — de meeste gebruikers hebben geen gateway nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pule esta seção se você não executa seu próprio servidor — a maioria dos usuários não precisará de um gateway."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустите этот раздел, если у вас нет собственного сервера — большинству пользователей шлюз не нужен."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر آپ اپنا سرور نہیں چلاتے تو یہ حصہ چھوڑ دیں — زیادہ تر صارفین کو گیٹ وے کی ضرورت نہیں ہوگی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你不运行自己的服务器，请跳过此部分 — 大多数用户不需要网关。"
          }
