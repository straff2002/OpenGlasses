    "%@ refused the voice request, so replies use another voice. Check the key and voice in Settings › Connections › Services & Integrations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض %@ طلب الصوت، لذا تستخدم الردود صوتًا آخر. تحقق من المفتاح والصوت في الإعدادات › الاتصالات › الخدمات والتكاملات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rechazó la solicitud de voz, así que las respuestas usan otra voz. Revisa la clave y la voz en Configuración › Conexiones › Servicios e integraciones."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a refusé la demande de voix, donc les réponses utilisent une autre voix. Vérifiez la clé et la voix dans Réglages › Connexions › Services et intégrations."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ visszautasította a hangkérést, ezért a válaszok másik hangot használnak. Ellenőrizze a kulcsot és a hangot itt: Beállítások › Kapcsolatok › Szolgáltatások és integrációk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha rifiutato la richiesta vocale, quindi per le risposte viene utilizzata un’altra voce. Controlla la chiave e la voce in Impostazioni › Connessioni › Servizi e integrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が音声リクエストを拒否したため、返信は別の音声を使用します。設定 › 接続 › サービスと連携でキーと音声を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@가 음성 요청을 거부하여 답변에 다른 음성이 사용됩니다. 설정 › 연결 › 서비스 및 연동에서 키와 음성을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft het spraakverzoek geweigerd, dus antwoorden gebruiken een andere stem. Controleer de sleutel en stem in Instellingen › Verbindingen › Diensten en integraties."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recusou a solicitação de voz, então as respostas usam outra voz. Verifique a chave e a voz em Configurações › Conexões › Serviços e integrações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отклонил запрос голоса, поэтому ответы звучат другим голосом. Проверьте ключ и голос в разделе «Настройки › Подключения › Сервисы и интеграции»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے آواز کی درخواست مسترد کر دی، اس لیے جوابات کسی دوسری آواز میں ہیں۔ کلید اور آواز ترتیبات › کنکشنز › سروسز اور انٹیگریشنز میں چیک کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了语音请求，因此回复使用其他语音。请在设置 › 连接 › 服务与集成中检查密钥和语音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒絕了語音請求，因此回覆會使用其他語音。請在 設定 › 連線 › 服務與整合 中檢查金鑰和語音。"
          }
        }
      }
    },
