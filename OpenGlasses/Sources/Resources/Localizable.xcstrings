    "Automatic gives tool turns a small amount of thinking." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنح الوضع التلقائي أدوار الأدوات قدرًا صغيرًا من التفكير."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático da a los turnos con herramientas un poco de razonamiento."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode automatique, les tours avec outils reçoivent un peu de réflexion."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus beállítás kevés gondolkodást ad az eszközös köröknek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Automatico i turni con strumenti ricevono un po' di ragionamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動では、ツールを使うターンにわずかな思考を行わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 도구 턴에 약간의 사고 시간을 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij Automatisch krijgen beurten met tools een beetje denktijd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo automático dá às interações com ferramentas uma pequena dose de raciocínio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматический режим даёт шагам с инструментами немного времени на размышление."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خودکار حالت ٹول والی باریوں کو تھوڑی سی سوچ دیتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会让工具轮次进行少量思考。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會讓工具回合進行少量思考。"
          }
        }
      }
    },
    "Automatic keeps a model that thinks before every answer at its lowest effort, to keep answers quick." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي الوضع التلقائي النموذج الذي يفكر قبل كل إجابة عند أدنى مستوى من الجهد، للحفاظ على سرعة الإجابات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático mantiene en su esfuerzo más bajo a un modelo que piensa antes de cada respuesta, para que las respuestas sean rápidas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode automatique, un modèle qui réfléchit avant chaque réponse reste à son effort minimal, pour des réponses rapides."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus beállítás a minden válasz előtt gondolkodó modellt a legalacsonyabb erőfeszítési szinten tartja, hogy a válaszok gyorsak maradjanak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Automatico un modello che ragiona prima di ogni risposta resta al minimo sforzo, per risposte rapide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動では、回答の前に毎回考えるモデルを最小の負荷に保ち、回答を速くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
