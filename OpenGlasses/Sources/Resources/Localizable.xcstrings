    "Doubao rejected the speech session. Check its API key, model version and voice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض Doubao الجلسة الصوتية. تحقق من مفتاح API وإصدار النموذج والصوت."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao rechazó la sesión de voz. Revisa su clave de API, la versión del modelo y la voz."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao a refusé la session vocale. Vérifiez sa clé API, la version du modèle et la voix."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Doubao elutasította a hangmunkamenetet. Ellenőrizze az API-kulcsot, a modellverziót és a hangot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao ha rifiutato la sessione vocale. Controlla la chiave API, la versione del modello e la voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao が音声セッションを拒否しました。API キー、モデルバージョン、音声を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao가 음성 세션을 거부했습니다. API 키, 모델 버전, 음성을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao heeft de spraaksessie geweigerd. Controleer de API-sleutel, modelversie en stem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Doubao rejeitou a sessão de voz. Verifique a chave de API, a versão do modelo e a voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao отклонил речевой сеанс. Проверьте ключ API, версию модели и голос."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao نے اسپیچ سیشن مسترد کر دیا۔ اس کی API کلید، ماڈل ورژن اور آواز چیک کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao 拒绝了语音会话。请检查其 API 密钥、模型版本和音色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubao 拒絕了語音工作階段。請檢查其 API 金鑰、模型版本和聲音。"
          }
        }
      }
    },
    "Double-tap and hold to mute the microphone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مرتين مع الضغط لكتم الميكروفون."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces y mantén presionado para silenciar el micrófono."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez deux fois puis maintenez pour désactiver le microphone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson duplán és tartsa lenyomva a mikrofon elnémításához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte e tieni premuto per disattivare il microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクをミュートするにはダブルタップして保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크를 음소거하려면 두 번 탭하고 길게 누르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik en houd vast om de microfoon te dempen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes e segure para silenciar o microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды нажмите и удерживайте, чтобы выключить микрофон."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مائیکروفون میوٹ کرنے کے لیے ڈبل ٹیپ کر کے دبائے رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击并按住以静音麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙擊並按住以靜音麥克風。"
          }
        }
      }
    },
    "Double-tap and hold to unmute the microphone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مرتين مع الضغط لإلغاء كتم الميكروفون."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces y mantén presionado para reactivar el micrófono."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez deux fois et maintenez pour réactiver le microphone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson duplán és tartsa lenyomva a mikrofon némításának feloldásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte e tieni premuto per riattivare il microfono."
          }
        },
        "ja" : {
