    "Configurable auto-purge removes transcripts and recordings older than the retention period. Supports secure deletion (data overwrite before removal)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل الحذف التلقائي القابل للضبط النصوص والتسجيلات الأقدم من مدة الاحتفاظ. يدعم الحذف الآمن (الكتابة فوق البيانات قبل الإزالة)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La purga automática configurable elimina las transcripciones y grabaciones más antiguas que el periodo de retención. Admite eliminación segura (sobrescritura de los datos antes de borrarlos)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La purge automatique configurable supprime les transcriptions et enregistrements plus anciens que la période de conservation. Prend en charge la suppression sécurisée (écrasement des données avant retrait)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beállítható automatikus törlés eltávolítja a megőrzési időnél régebbi átiratokat és felvételeket. Támogatja a biztonságos törlést (az adatok felülírása eltávolítás előtt)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eliminazione automatica configurabile rimuove trascrizioni e registrazioni più vecchie del periodo di conservazione. Supporta la cancellazione sicura (sovrascrittura dei dati prima della rimozione)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動消去を設定すると、保持期間より古い文字起こしと録音が削除されます。安全な削除（削除前のデータ上書き）に対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 가능한 자동 삭제는 보존 기간이 지난 대화 기록과 녹음을 제거합니다. 보안 삭제(제거 전 데이터 덮어쓰기)를 지원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configureerbaar automatisch wissen verwijdert transcripties en opnames die ouder zijn dan de bewaartermijn. Ondersteunt veilig verwijderen (gegevens overschrijven vóór verwijdering)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A limpeza automática configurável remove transcrições e gravações mais antigas que o período de retenção. Oferece exclusão segura (sobrescrita dos dados antes da remoção)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настраиваемая автоочистка удаляет расшифровки и записи старше срока хранения. Поддерживает безопасное удаление (перезапись данных перед удалением)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قابلِ ترتیب خودکار صفائی برقرار رکھنے کی مدت سے پرانی ٹرانسکرپٹس اور ریکارڈنگز ہٹا دیتی ہے۔ محفوظ حذف (ہٹانے سے پہلے ڈیٹا اوور رائٹ) کی سہولت دیتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可配置的自动清除会删除超过保留期限的转录和录音。支持安全删除（移除前覆写数据）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可設定的自動清除會移除超過保留期限的逐字稿與錄音。支援安全刪除（移除前先覆寫資料）。"
          }
        }
      }
    },
