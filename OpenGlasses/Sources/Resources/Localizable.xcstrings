    "Mail couldn't send the report. Copy or share it instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على البريد إرسال التقرير. انسخه أو شاركه بدلاً من ذلك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail no pudo enviar el reporte. Mejor cópialo o compártelo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'envoyer le rapport par courriel. Copiez-le ou partagez-le à la place."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mail nem tudta elküldeni a jelentést. Másolja vagy ossza meg helyette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posta non ha potuto inviare il rapporto. Copialo o condividilo invece."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールがレポートを送信できませんでした。代わりにコピーするか共有してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일에서 보고서를 보낼 수 없습니다. 대신 복사하거나 공유하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail kon het rapport niet verzenden. Kopieer of deel het in plaats daarvan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mail não conseguiu enviar o relatório. Copie ou compartilhe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почте не удалось отправить отчёт. Скопируйте его или отправьте другим способом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میل رپورٹ نہیں بھیج سکا۔ اس کے بجائے اسے کاپی یا اشتراک کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件无法发送报告。请复制或分享它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "郵件無法發送報告。請改為複製或分享它。"
          }
        }
      }
    },
