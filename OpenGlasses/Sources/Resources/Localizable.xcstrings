    "The MCP endpoint URL. %@ connections aren't wired for live calls yet — the server will be saved but won't connect until SSE support ships." : {
      "comment" : "A note that a live connection isn't yet supported for a given transport.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رابط نهاية نقطة MCP. اتصالات %1$@ غير مجهزة بعد للمكالمات الحية — سيتم حفظ الخادم ولكن لن يتصل حتى يتم إصدار دعم SSE."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La URL del endpoint MCP. Las conexiones %@ aún no funcionan con llamadas en vivo: el servidor se guardará, pero no se conectará hasta que haya compatibilidad con SSE."
