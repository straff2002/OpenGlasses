    "This installation's record no longer matches the files on disk, so it can't be trusted to load. Remove it and download it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد سجل هذا التثبيت يطابق الملفات على القرص، لذا لا يمكن الوثوق به للتحميل. أزله ثم حمّله مرة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de esta instalación ya no coincide con los archivos del disco, así que no se puede confiar en que cargue. Quítala y descárgala de nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement de cette installation ne correspond plus aux fichiers sur le disque; on ne peut donc pas lui faire confiance pour le chargement. Retirez-le et téléchargez-le de nouveau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek a telepítésnek a rekordja már nem egyezik a lemezen lévő fájlokkal, ezért nem megbízható a betöltés. Távolítsa el, és töltse le újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il record di questa installazione non corrisponde più ai file sul disco, quindi non ci si può fidare per caricarla. Rimuovila e scaricala di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このインストールの記録がディスク上のファイルと一致しなくなったため、読み込みは信頼できません。削除してから、もう一度ダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설치의 기록이 더 이상 디스크의 파일과 일치하지 않아 안전하게 불러올 수 없습니다. 제거한 후 다시 다운로드하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het record van deze installatie komt niet meer overeen met de bestanden op de schijf, dus er kan niet op worden vertrouwd om te laden. Verwijder het en download het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro desta instalação não corresponde mais aos arquivos no disco, então não é confiável para carregar. Remova-o e baixe de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись этой установки больше не совпадает с файлами на диске, поэтому ей нельзя доверять при загрузке. Удалите её и загрузите заново."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس انسٹالیشن کا ریکارڈ اب ڈسک کی فائلوں سے مطابقت نہیں رکھتا، اس لیے لوڈ کرنے کے لیے اس پر بھروسا نہیں کیا جا سکتا۔ اسے ہٹائیں اور دوبارہ ڈاؤن لوڈ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此安装的记录与磁盘上的文件不再相符，因此不能信任其载入。请移除它并重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這項安裝的紀錄已與磁碟上的檔案不符，因此無法信任它能載入。請移除並重新下載。"
          }
        }
      }
    },
