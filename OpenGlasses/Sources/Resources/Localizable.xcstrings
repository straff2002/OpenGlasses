          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자가 이 전화기 설정을 완료해야 합니다. %1$@에는 여전히 키가 필요합니다."
          }
        },
        "nl" : {
