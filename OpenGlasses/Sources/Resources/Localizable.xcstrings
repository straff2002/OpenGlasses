    "Turn on Vision to send photos to the AI. Leave it off for text-only models." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتشغيل الرؤية لإرسال الصور إلى الذكاء الاصطناعي. اتركها مطفأة للنماذج النصية فقط."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Visión para enviar fotos a la IA. Déjala desactivada con modelos de solo texto."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer Vision pour envoyer des photos à l'IA. Laissez-le désactivé pour les modèles uniquement texte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be a Vision-t, hogy fotókat küldj a MI-nek. Hagyjad kikapcsolva csak szöveges modellekhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Vision per inviare foto all'IA. Lascialo disattivato per i modelli di solo testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VisionをオンにしてAIに写真を送信します。テキストのみのモデルの場合はオフのままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI에 사진을 보내려면 Vision을 켜세요. 텍스트 전용 모델의 경우에는 해제해 두십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Vision aan om foto's naar de AI te sturen. Laat het uit voor alleen tekstmodellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Vision para enviar fotos para a IA. Deixe desativado para modelos somente de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Зрение», чтобы отправлять фото в ИИ. Оставьте выключенным для текстовых моделей."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI کو تصاویر بھیجنے کے لیے وژن آن کریں۔ صرف متن والے ماڈلز کے لیے اسے آف رہنے دیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启 Vision 将照片发送给 AI。文本模型请保持关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 Vision 將照片傳送給 AI。對僅文字模型保持關閉。"
          }
        }
      }
    },
