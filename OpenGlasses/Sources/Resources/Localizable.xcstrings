    "AI-Only" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только ИИ"
          }
        }
      }
    },
    "AI-Only uses the vault to ground responses. Human-Assisted brings a remote expert into the session — coming in v2." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Только ИИ» использует хранилище для обоснования ответов. «С участием человека» подключает к сеансу удалённого эксперта — появится в v2."
          }
        }
      }
    },
    "AirDrop, email, Files, or any installed app" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirDrop, почта, Файлы или любое установленное приложение"
          }
        }
      }
    },
    "All %lld tools available" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступны все инструменты: %lld"
          }
        }
      }
    },
    "All AI queries are processed on-device. No clinical data is sent to cloud providers." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все запросы к ИИ обрабатываются на устройстве. Клинические данные не отправляются облачным провайдерам."
          }
        }
      }
    },
    "All conversations" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все разговоры"
          }
        }
      }
    },
    "All Domains" : {
      "comment" : "A label for a filter that shows all domains.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все домены"
          }
        }
      }
    },
    "All Entities" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все объекты"
          }
        }
      }
    },
    "All providers use the same WebSocket protocol. You can add multiple gateways for failover." : {
      "comment" : "A description of the WebSocket protocol.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все провайдеры используют один и тот же протокол WebSocket. Можно добавить несколько шлюзов для отказоустойчивости."
          }
        }
      }
    },
    "All Recent Requests" : {
      "comment" : "A label displayed above the list of all recent network requests.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все недавние запросы"
          }
        }
