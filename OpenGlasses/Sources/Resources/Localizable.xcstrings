    "These stay exactly as they are. To clear a line, set its count to zero." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى هذه كما هي تمامًا. لمسح سطر، اضبط عدده على صفر."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas se quedan exactamente como están. Para borrar una línea, establece su conteo en cero."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux-ci restent tels quels. Pour effacer une ligne, mettez son décompte à zéro."
