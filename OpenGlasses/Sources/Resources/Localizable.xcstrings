    },
    "What this photograph shows. It is printed under the picture in the report." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что изображено на этой фотографии. Печатается под фото в отчёте."
          }
        }
      }
    },
    "What to ask the AI. For photo actions, the photo is sent alongside this prompt." : {
      "comment" : "A description of what to ask the AI in the prompt field of a Quick Action.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
