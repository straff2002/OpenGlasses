    "Tap + to browse and install AI modes, or add custom personas in Settings." : {
      "comment" : "A description of the action to add a new persona.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط + لتصفح واستخدام أوضاع الذكاء الاصطناعي، أو أضف شخصيات مخصصة في الإعدادات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para explorar e instalar modos de IA, o agrega personas personalizadas en Configuración."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur + pour parcourir et installer les modes IA, ou ajouter des personas personnalisées dans les Paramètres."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érintsd meg a + jelet AI módok böngészéséhez és telepítéséhez, vagy egyéni személyiségek hozzáadásához a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + per sfogliare e installare le modalità AI o aggiungere personaggi personalizzati in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+ をタップして AI モードを閲覧・インストールするか、設定でカスタムペルソナを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+를 눌러 AI 모드를 찾아 설치하거나 설정에서 사용자 정의 페르소나를 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op + om AI-modi te bekijken en te installeren, of voeg aangepaste persona's toe in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
