        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その会話はもはやデバイス上にないか、またはその会話に対してターンが一度も保存されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 대화가 더 이상 장치에 없거나 해당 대화 내용이 저장되지 않았습니다."
