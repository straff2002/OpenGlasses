    "Read from the same status response, so following a run costs no extra requests." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القراءة من نفس استجابة الحالة، بحيث لا تكلف متابعة التشغيل أي طلبات إضافية."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lee de la misma respuesta de estado, así que seguir una ejecución no cuesta solicitudes adicionales."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire à partir de la même réponse de statut, donc suivre une exécution ne coûte pas de requêtes supplémentaires."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugyanabból az állapotválaszból olvassa be, így a futtatás követése nem kerül külön kérésekbe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi dalla stessa risposta sullo stato, quindi seguire un'esecuzione non comporta richieste aggiuntive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じステータス応答から読み取るので、続けて実行しても追加のリクエストは必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동일한 상태 응답에서 읽으므로 후속 실행에 추가 요청 비용이 들지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees van hetzelfde statusantwoord, zodat een vervolgopdracht geen extra verzoeken kost."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia a mesma resposta de status, portanto, seguir uma execução não custa solicitações extras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считывается из того же ответа со статусом, поэтому отслеживание запуска не требует дополнительных запросов."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسی اسٹیٹس جواب سے پڑھا جاتا ہے، اس لیے رن کو فالو کرنے پر کوئی اضافی درخواست نہیں لگتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从相同的状态响应中读取，因此后续运行不需要额外请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從相同的狀態響應中讀取，因此跟隨一次運行不會產生額外請求。"
          }
        }
      }
    },
