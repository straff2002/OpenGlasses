        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FHIRサーバーが認証情報を受け付けませんでした。メディカルエクスポートの設定で確認するか、置き換えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
