          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем продолжать работу, дайте проверить это на месте квалифицированному инспектору по технике безопасности."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کام جاری رکھنے سے پہلے کسی اہل سیفٹی انسپکٹر سے موقع پر تصدیق کروائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在继续工作前，请有资质的安全检查员在现场进行验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在工作繼續之前，請讓合格的安全檢查員現場驗證。"
          }
        }
      }
    },
