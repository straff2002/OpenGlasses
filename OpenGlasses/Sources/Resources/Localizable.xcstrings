          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرامپٹ کو اکیلے بھیجتا ہے، بالکل ویسے جیسے آپ نے اسے ٹائپ کیا ہو۔"
