        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"이(가) 그리드, 위젯, 워치, 렌즈 내 런처에서 제거되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” wordt verwijderd uit het raster, de widget, de watch en de launcher in de lens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" é removido da grade, do widget, do relógio e do iniciador na lente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» удаляется из сетки, виджета, часов и лаунчера в линзах."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” کو گرڈ، ویجٹ، واچ اور لینز کے اندر والے لانچر سے ہٹا دیا گیا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已从网格、小组件、手表和镜内启动器中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已從格狀畫面、小工具、手錶和鏡片內啟動器中移除。"
          }
        }
      }
    },
    "\"%@\" is unavailable while Medical Compliance Mode is on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» غير متاح أثناء تشغيل وضع الامتثال الطبي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" no está disponible mientras el modo de cumplimiento médico está activado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est indisponible lorsque le Mode de conformité médicale est activé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nem érhető el, amíg az Orvosi megfelelőségi mód be van kapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» non è disponibile quando la Modalità di conformità medica è attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医療コンプライアンスモードがオンの間、「%@」は使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의료 규정 준수 모드가 켜져 있는 동안에는 \"%@\"을(를) 사용할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is niet beschikbaar zolang de Medische nalevingsmodus aan staat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" fica indisponível enquanto o Modo de conformidade médica está ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» недоступно, пока включён режим медицинского соответствия."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” میڈیکل کمپلائنس موڈ آن ہونے کے دوران دستیاب نہیں ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启医疗合规模式时，“%@”不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "醫療合規模式開啟時，無法使用「%@」。"
          }
        }
      }
    },
    "“%@” isn't a unit the list keeps" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ليست وحدة تحتفظ بها القائمة"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es una unidad que la lista maneje"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas une unité gérée par la liste"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nem olyan mértékegység, amelyet a lista kezel"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è un’unità gestita dall’elenco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はリストで扱う単位ではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 목록에서 다루는 단위가 아닙니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is geen eenheid die de lijst bijhoudt"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é uma unidade que a lista aceita"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не единица, которую ведёт список"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ایسی اکائی نہیں جو فہرست میں رکھی جاتی ہے"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是清单所保存的单位"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是清單所保存的單位"
          }
        }
      }
    },
    "\"%@\" takes an action you have to confirm yourself, so it can't run from a saved voice action. Ask the assistant for it instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ينفّذ إجراءً يجب أن تؤكده بنفسك، لذا لا يمكن تشغيله من إجراء صوتي محفوظ. اطلب ذلك من المساعد بدلًا من ذلك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" requiere una acción que tienes que confirmar tú, así que no puede ejecutarse desde una acción de voz guardada. Pídesela al asistente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » exige une action que vous devez confirmer vous-même; il ne peut donc pas s’exécuter depuis une action vocale enregistrée. Demandez-le plutôt à l’assistant."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” olyan műveletet hajt végre, amelyet Önnek kell jóváhagynia, ezért nem futtatható mentett hangműveletből. Kérje inkább az asszisztenstől."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» richiede un'azione che devi confermare tu stesso, quindi non può essere eseguita da un'azione vocale salvata. Chiedila invece all'assistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はご自身での確認が必要な操作のため、保存した音声アクションからは実行できません。代わりにアシスタントに依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"은(는) 직접 확인해야 하는 동작이므로 저장된 음성 동작에서 실행할 수 없습니다. 대신 어시스턴트에게 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” voert een actie uit die u zelf moet bevestigen, dus het kan niet vanuit een opgeslagen spraakactie draaien. Vraag het in plaats daarvan aan de assistent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" executa uma ação que você mesmo precisa confirmar, por isso não pode ser executada por uma ação de voz salva. Peça-a ao assistente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» выполняет действие, которое нужно подтверждать самому, поэтому его нельзя запускать из сохранённого голосового действия. Попросите об этом ассистента."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ایسا ایکشن لیتا ہے جس کی تصدیق آپ کو خود کرنی ہوتی ہے، اس لیے یہ محفوظ کردہ صوتی ایکشن سے نہیں چل سکتا۔ اس کے بجائے اسسٹنٹ سے کہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”需要你亲自确认才能执行，因此无法通过已保存的语音操作运行。请改为向助手请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」會執行需要你自行確認的操作，因此無法從已儲存的語音動作中執行。請改為請助理執行。"
          }
        }
      }
    },
    "\"Share the transcript\" or \"Export the recording\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"مشاركة النص\" أو \"تصدير التسجيل\""
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Comparte la transcripción” o “Exporta la grabación”"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Partager la transcription » ou « Exporter l'enregistrement »"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ossza meg az átiratot” vagy „Exportálja a felvételt”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Condividi la trascrizione\" o \"Esporta la registrazione\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「トランスクリプトを共有」または「録音をエクスポート」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"대화 기록 공유\" 또는 \"녹음 내보내기\""
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Deel het transcript' of 'Exporteer de opname'"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Compartilhar a transcrição\" ou \"Exportar a gravação\""
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Поделиться расшифровкой» или «Экспортировать запись»"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ٹرانسکرپٹ کا اشتراک کریں” یا “ریکارڈنگ ایکسپورٹ کریں”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“共享转写文本”或“导出录音”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“共享轉寫文字”或“匯出錄音”"
          }
        }
      }
    },
    "“Take me there” opens this app with directions to the job's address. If it isn't installed, Apple Maps is used and you're told so. The brief is always one tap or one sentence away; switching it on here also reads it when the car connects." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي خيار \"خذني إلى هناك\" إلى فتح هذا التطبيق مع توجيهات إلى عنوان الوظيفة. إذا لم يتم تثبيته، فسيتم استخدام خرائط Apple وسيتم إخبارك بذلك. يكون الموجز دائمًا على بعد نقرة واحدة أو جملة واحدة؛ يؤدي تشغيله هنا أيضًا إلى قراءته عند اتصال السيارة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Llévame ahí” abre esta app con indicaciones a la dirección del trabajo. Si no está instalada, se usa Apple Maps y se te avisa. El resumen siempre está a un toque o a una frase de distancia; al activarlo aquí también se lee cuando el auto se conecta."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Emmène-moi là » ouvre cette application avec les directions vers l'adresse du travail. Si elle n'est pas installée, Apple Plans est utilisé et vous en êtes informé. Le brief est toujours à un clic ou une phrase ; l'activer ici le lit également lorsque la voiture se connecte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Vigyél oda” megnyitja ezt az alkalmazást a munka címéhez vezető útmutatásokkal. Ha nincs telepítve, akkor a rendszer az Apple Maps alkalmazást használja, és ezt meg is kapja. A rövidítés mindig egy koppintással vagy egy mondatnyira van; itt bekapcsolva azt is olvassa, amikor az autó csatlakozik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Portami lì\" apre questa app con le indicazioni per raggiungere l'indirizzo del lavoro. Se non è installato, viene utilizzato Apple Maps e te lo viene detto. Il brief è sempre a un tocco o a una frase di distanza; accendendolo qui lo legge anche quando l'auto si connette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「そこに連れて行って」で、このアプリを開き、仕事先の住所への道順が表示されます。インストールされていない場合は、Apple Mapsが使用され、その旨が通知されます。概要は常にワンタップまたは1文でアクセス可能です。ここでオンにすると、車が接続されたときにも読み上げられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"데려가주세요\"를 누르면 직장 주소로 가는 길 안내가 포함된 이 앱이 열립니다. 설치되어 있지 않으면 Apple Maps가 사용되며 그렇게 안내됩니다. 브리핑은 항상 한 번의 탭 또는 한 문장으로 이루어집니다. 여기에서 켜면 자동차가 연결될 때도 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met 'Breng me daarheen' wordt deze app geopend met een routebeschrijving naar het adres van de baan. Als het niet is geïnstalleerd, wordt Apple Maps gebruikt en wordt u dat verteld. De opdracht is altijd één tik of één zin verwijderd; als je hem hier aanzet, leest hij het ook als de auto verbinding maakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Leve-me lá” abre este aplicativo com instruções para o endereço do trabalho. Se não estiver instalado, o Apple Maps será usado e você será avisado. O briefing está sempre a um toque ou a uma frase de distância; ligá-lo aqui também lê quando o carro se conecta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отвезти меня туда» открывает это приложение с маршрутом до адреса задания. Если оно не установлено, используются Apple Карты, и вам об этом сообщают. Сводка всегда на расстоянии одного касания или одной фразы; включение этой функции также озвучивает её при подключении к автомобилю."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“مجھے وہاں لے چلیں” اس ایپ کو جاب کے پتے کی سمت کے ساتھ کھولتا ہے۔ اگر یہ انسٹال نہیں ہے تو Apple Maps استعمال ہوتا ہے اور آپ کو بتا دیا جاتا ہے۔ بریف ہمیشہ ایک ٹیپ یا ایک جملے کے فاصلے پر ہے؛ اسے یہاں آن کرنے سے گاڑی کے منسلک ہونے پر یہ پڑھ کر بھی سنایا جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“带我去那里”会打开此应用程序，其中包含前往工作地址的路线。如果未安装，则会使用 Apple 地图，并且会告知您这一点。只需轻轻一按或一句话即可获得简报；当汽车连接时，在这里打开它也会读取它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「帶我去那裡」會打開此應用程序，其中包含前往工作地址的路線。如果未安裝，則會使用 Apple 地圖，並會告知您這一點。只需輕輕一按或一句話即可獲得簡報；當汽車連接時，在這裡打開它也會讀取它。"
          }
        }
      }
    },
    "“What's new” — one ranked glance of pending notifications on the HUD or spoken." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"ما الجديد\" — نظرة واحدة مرتبة للإشعارات المعلقة على شاشة HUD أو المنطوقة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Novedades”: un vistazo ordenado de las notificaciones pendientes, en el HUD o en voz alta."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Quoi de neuf » — un coup d'œil classé des notifications en attente sur le HUD ou énoncé à voix haute."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Újdonságok” – egy pillantás a függőben lévő értesítésekre a HUD-on vagy beszédben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Novità\": uno sguardo classificato alle notifiche in sospeso sull'HUD o parlato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「新着情報」—HUDで未処理通知を一目で確認、または音声で確認。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"새로운 기능\" — HUD에 보류 중인 알림이나 음성 알림을 한 눈에 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Wat is er nieuw” — één gerangschikte blik op openstaande meldingen op de HUD of gesproken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Novidades” — uma visão geral das notificações pendentes no HUD ou faladas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Что нового» — один ранжированный обзор ожидающих уведомлений на HUD или голосом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“نیا کیا ہے” — زیر التوا اطلاعات کا ایک درجہ بند جائزہ، HUD پر یا بول کر۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“新消息”——HUD 上或语音上的待处理通知的排名一览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「新訊息」－HUD 上或語音上的待處理通知的排名一覽。"
          }
        }
      }
    },
    "“Where did I park?” — the level, space and a way back, saved by voice, from a sign photo, or when a drive ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"أين ركنت سيارتي؟\" - المستوى والمساحة وطريق العودة، المحفوظة بالصوت، من صورة علامة، أو عند انتهاء محرك الأقراص."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“¿Dónde me estacioné?”: el nivel, el lugar y cómo regresar, guardados por voz, con la foto de un letrero o cuando termina un trayecto en auto."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Où ai-je garé ? » — le niveau, l'emplacement et un chemin de retour, sauvegardés par la voix, à partir d'une photo de panneau, ou à la fin d'un trajet."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "– Hol parkoltam? - a szint, a tér és a visszaút, hanggal mentve, táblaképről, vagy amikor egy út véget ér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Dove ho parcheggiato?\" - il livello, lo spazio e il percorso del ritorno, salvati con la voce, da una foto di un cartello o al termine di un viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「どこに駐車した？」—階、スペース、戻るルートを音声、看板の写真、またはドライブ終了時に保存。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“내가 어디에 주차했어요?” — 음성, 표지판 사진 또는 주행 종료 시 저장된 레벨, 공간 및 돌아가는 길."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Waar heb ik geparkeerd?” — het niveau, de ruimte en een weg terug, opgeslagen met uw stem, vanaf een bordfoto of wanneer een rit eindigt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Onde eu estacionei?” — o nível, o espaço e o caminho de volta, salvos por voz, a partir de uma foto de sinalização ou quando uma viagem termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Где припаркована машина?» — уровень, место и путь обратно, сохранённые голосом, по фото указателя или по окончании поездки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“میں نے گاڑی کہاں پارک کی؟” — منزل، جگہ اور واپسی کا راستہ، جو آواز سے، کسی سائن کی تصویر سے، یا ڈرائیو ختم ہونے پر محفوظ ہوتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我把车停在哪里了？” — 通过语音、标志照片或行驶结束时保存的高度、空间和返回路线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「我把車停在哪裡了？」— 透過語音、標誌照片或行駛結束時保存的高度、空間和返程路線。"
          }
        }
      }
    },
