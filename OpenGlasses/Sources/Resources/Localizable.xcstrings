    "Stops and saves the recording, and gets it ready to go to the office." : {
      "comment" : "A hint for the stop button.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بإيقاف التسجيل وحفظه، ويجهزه للإرسال إلى المكتب."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene y guarda la grabación, y la deja lista para ir a la oficina."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête et enregistre l'enregistrement, et le prépare pour l'envoyer au bureau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leállítja és elmenti a felvételt, és előkészíti, hogy elküldhesd az irodába."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe, salva la registrazione e la prepara per andare in ufficio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音を停止して保存し、オフィスに送れる状態に準備"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음을 중지하고 저장한 후 사무실로 갈 준비를 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopt en slaat de opname op, en maakt het klaar om naar het kantoor te gaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pára e salva a gravação e a prepara para ir para o escritório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливает и сохраняет запись и готовит её к отправке в офис."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ریکارڈنگ بند کر کے محفوظ کرتا ہے، اور اسے آفس بھیجنے کے لیے تیار کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止并保存录音，并准备发送到办公室。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止並保存錄音，並準備好送往辦公室。"
          }
        }
      }
    },
    "Stops the clock, finishes the record, and takes you to it so you can send it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بإيقاف الساعة، إنهاء التسجيل، ويأخذك إليه حتى تتمكن من إرساله."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene el reloj, termina el registro y te lleva a él para que puedas enviarlo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête l'horloge, termine l'enregistrement, et vous y conduit afin que vous puissiez l'envoyer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megállítja az órát, befejezi a felvételt, és elvisz oda, hogy el tudd küldeni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma l'orologio, termina il record e ti porta lì per poterlo inviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時計を停止し、録音を完了して、送信できるように案内"
