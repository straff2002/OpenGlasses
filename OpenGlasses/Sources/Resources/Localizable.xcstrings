        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de 56 herramientas a través de tu Mac: mensajería, búsqueda web, casa inteligente y más."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "56+ outils sur votre Mac — messagerie, recherche web, maison intelligente, et plus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "56+ eszköz a Mac-en keresztül – üzenetküldés, webes keresés, intelligens otthon és még sok más."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre 56 strumenti tramite il tuo Mac: messaggistica, ricerca web, casa intelligente e altro ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "56以上のツールをMacで — メッセージング、ウェブ検索、スマートホームなど。"
