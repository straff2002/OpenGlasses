          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このインストールが指すモデルファイルは、ディスク上にもうありません。削除してから、もう一度ダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
