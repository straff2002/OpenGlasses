        }
      }
    },
    "The signed binding names a different office or phone. Compare the public IDs and request a new binding." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمّي الربط الموقّع مكتبًا أو هاتفًا مختلفًا. قارن المعرّفات العامة واطلب ربطًا جديدًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vínculo firmado indica una oficina o un celular distintos. Compara los ID públicos y solicita un vínculo nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liaison signée désigne un autre bureau ou téléphone. Comparez les ID publics et demandez une nouvelle liaison."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az aláírt kötés másik irodát vagy telefont nevez meg. Hasonlítsa össze a nyilvános azonosítókat, és kérjen új kötést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il collegamento firmato indica un altro ufficio o un altro telefono. Confronta gli ID pubblici e richiedi un nuovo collegamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名済みのバインディングは、別のオフィスまたはiPhoneを指しています。公開IDを比較して、新しいバインディングを依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명된 바인딩이 다른 사무실이나 휴대전화를 지정합니다. 공개 ID를 비교하고 새 바인딩을 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ondertekende koppeling noemt een ander kantoor of een andere telefoon. Vergelijk de openbare ID’s en vraag een nieuwe koppeling aan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vinculação assinada indica outro escritório ou telefone. Compare os IDs públicos e peça uma nova vinculação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписанная привязка указывает на другой офис или телефон. Сравните открытые ID и запросите новую привязку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستخط شدہ بائنڈنگ کسی اور آفس یا فون کا نام دیتی ہے۔ عوامی IDs کا موازنہ کریں اور نئی بائنڈنگ مانگیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已签署的绑定指向另一个办公室或手机。请比对公开 ID，并请求新的绑定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已簽署的綁定指定的是另一個辦公室或手機。請比對公開 ID，並要求新的綁定。"
          }
        }
      }
    },
    "The signed office identity matches this phone. Delivery is not enabled yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هوية المكتب الموقّعة تطابق هذا الهاتف. لم يُفعَّل التسليم بعد."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La identidad firmada de la oficina coincide con este celular. La entrega aún no está habilitada."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identité signée du bureau correspond à ce téléphone. La livraison n’est pas encore activée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az aláírt irodai azonosító egyezik ezzel a telefonnal. A kézbesítés még nincs engedélyezve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'identità firmata dell'ufficio corrisponde a questo telefono. La consegna non è ancora abilitata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名済みのオフィスIDは、このiPhoneと一致しています。配信はまだ有効になっていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명된 사무실 ID가 이 휴대전화와 일치합니다. 전송은 아직 활성화되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ondertekende kantooridentiteit komt overeen met deze telefoon. Levering is nog niet ingeschakeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A identidade assinada do escritório corresponde a este telefone. A entrega ainda não está ativada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписанная идентификация офиса соответствует этому телефону. Доставка пока не включена."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستخط شدہ آفس شناخت اس فون سے مطابقت رکھتی ہے۔ ترسیل ابھی فعال نہیں ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已签署的办公室身份与这部手机相符。尚未启用交付。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已簽署的辦公室身分與這支手機相符。尚未啟用傳送。"
          }
        }
      }
    },
    "The spreadsheet becomes this phone's van list. The list that is here now is kept once, under Previous list on the Van stock screen, and is never merged in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح جدول البيانات قائمة الشاحنة على هذا الهاتف. تُحفظ القائمة الموجودة الآن مرة واحدة ضمن «القائمة السابقة» في شاشة مخزون الشاحنة، ولا تُدمج أبدًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hoja de cálculo se convierte en la lista de la camioneta de este celular. La lista que está aquí ahora se conserva una vez, en Lista anterior en la pantalla Inventario de la camioneta, y nunca se combina."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tableur devient la liste de la camionnette de ce téléphone. La liste actuelle est conservée une fois, sous Liste précédente sur l’écran Inventaire de la camionnette, et n’est jamais fusionnée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A táblázat lesz a telefon furgonlistája. A jelenlegi lista egyszer megmarad a Furgonkészlet képernyő Előző lista részében, és soha nem kerül összefésülésre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il foglio di calcolo diventa l’elenco del furgone di questo telefono. L’elenco attuale viene conservato una volta, in Elenco precedente nella schermata Scorte del furgone, e non viene mai unito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スプレッドシートがこのiPhoneの車載リストになります。現在のリストは「車載在庫」画面の「以前のリスト」に1回分だけ保持され、統合されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스프레드시트가 이 휴대폰의 차량 목록이 됩니다. 지금 있는 목록은 차량 재고 화면의 '이전 목록'에 한 번 보관되며 병합되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het spreadsheet wordt de buslijst van deze telefoon. De lijst die er nu is, wordt één keer bewaard onder Vorige lijst op het scherm Busvoorraad en wordt nooit samengevoegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A planilha se torna a lista da van deste telefone. A lista que está aqui agora é guardada uma vez, em Lista anterior na tela Estoque da van, e nunca é mesclada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таблица становится списком фургона на этом телефоне. Текущий список сохраняется один раз в разделе «Предыдущий список» на экране «Запасы в фургоне» и никогда не объединяется."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسپریڈشیٹ اس فون کی وین فہرست بن جاتی ہے۔ یہاں موجود فہرست ایک بار، وین اسٹاک اسکرین پر پچھلی فہرست کے تحت، محفوظ رکھی جاتی ہے اور کبھی ضم نہیں کی جاتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电子表格将成为这部手机的车载清单。现有的清单会保留一次，位于“车载库存”屏幕的“上一份清单”下，并且绝不会被合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試算表將成為這支手機的車載清單。現有的清單會保留一次，位於「車載庫存」畫面的「上一份清單」下，並且絕不會被合併。"
          }
        }
      }
    },
    "The spreadsheet couldn't be made" : {
      "localizations" : {
