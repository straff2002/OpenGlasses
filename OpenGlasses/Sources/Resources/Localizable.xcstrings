    "Details" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подробности"
          }
        }
      }
    },
    "Details for %@" : {
      "comment" : "A button that opens a new screen showing details about a specific persona.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подробности о %@"
          }
        }
      }
    },
    "Deterministic checks that run before any agent action — even if the model is talked into one. A blocked action is withheld; a confirm action asks for a spoken “confirm”." : {
      "comment" : "A description of the safety rules.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детерминированные проверки, выполняемые перед любым действием агента — даже если модель уговорили его выполнить. Заблокированное действие не выполняется; действие с подтверждением требует произнести «подтверждаю»."
          }
        }
      }
    },
    "Deterministic rules that confirm or block risky actions before they run — voice approval, quiet hours, and an away-from-home geofence." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детерминированные правила, которые подтверждают или блокируют рискованные действия перед их выполнением — голосовое подтверждение, тихие часы и геозона «вне дома»."
          }
        }
      }
    },
