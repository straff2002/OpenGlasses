        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó la solicitud. Puedes intentar de nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la requête. Vous pouvez réessayer."
          }
