    "%@ connections aren't wired for live calls yet — this server saves but won't connect until SSE support ships." : {
      "comment" : "A warning label that warns that a given server is not yet live.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصالات %1$@ لم يتم توصيلها للمكالمات المباشرة حتى الآن — يقوم هذا الخادم بالحفظ ولكنه لن يتصل حتى يأتي دعم SSE."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conexiones %@ aún no funcionan con llamadas en vivo: este servidor se guarda, pero no se conectará hasta que haya compatibilidad con SSE."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les connexions %1$@ ne sont pas encore câblées pour les appels en direct — ce serveur enregistre mais ne se connectera pas tant que le support SSE ne sera pas disponible."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ kapcsolatok még nincsenek vezetékes élő hívásokhoz – ez a szerver ment, de nem csatlakozik addig, amíg az SSE támogatás ki nem érkezik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le connessioni %1$@ non sono ancora cablate per le chiamate in tempo reale: questo server salva ma non si connetterà finché non verrà fornito il supporto SSE."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の接続はまだライブ通話用に配線されていません — このサーバーは保存しますが、SSE サポートが提供されるまで接続しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 연결은 아직 실시간 통화에 연결되지 않았습니다. 이 서버는 저장하지만 SSE 지원이 제공될 때까지 연결되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@-verbindingen zijn nog niet bekabeld voor live oproepen - deze server slaat op, maar maakt geen verbinding totdat SSE-ondersteuning wordt verzonden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conexões %1$@ ainda não estão conectadas para chamadas ao vivo — este servidor salva, mas não se conectará até que o suporte SSE seja enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключения %@ пока не настроены для звонков в реальном времени — этот сервер сохраняется, но не подключится, пока не появится поддержка SSE."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کنکشنز ابھی لائیو کالز کے لیے تیار نہیں ہیں — یہ سرور محفوظ تو ہو جاتا ہے لیکن SSE سپورٹ آنے تک منسلک نہیں ہوگا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 连接尚未连接用于实时呼叫 - 该服务器会保存，但在 SSE 支持发布之前不会连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 連線尚未連線用於即時呼叫 - 此伺服器會保存，但在 SSE 支援發布之前不會連線。"
          }
        }
      }
    },
