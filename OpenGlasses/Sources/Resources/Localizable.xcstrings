            "value" : "العناوين الفرعية المترجمة — الكلام المحيط مترجم إلى لغتك. معطل بشكل افتراضي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtítulos traducidos: lo que se dice a tu alrededor, en tu idioma. Desactivado de forma predeterminada."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous-titres traduits — discours environnant rendu dans votre langue. Désactivé par défaut."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lefordított feliratok — a környező beszéd az Ön nyelvén jelenik meg. Alapértelmezés szerint ki van kapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sottotitoli tradotti: discorso circostante reso nella tua lingua. Disattivato per impostazione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳された字幕 — あなたの言語で周囲の会話が表示されます。デフォルトではオフ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번역된 캡션 — 귀하의 언어로 렌더링된 주변 음성입니다. 기본적으로 꺼져 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaalde ondertitels — omringende spraak weergegeven in uw taal. Standaard uitgeschakeld."
