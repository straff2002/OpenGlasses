    "%@'s AI model still needs its key. It is added from Settings › Organisation › Finish Setup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال نموذج الذكاء الاصطناعي الخاص بـ %1$@ بحاجة إلى مفتاحه. تتم إضافته من الإعدادات › المؤسسة › إنهاء الإعداد."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo de IA de %@ aún necesita su clave. Se agrega en Configuración › Organización › Terminar configuración."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle IA de %1$@ a toujours besoin de sa clé. Elle est ajoutée depuis Réglages › Organisation › Finaliser la configuration."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ mesterséges intelligencia modelljének továbbra is szüksége van a kulcsára. A Beállítások › Szervezet › Beállítás befejezése menüpontból adható hozzá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello AI di %1$@ ha ancora bisogno della sua chiave. Viene aggiunto da Impostazioni > Organizzazione > Completa configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の AI モデルにはまだキーが必要です。設定 › 組織 › セットアップ完了 から追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 AI 모델에는 여전히 키가 필요합니다. 설정>조직>설정완료에서 추가됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het AI-model van %1$@ heeft nog steeds zijn sleutel nodig. Het wordt toegevoegd via Instellingen › Organisatie › Installatie voltooien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo de IA de %1$@ ainda precisa de sua chave. Ele é adicionado em Configurações › Organização › Concluir configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели ИИ %@ всё ещё нужен ключ. Добавьте его в «Настройки › Организация › Завершить настройку»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کے AI ماڈل کو ابھی بھی اپنی کلید درکار ہے۔ یہ ترتیبات › تنظیم › سیٹ اپ مکمل کریں سے شامل کی جاتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@的AI模型仍然需要它的密钥。它是从“设置”>“组织”>“完成设置”添加的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@的AI模型仍然需要它的金鑰。它是從“設定”>“組織”>“完成設定”添加的。"
          }
        }
      }
    },
