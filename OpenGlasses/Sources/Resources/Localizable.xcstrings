    "Voice input is processed on-device for wake word detection and sent to your provider for transcription." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم معالجة إدخال الصوت على الجهاز لاكتشاف كلمة التنبيه ويتم إرساله لمزود الخدمة الخاص بك للنص."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada de voz se procesa en el dispositivo para detectar la palabra de activación y se envía a tu proveedor para su transcripción."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée vocale est traitée sur l'appareil pour la détection du mot d'activation et envoyée à votre fournisseur pour transcription."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hang bemenet eszközön történik a felébresztő szó detektálásához, és az átíráshoz a szolgáltatódhoz kerül elküldésre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'input vocale viene elaborato sul dispositivo per il rilevamento delle parole di attivazione e inviato al provider per la trascrizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力はウェイクワード検出のためにデバイス上で処理され、文字起こしのために提供者に送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 입력은 깨우기 단어 감지를 위해 기기 내에서 처리되며 전사를 위해 공급자에게 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spraakinput wordt op het apparaat verwerkt voor wake word-detectie en naar uw provider gestuurd voor transcriptie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada de voz é processada no dispositivo para detecção de palavra de ativação e enviada ao seu provedor para transcrição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовой ввод обрабатывается на устройстве для распознавания слова активации и отправляется вашему провайдеру для расшифровки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویک ورڈ کی شناخت کے لیے صوتی ان پٹ ڈیوائس پر پروسیس ہوتا ہے اور ٹرانسکرپشن کے لیے آپ کے فراہم کنندہ کو بھیجا جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音输入在设备上处理用于唤醒词检测，并发送到服务提供商进行转录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音輸入會在裝置上處理以偵測喚醒詞，並送到您的提供者進行文字轉錄。"
          }
        }
      }
    },
