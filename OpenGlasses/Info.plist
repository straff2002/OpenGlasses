<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple's meaning, not the EAR's: NO = no export compliance documentation is required.
	     The app uses standard algorithms (WebRTC DTLS-SRTP, the glasses SDK) beyond Apple's, and
	     App Store Connect requires no documents for that while the app is not sold in France.
	     YES without an ITSEncryptionExportComplianceCode is refused at upload (ITMS-90592).
	     If France is ever made available, upload the French declaration, then set YES and add
	     the code Apple issues. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- A job the office sends as an .ogjob attachment (Plan FO P3c). Receive only: the app
	     opens one, shows it for review and adds it to upcoming jobs on a tap; it never writes
	     one out. Owner rank, so Mail and Files offer "Open with Avenkin". Opened as a copy
	     (LSSupportsOpeningDocumentsInPlace NO) so the app reads it once and deletes the copy. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Avenkin Job</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.openglasses.app.job</string>
			</array>
		</dict>
		<!-- The setup file Avenkin Office saves for a device (.avenkinsetup). Receive only, opened
		     as a copy like a job file. It carries the vendor-signed profile and licence; the app
		     verifies both and the owner reviews them before anything is applied. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Avenkin Office Setup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.openglasses.app.office-setup</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.openglasses.app.job</string>
			<key>UTTypeDescription</key>
			<string>Avenkin Job</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ogjob</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.openglasses.job+json</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.openglasses.app.office-setup</string>
			<key>UTTypeDescription</key>
			<string>Avenkin Office Setup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>avenkinsetup</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.openglasses.office-setup+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Avenkin</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Avenkin</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mwdat-$(MWDAT_META_APP_ID)</string>
				<string>openglasses</string>
				<string>avenkin</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
		<string>comgooglemaps</string>
		<string>waze</string>
		<string>podcasts</string>
		<string>music</string>
		<string>calshow</string>
		<string>photos-redirect</string>
		<string>mobilenotes</string>
		<string>x-apple-reminderkit</string>
		<string>applenews</string>
		<string>stocks</string>
		<string>voicememos</string>
		<string>translate</string>
		<string>fitnessapp</string>
		<string>shortcuts</string>
		<string>x-apple-health</string>
		<string>shoebox</string>
		<string>shareddocuments</string>
		<string>youtube</string>
		<string>spotify</string>
		<string>whatsapp</string>
		<string>instagram</string>
		<string>twitter</string>
		<string>tg</string>
		<string>reddit</string>
		<string>snssdk1233</string>
		<string>nflx</string>
		<string>uber</string>
		<string>lyft</string>
		<string>weixin</string>
		<string>wechat</string>
		<string>alipay</string>
		<string>alipays</string>
		<string>baidumap</string>
		<string>iosamap</string>
		<string>mqq</string>
		<string>weibo</string>
		<string>sinaweibo</string>
		<string>dingtalk</string>
		<string>snssdk1128</string>
		<string>taobao</string>
		<string>ctrip</string>
		<string>eleme</string>
		<string>meituan</string>
		<string>dianping</string>
		<string>xhsdiscover</string>
		<string>bilibili</string>
		<string>kakaotalk</string>
		<string>line</string>
		<string>zalo</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MWDAT</key>
	<dict>
		<!-- Opt out of Meta's SDK data collection. Both dictionaries are read by
		     MWDATCore at configure() time: Analytics/OptOut suppresses the event
		     uploader that posts to api2.ar.meta.com/mwsdk/telemetry, and
		     CrashReporting/OptOut suppresses the SDK's own crash reporter. Absent
		     or NO means opted in, so these must stay explicitly YES. -->
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
		<key>CrashReporting</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
		<key>AppLinkURLScheme</key>
		<string>openglasses://</string>
		<key>ClientToken</key>
		<string>AR|$(MWDAT_META_APP_ID)|$(MWDAT_CLIENT_TOKEN_HASH)</string>
		<key>MetaAppID</key>
		<string>$(MWDAT_META_APP_ID)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>Avenkin plays music from your library or the Apple Music catalogue, adds music to your library when you ask, and controls playback hands-free, by voice.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Avenkin uses Bluetooth to connect to your smart glasses (Ray-Ban Meta or EVEN Realities G2).</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Avenkin uses Bluetooth to connect to your smart glasses (Ray-Ban Meta or EVEN Realities G2).</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Avenkin accesses your calendar to tell you about upcoming events and create new ones hands-free.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Avenkin accesses your calendar to tell you about upcoming events and create new ones hands-free.</string>
	<key>NSCameraUsageDescription</key>
	<string>Avenkin needs camera access to capture photos and video for the AI to analyze.</string>
	<key>NSContactsUsageDescription</key>
	<string>Avenkin looks up contacts so you can make calls, send messages and address email by name, hands-free.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Avenkin reads your heart rate, resting heart rate, sleep, steps and workouts from Apple Health to answer questions like "how did I sleep?" and to tell you about your fitness activity. Only if you turn on "Share Health Data with AI" in Settings are these numbers sent to your chosen AI provider; otherwise Avenkin speaks them to you itself and they stay on your phone.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Avenkin saves workout data from fitness coaching sessions to Apple Health.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Avenkin controls your smart home devices hands-free, by voice.</string>
	<key>NSLocalNetworkUsageDescription</key>
		<string>Avenkin uses your local network to find self-hosted AI servers (Ollama, LM Studio, vLLM, LocalAI) without typing an address, and to stream video to a server on your own network.</string>
		<key>NSBonjourServices</key>
		<array>
			<string>_http._tcp</string>
			<string>_bonjour._tcp</string>
		</array>
		<key>NSLocationWhenInUseUsageDescription</key>
	<string>Avenkin uses your location to provide contextually relevant answers based on where you are.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Avenkin uses your location in the background to alert you when you arrive at or leave a place you set a location reminder for.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Avenkin needs microphone access to listen for wake words and transcribe your voice commands.</string>
	<key>NSMotionUsageDescription</key>
	<string>Avenkin reads your step count and walking distance to report daily activity.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Avenkin saves the photos and videos you capture to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Avenkin accesses your photo library to organize the photos you capture into a dedicated album.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Avenkin creates and manages reminders so you can set them hands-free.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Avenkin creates and manages reminders so you can set them hands-free.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Avenkin uses speech recognition to detect the wake word and transcribe your voice questions for the AI assistant.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>OpenGlassesCarPlayScene</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>OpenGlassesDeviceScene</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).OpenGlassesSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>external-accessory</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
