options:
  developmentTeam: YOUR_APPLE_TEAM_ID

targets:
  OpenGlasses:
    settings:
      base:
        CODE_SIGN_ENTITLEMENTS: Config/Entitlements/Personal/OpenGlasses.entitlements
        DEVELOPMENT_TEAM: YOUR_APPLE_TEAM_ID
        # Meta DAT credentials from developers.meta.com. These are substituted into the
        # committed OpenGlasses/Info.plist's MWDAT dict at build time, which keeps that plist
        # the single source of truth for every other key. A client token reads
        # AR|<app id>|<hash>; only the trailing hash goes here.
        #
        # Without these the app builds and launches, but DAT registration never completes —
        # and since the camera permission prompt is gated behind registration, the symptom is
        # a Connect button that seems to do nothing, not an obvious credentials error.
        MWDAT_META_APP_ID: "YOUR_META_APP_ID"
        MWDAT_CLIENT_TOKEN_HASH: "YOUR_CLIENT_TOKEN_HASH"
        # Never override INFOPLIST_FILE to a personal plist copy. That mechanism was removed:
        # the copy went stale and dropped newly added usage descriptions (App Store
        # ITMS-90683), and withdrawing it silently took the Meta credentials with it.
        # Rebranding doesn't need it — PRODUCT_BUNDLE_IDENTIFIER and
        # INFOPLIST_KEY_CFBundleDisplayName are build settings. If you change
        # PRODUCT_BUNDLE_IDENTIFIER, also override WK_COMPANION_APP_BUNDLE_IDENTIFIER on the
        # OpenGlassesWatch target to match.

  GlassesActivityWidget:
    settings:
      base:
        CODE_SIGN_ENTITLEMENTS: Config/Entitlements/Personal/GlassesActivityWidget.entitlements
        DEVELOPMENT_TEAM: YOUR_APPLE_TEAM_ID

  # Every remaining signed target needs a team as well, or a command-line device build fails
  # on it ("Signing for X requires a development team"). Building from Xcode's GUI hides this,
  # because automatic signing fills the team in for you — so the gap only shows up in CI or in
  # a headless `xcodebuild -destination 'platform=iOS,...'`.
  #
  # Unlike the app and the widget, these three keep the committed entitlements: their only
  # capability is the shared app group, which any team can sign. There's no personal override
  # to copy, and none is needed.
  OpenGlassesShareExtension:
    settings:
      base:
        DEVELOPMENT_TEAM: YOUR_APPLE_TEAM_ID

  OpenGlassesWatch:
    settings:
      base:
        DEVELOPMENT_TEAM: YOUR_APPLE_TEAM_ID

  OpenGlassesWatchWidget:
    settings:
      base:
        DEVELOPMENT_TEAM: YOUR_APPLE_TEAM_ID
