    "Avenkin can’t read your calendar. Allow access on your iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Avenkin قراءة تقويمك. اسمح بالوصول على iPhone."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin no puede leer tu calendario. Permite el acceso en tu iPhone."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin ne peut pas lire votre calendrier. Autorisez l’accès sur votre iPhone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin nem tudja olvasni a naptárát. Engedélyezze a hozzáférést az iPhone-ján."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin non può leggere il tuo calendario. Consenti l’accesso sul tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinがカレンダーを読み取れません。iPhoneでアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin이 캘린더를 읽을 수 없습니다. iPhone에서 접근을 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin kan uw agenda niet lezen. Geef toegang op uw iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin não consegue ler seu calendário. Permita o acesso no seu iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin не может прочитать ваш календарь. Разрешите доступ на iPhone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin не може прочитати ваш календар. Дозвольте доступ на iPhone."
          }
