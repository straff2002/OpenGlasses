    "Today on Your Watch is off. Turn it on in Avenkin on your iPhone, under Apple Watch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميزة «اليوم على ساعتك» متوقفة. شغّلها في Avenkin على iPhone، ضمن Apple Watch."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy en tu reloj está desactivado. Actívalo en Avenkin en tu iPhone, en Apple Watch."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui sur votre montre est désactivé. Activez-le dans Avenkin sur votre iPhone, sous Apple Watch."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mai nap az óráján ki van kapcsolva. Kapcsolja be az Avenkin appban az iPhone-ján, az Apple Watch alatt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi sull’orologio è disattivato. Attivalo in Avenkin sul tuo iPhone, in Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ウォッチで今日を表示」はオフです。iPhoneのAvenkinで、Apple Watchの項目からオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "워치에서 오늘 보기가 꺼져 있습니다. iPhone의 Avenkin에서 Apple Watch 항목에서 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag op uw horloge staat uit. Zet het aan in Avenkin op uw iPhone, onder Apple Watch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje no seu relógio está desativado. Ative no Avenkin no seu iPhone, em Apple Watch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сегодня на часах» выключено. Включите эту функцию в Avenkin на iPhone, в разделе Apple Watch."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сьогодні на годиннику» вимкнено. Увімкніть цю функцію в Avenkin на iPhone, у розділі Apple Watch."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«آج آپ کی واچ پر» بند ہے۔ اسے اپنے iPhone پر Avenkin میں، Apple Watch کے تحت آن کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“手表上的今天”已关闭。请在 iPhone 上的 Avenkin 中，于 Apple Watch 下开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「手錶上的今天」已關閉。請在 iPhone 上的 Avenkin 中，於 Apple Watch 下開啟。"
          }
        }
      }
    },
