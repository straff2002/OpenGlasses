    "Weather data sources are listed there and under My Day in Avenkin on your iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصادر بيانات الطقس مُدرجة هناك وضمن «يومي» في Avenkin على iPhone."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes de datos del clima aparecen ahí y en Mi día, en Avenkin en tu iPhone."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources des données météo sont indiquées là et sous Ma journée dans Avenkin sur votre iPhone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az időjárási adatok forrásai ott, valamint az iPhone-ján az Avenkin Az én napom részében találhatók."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fonti dei dati meteo sono elencate lì e in La mia giornata in Avenkin sul tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天気データの提供元は、そこと、iPhoneのAvenkinの「私の日」に記載されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날씨 데이터 출처는 그곳과 iPhone의 Avenkin 나의 하루에 나와 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bronnen van de weergegevens staan daar en onder Mijn dag in Avenkin op uw iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes dos dados meteorológicos estão listadas ali e em Meu dia, no Avenkin no seu iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источники данных о погоде указаны там и в разделе «Мой день» в Avenkin на iPhone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Джерела даних про погоду вказано там і в розділі «Мій день» в Avenkin на вашому iPhone."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسمی ڈیٹا کے ذرائع وہاں اور آپ کے iPhone پر Avenkin میں «میرا دن» کے تحت درج ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天气数据来源列在那里，也列在 iPhone 上 Avenkin 的“我的一天”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天氣數據來源列在那裡，也列在 iPhone 上 Avenkin 的「我的一天」中。"
          }
        }
      }
    },
    "Weather is off in My Day on your iPhone." : {
