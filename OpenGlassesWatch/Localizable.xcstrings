    "Event names and places are hidden while Medical Compliance is on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماء الأحداث وأماكنها مخفية ما دام وضع «الامتثال الطبي» مفعّلًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres y lugares de los eventos se ocultan mientras Cumplimiento médico está activado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms et lieux des événements sont masqués tant que Conformité médicale est activée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az események neve és helyszíne rejtve van, amíg az Orvosi megfelelőség be van kapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi e i luoghi degli eventi sono nascosti mentre Conformità medica è attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医療コンプライアンスがオンの間、イベント名と場所は非表示です。"
