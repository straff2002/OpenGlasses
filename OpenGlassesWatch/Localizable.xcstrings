        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의료 규정 준수가 켜져 있는 동안 이벤트 이름과 장소는 숨겨집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
