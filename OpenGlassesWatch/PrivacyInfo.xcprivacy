<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for the OpenGlassesWatch watchOS app.

  The app's own code transmits nothing off the device. It talks to the paired iPhone
  over WatchConnectivity (WCSession) — a local device-to-device link between the
  user's own devices, which is not "collection" in Apple's sense — and reads shared
  state from the app-group UserDefaults suite ("group.com.openglasses.app").

  The one network request is Apple's, not ours: a map card (Plan GM — "how far is
  that tower?", "where am I?", nearby places) draws a SwiftUI MapKit `Map`, and
  MapKit fetches the map tiles for the area shown from Apple Maps. The points on the
  map come from the phone; the watch reads no location of its own (no CoreLocation,
  no usage string), and no health, contacts or camera access. With Medical Local
  Only on, the phone marks the card so the watch draws no map at all. Map tiles
  fetched by Apple's framework are Apple's processing under its own terms, not data
  this app collects, so NSPrivacyCollectedDataTypes stays empty and tracking is
  false.

  The only required-reason API is app-group UserDefaults access
  (WatchConnectivityService.swift), covered by 1C8F.1 (data shared within the
  same App Group); CA92.1 also covers app-only defaults where used.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
