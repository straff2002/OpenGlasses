# gitleaks pin — the one place the version and digests live (W06.2).
#
# Sourced by Scripts/install-gitleaks.sh, which both the security-scan workflow and a developer
# running the scan locally use. Same discipline as Scripts/xcodegen-pin.env: a scanner is a build
# input like any other, and an unpinned one either changes its findings under you or is a
# substitution nobody would notice.
#
# Two digests because the scan runs on Linux in CI and on Apple silicon locally. Both come from
# the release's own checksums file:
#
#   curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_checksums.txt"
#
# When bumping, re-read the rule changes: gitleaks ships new detectors in minor releases, and a
# new detector firing on existing history is a finding to triage, not a build break to silence.

GITLEAKS_VERSION="8.30.1"
GITLEAKS_BASE_URL="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}"
GITLEAKS_SHA256_darwin_arm64="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"
GITLEAKS_SHA256_linux_x64="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
