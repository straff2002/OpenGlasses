# XcodeGen pin — the one place the version and digest live.
#
# Sourced by Scripts/install-xcodegen.sh, which is what both CI paths use: GitHub Actions
# (.github/workflows/*.yml) and Xcode Cloud (ci_scripts/ci_post_clone.sh). Two copies of a
# version string drift; one does not.
#
# XcodeGen decides the contents of the project file every build compiles, so an unverified
# download here is a build-tool substitution nobody would notice. The digest is of the release
# asset itself — recompute it with:
#
#   curl -fsSL "$XCODEGEN_URL" | shasum -a 256
#
# When bumping, keep this in step with the version developers install locally (docs/BUILDING.md).

XCODEGEN_VERSION="2.45.4"
XCODEGEN_URL="https://github.com/yonaskolb/XcodeGen/releases/download/${XCODEGEN_VERSION}/xcodegen.zip"
XCODEGEN_SHA256="090ec29491aad50aec10631bf6e62253fed733c50f3aab0f5ffc86bc170bdbef"
