{
  "version": 1,
  "about": "Narration cut into segments (Contracts/recorded-session.md §7.3 relies on the step-like ones). Each case is a transcript.json and the segments it must give. Fictional.",
  "rules": {
    "silenceSeconds": 4,
    "minimumWords": 3,
    "fillers": [
      "alright",
      "and",
      "ok",
      "okay",
      "right",
      "so",
      "uh",
      "um",
      "well"
    ],
    "markers": [
      [
        "first"
      ],
      [
        "next"
      ],
      [
        "then"
      ],
      [
        "now",
        "im",
        "going",
        "to"
      ],
      [
        "now",
        "i",
        "am",
        "going",
        "to"
      ],
      [
        "once",
        "thats",
        "done"
      ],
      [
        "once",
        "that",
        "is",
        "done"
      ]
    ],
    "stepMarker": "step, then a number word from one to twenty or a run of digits",
    "explicitMarker": [
      "new",
      "step"
    ],
    "stepNumbers": [
      "one",
      "two",
      "three",
      "four",
      "five",
      "six",
      "seven",
      "eight",
      "nine",
      "ten",
      "eleven",
      "twelve",
      "thirteen",
      "fourteen",
      "fifteen",
      "sixteen",
      "seventeen",
      "eighteen",
      "nineteen",
      "twenty"
    ],
    "sentenceEnds": [
      ".",
      "!",
      "?"
    ]
  },
  "cases": [
    {
      "name": "a narrated walkthrough",
      "transcript": {
        "utterances": [
          {
            "id": "u1",
            "start": 12,
            "end": 16.5,
            "text": "First, switch the boiler off at the isolator."
          },
          {
            "id": "u2",
            "start": 17,
            "end": 20,
            "text": "The light on the front panel goes out."
          },
          {
            "id": "u3",
            "start": 44,
            "end": 49,
            "text": "Next, remove the front cover. There are two screws underneath."
          },
          {
            "id": "u4",
            "start": 60,
            "end": 63,
            "text": "Okay, then lift the cover away"
          },
          {
            "id": "u5",
            "start": 63.2,
            "end": 66,
            "text": "then set it down somewhere safe."
          },
          {
            "id": "u6",
            "start": 96,
            "end": 101,
            "text": "Step three. Check the fuse on the control board."
          },
          {
            "id": "u7",
            "start": 103,
            "end": 106,
            "text": "Don't touch the capacitor."
          },
          {
            "id": "u8",
            "start": 116,
            "end": 126.9,
            "text": "Next, vacuum the dust out of the burner tray."
          },
          {
            "id": "u9",
            "start": 131,
            "end": 134,
            "text": "The fuse looks fine."
          },
          {
            "id": "u10",
            "start": 136,
            "end": 143,
            "text": "Once that's done, refit the cover. New step. Restore the power."
          },
          {
            "id": "u11",
            "start": 250,
            "end": 252,
            "text": "Okay."
          }
        ]
      },
      "expected": [
